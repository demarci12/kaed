---
import { createSupabaseServerClient } from '../lib/supabase';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
	data: { user },
} = await supabase.auth.getUser();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>KAED</title>
		<style>
			:root {
				--paper: #ffffff;
				--canvas: #f7f6f3;
				--ink: #14110f;
				--muted: #6b655d;
				--line: #e4e0d8;
				--accent: #14110f;
				--serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia,
					'Times New Roman', serif;
				--sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica,
					Arial, sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			body {
				font-family: var(--sans);
				font-size: 16px;
				line-height: 1.6;
				color: var(--ink);
				background: var(--canvas);
				margin: 0;
				padding: 0;
				-webkit-font-smoothing: antialiased;
			}

			.shell {
				width: min(1120px, calc(100% - 48px));
				margin: 0 auto;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 28px 0 24px;
				border-bottom: 1px solid var(--line);
			}

			.brand {
				display: flex;
				align-items: baseline;
				gap: 10px;
				text-decoration: none;
				color: var(--ink);
			}

			.brand-mark {
				font-family: var(--serif);
				font-size: 22px;
				font-weight: 600;
				letter-spacing: -0.01em;
			}

			.brand-tag {
				font-size: 12px;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.nav {
				display: flex;
				align-items: center;
				gap: 18px;
				font-size: 14px;
			}

			.nav a {
				color: var(--muted);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.nav a:hover {
				color: var(--ink);
			}

			.nav .who {
				color: var(--ink);
				font-variant-numeric: tabular-nums;
			}

			.nav .who-link {
				color: var(--muted);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.nav .who-link:hover {
				color: var(--ink);
			}

			.btn {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 9px 16px;
				border: 1px solid var(--ink);
				border-radius: 999px;
				background: var(--ink);
				color: #fff;
				font-size: 14px;
				font-weight: 500;
				text-decoration: none;
				cursor: pointer;
				transition:
					background 0.15s ease,
					color 0.15s ease;
			}

			.btn:hover {
				background: transparent;
				color: var(--ink);
			}

			.btn.ghost {
				background: transparent;
				color: var(--ink);
				border-color: var(--line);
			}

			.btn.ghost:hover {
				border-color: var(--ink);
			}

			.content {
				flex: 1;
				padding: 64px 0 48px;
			}

			.site-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
				padding: 24px 0 32px;
				border-top: 1px solid var(--line);
				font-size: 13px;
				color: var(--muted);
			}

			@media (max-width: 720px) {
				.shell {
					width: calc(100% - 24px);
				}
				.content {
					padding: 28px 0 32px;
				}
				.site-header {
					flex-wrap: wrap;
					gap: 12px;
					padding: 20px 0 16px;
				}
				.nav {
					gap: 12px;
					font-size: 13px;
					row-gap: 8px;
					flex-wrap: wrap;
				}
				.nav .who {
					display: none;
				}
				.site-footer {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
		<style is:global>
			/* Shared popup dialog, used by every "add new" trigger across the app.
			   Global because the <dialog> markup itself lives in each page component,
			   outside Layout's own scoped style boundary. */
			dialog.popup {
				width: min(480px, calc(100vw - 32px));
				margin: auto;
				padding: 0;
				border: 1px solid var(--line, #e4e0d8);
				border-radius: 16px;
				background: var(--paper, #fff);
				color: var(--ink, #14110f);
			}

			dialog.popup::backdrop {
				background: rgba(20, 17, 15, 0.4);
			}

			dialog.popup .popup-inner {
				padding: 28px;
			}

			dialog.popup h2 {
				margin: 0 0 20px;
				font-family: var(--serif);
				font-size: 20px;
				font-weight: 600;
			}

			dialog.popup form {
				display: flex;
				flex-direction: column;
				gap: 6px;
			}

			dialog.popup label {
				margin-top: 14px;
				font-size: 13px;
				font-weight: 500;
				color: var(--muted);
			}

			dialog.popup input,
			dialog.popup select,
			dialog.popup textarea {
				font-family: var(--sans);
				font-size: 15px;
				color: var(--ink);
				background: var(--canvas);
				border: 1px solid var(--line);
				border-radius: 10px;
				padding: 10px 14px;
				outline: none;
				resize: vertical;
				width: 100%;
			}

			dialog.popup input:focus,
			dialog.popup select:focus,
			dialog.popup textarea:focus {
				border-color: var(--ink);
			}

			dialog.popup .popup-row {
				display: flex;
				gap: 16px;
			}

			dialog.popup .popup-row > div {
				flex: 1;
				display: flex;
				flex-direction: column;
			}

			dialog.popup .popup-actions {
				display: flex;
				justify-content: flex-end;
				gap: 10px;
				margin-top: 24px;
			}

			/* Inline editable table cells. Locked by default; click unlocks into an
			   input, blur/Enter saves and locks it back in. */
			[data-editable] {
				position: relative;
				cursor: pointer;
				border-radius: 6px;
				transition: background 0.1s ease;
			}

			[data-editable]:hover:not(.editing):not(.saving) {
				background: var(--canvas);
				box-shadow: inset 0 0 0 1px var(--line);
			}

			[data-editable]:hover:not(.editing):not(.saving)::after {
				content: '✎';
				position: absolute;
				top: 50%;
				right: 6px;
				transform: translateY(-50%);
				font-size: 11px;
				color: var(--muted);
				opacity: 0.7;
			}

			[data-editable].editing {
				background: var(--paper);
				box-shadow: inset 0 0 0 2px var(--ink);
				white-space: normal !important;
				overflow: visible !important;
				text-overflow: unset !important;
				max-width: none !important;
			}

			[data-editable].saving {
				opacity: 0.55;
				cursor: progress;
			}

			[data-editable].save-error {
				box-shadow: inset 0 0 0 2px #b4231f;
			}

			.cell-input {
				display: block;
				width: 100%;
				min-width: 120px;
				font-family: var(--sans);
				font-size: 14px;
				color: var(--ink);
				background: transparent;
				border: none;
				outline: none;
				padding: 0;
				resize: vertical;
			}

			select.cell-input {
				cursor: pointer;
			}

			@media (max-width: 720px) {
				dialog.popup {
					align-self: flex-end;
					margin: 0 auto auto auto;
					width: 100vw;
					max-width: 100vw;
					border-radius: 16px 16px 0 0;
					position: fixed;
					bottom: 0;
					left: 0;
				}
				dialog.popup[open] {
					top: auto;
				}
			}
		</style>
	</head>
	<body>
		<div class="shell">
			<header class="site-header">
				<a href="/" class="brand">
					<span class="brand-mark">KAED</span>
				</a>
				<nav class="nav">
					{
						user ? (
							<>
								<a href="/challenges" class="who-link">Challenges</a>
								<a href="/brainstorm" class="who-link">Brainstorm</a>
								<a href="/business-ideas" class="who-link">Ideas</a>
								<a href="/clients" class="who-link">Clients</a>
								<span class="who">{user.email}</span>
								<form method="post" action="/api/auth/signout">
									<button type="submit" class="btn ghost">Sign out</button>
								</form>
							</>
						) : (
							<a href="/login" class="btn ghost">Log in</a>
						)
					}
				</nav>
			</header>

			<main class="content">
				<slot />
			</main>

			<footer class="site-footer">
				<span>KAED — built by Marton Deak</span>
				<span>© 2026</span>
			</footer>
		</div>

		<script>
			document.addEventListener('click', (event) => {
				const target = event.target as HTMLElement;

				const opener = target.closest<HTMLElement>('[data-open-dialog]');
				if (opener) {
					const dialogId = opener.dataset.openDialog;
					const dialog = dialogId && document.getElementById(dialogId);
					if (dialog instanceof HTMLDialogElement) dialog.showModal();
					return;
				}

				const closer = target.closest<HTMLElement>('[data-close-dialog]');
				if (closer) {
					closer.closest('dialog')?.close();
					return;
				}

				if (target instanceof HTMLDialogElement && target === event.target) {
					// Click landed directly on the dialog element, i.e. the backdrop.
					target.close();
				}

				const cell = target.closest<HTMLElement>('[data-editable]');
				if (cell && !cell.classList.contains('editing') && !cell.classList.contains('saving')) {
					startCellEdit(cell);
				}
			});

			/**
			 * Inline table-cell editing: click a cell to "unlock" it into an input,
			 * blur/Enter "locks" it back in by saving, Escape cancels without saving.
			 */
			function startCellEdit(cell: HTMLElement) {
				const type = cell.dataset.editable ?? 'text';
				const field = cell.dataset.field ?? '';
				const rowId = cell.dataset.id ?? '';
				const endpoint = cell.dataset.endpoint ?? '';
				const originalValue = cell.dataset.value ?? '';
				const originalHtml = cell.innerHTML;

				cell.classList.add('editing');

				let input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

				if (type === 'select') {
					const select = document.createElement('select');
					const options = (cell.dataset.options ?? '')
						.split(',')
						.filter(Boolean)
						.map((pair) => pair.split(':'));
					for (const [value, label] of options) {
						const opt = document.createElement('option');
						opt.value = value;
						opt.textContent = label;
						if (value === originalValue) opt.selected = true;
						select.appendChild(opt);
					}
					input = select;
				} else if (type === 'textarea') {
					const textarea = document.createElement('textarea');
					textarea.rows = 2;
					textarea.value = originalValue;
					input = textarea;
				} else {
					const el = document.createElement('input');
					el.type = type === 'date' ? 'date' : 'text';
					el.value = originalValue;
					input = el;
				}

				input.className = 'cell-input';
				cell.innerHTML = '';
				cell.appendChild(input);
				input.focus();
				if (input instanceof HTMLInputElement) input.select();

				let settled = false;

				const finish = () => cell.classList.remove('editing', 'saving');

				const cancel = () => {
					if (settled) return;
					settled = true;
					cell.innerHTML = originalHtml;
					finish();
				};

				const save = async () => {
					if (settled) return;
					settled = true;
					const newValue = input.value.trim();

					if (newValue === originalValue) {
						cell.innerHTML = originalHtml;
						finish();
						return;
					}

					cell.classList.remove('editing');
					cell.classList.add('saving');

					try {
						const response = await fetch(`${endpoint}/${rowId}/field`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ field, value: newValue }),
						});
						if (!response.ok) throw new Error('save failed');

						cell.dataset.value = newValue;
						if (type === 'select' && input instanceof HTMLSelectElement) {
							const label = input.options[input.selectedIndex]?.textContent ?? newValue;
							cell.innerHTML = `<span class="pill pill-${newValue}">${label}</span>`;
						} else {
							cell.textContent = newValue || '—';
						}
					} catch {
						cell.innerHTML = originalHtml;
						cell.classList.add('save-error');
						setTimeout(() => cell.classList.remove('save-error'), 1200);
					} finally {
						finish();
					}
				};

				input.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' && type !== 'textarea') {
						event.preventDefault();
						save();
					} else if (event.key === 'Escape') {
						event.preventDefault();
						cancel();
					}
				});
				input.addEventListener('blur', save);
				if (type === 'select') input.addEventListener('change', save);
			}
		</script>
	</body>
</html>
