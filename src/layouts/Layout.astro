---
import type { User } from '@supabase/supabase-js';
import { createSupabaseServerClient } from '../lib/supabase';
import { isMember } from '../lib/auth';
import { ClientRouter } from 'astro:transitions';
// Tailwind + design tokens. This is a real global stylesheet, so its reset
// actually applies to markup rendered by pages and by JS -- unlike a scoped
// <style>, which Astro rewrites to match only this component's own elements.
import '../styles/global.css';

interface Props {
	// Pages that already resolved the user via requireUser/requireOwner
	// should pass it here to avoid a second auth round-trip per request.
	// Only public pages (/, /login) that never call requireUser omit this.
	user?: User | null;
}

const { user: userProp } = Astro.props;

let user: User | null;
if (userProp !== undefined) {
	user = userProp;
} else {
	const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
	const result = await supabase.auth.getUser();
	user = result.data.user;
}

const memberOnly = user ? isMember(user) : false;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>KAED</title>
		<ClientRouter />
		<style>
			/* Design tokens, the reset and `body` now live in
			   src/styles/global.css -- a real stylesheet, so they apply to
			   every element on the page rather than only the ones this
			   component renders. Do not move them back here. */
			.shell {
				width: min(1120px, calc(100% - 48px));
				margin: 0 auto;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 28px 0 24px;
				border-bottom: 1px solid var(--line);
			}

			.brand {
				display: flex;
				align-items: baseline;
				gap: 10px;
				text-decoration: none;
				color: var(--ink);
			}

			.brand-mark {
				font-family: var(--serif);
				font-size: 22px;
				font-weight: 600;
				letter-spacing: -0.01em;
			}

			.brand-tag {
				font-size: 12px;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.nav {
				display: flex;
				align-items: center;
				gap: 18px;
				font-size: 14px;
			}

			.nav a {
				color: var(--muted);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.nav a:hover {
				color: var(--ink);
			}

			.nav .who {
				color: var(--ink);
				font-variant-numeric: tabular-nums;
			}

			.nav .who-link {
				color: var(--muted);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.nav .who-link:hover {
				color: var(--ink);
			}

			.nav-group {
				position: relative;
			}

			/* OPL is the one nav entry that's a filled button rather than a
			   muted link -- it's the daily-driver list, so it reads as the
			   primary action. Sized down to sit inside the nav row. */
			.nav .nav-cta {
				padding: 7px 16px;
				font-size: 13px;
			}

			.nav-group summary {
				color: var(--muted);
				cursor: pointer;
				list-style: none;
				transition: color 0.15s ease;
			}

			.nav-group summary::-webkit-details-marker {
				display: none;
			}

			.nav-group summary:hover,
			.nav-group[open] summary {
				color: var(--ink);
			}

			.nav-group summary::after {
				content: '▾';
				margin-left: 4px;
				font-size: 10px;
				vertical-align: middle;
			}

			.nav-dropdown {
				position: absolute;
				top: calc(100% + 12px);
				left: 0;
				z-index: 20;
				display: flex;
				flex-direction: column;
				min-width: 160px;
				padding: 8px;
				border: 1px solid var(--line);
				border-radius: 12px;
				background: var(--paper);
				box-shadow: 0 12px 32px -12px rgba(20, 17, 15, 0.25);
			}

			.nav-dropdown a {
				padding: 8px 10px;
				border-radius: 8px;
				font-size: 14px;
				color: var(--ink);
				text-decoration: none;
			}

			.nav-dropdown a:hover {
				background: var(--canvas);
			}

			.content {
				flex: 1;
				padding: 64px 0 48px;
			}

			.site-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
				padding: 24px 0 32px;
				border-top: 1px solid var(--line);
				font-size: 13px;
				color: var(--muted);
			}

			@media (max-width: 767.98px) {
				.shell {
					width: calc(100% - 24px);
				}
				.content {
					padding: 28px 0 32px;
				}
				.site-header {
					flex-wrap: wrap;
					gap: 12px;
					padding: 20px 0 16px;
				}
				.nav {
					gap: 12px;
					font-size: 13px;
					row-gap: 8px;
					flex-wrap: wrap;
				}
				.nav .who {
					display: none;
				}
				.nav-dropdown {
					/* Centered under its trigger instead of left-anchored -- a
					   nav-group near either edge of the wrapped row would
					   otherwise push a left:0 dropdown off-screen and cause
					   horizontal overflow on narrow viewports. */
					left: 50%;
					right: auto;
					transform: translateX(-50%);
					min-width: 150px;
					max-width: calc(100vw - 32px);
				}
				.site-footer {
					flex-direction: column;
					align-items: flex-start;
				}
			}

			/* Mobile hamburger menu: hamburger morphs into an X while open. */
			.mobile-nav[open] .hamburger-icon span:first-child {
				transform: translateY(5.5px) rotate(45deg);
			}

			.mobile-nav[open] .hamburger-icon span:nth-child(2) {
				opacity: 0;
			}

			.mobile-nav[open] .hamburger-icon span:last-child {
				transform: translateY(-5.5px) rotate(-45deg);
			}

			.mobile-nav-cta {
				justify-content: center;
				width: 100%;
				margin: 4px 0 6px;
			}

			.mobile-nav-heading {
				margin: 10px 0 2px;
				padding: 0 12px;
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.mobile-nav-heading:first-child {
				margin-top: 4px;
			}

			.mobile-nav-link {
				display: flex;
				align-items: center;
				min-height: 44px;
				padding: 0 12px;
				border-radius: 8px;
				font-size: 15px;
				color: var(--ink);
				text-decoration: none;
			}

			.mobile-nav-link:hover,
			.mobile-nav-link:active {
				background: var(--canvas);
			}

			/* Anchor the panel flush to the right edge of the hamburger instead
			   of the shared .nav-dropdown's centered/left-anchored positioning
			   -- plain CSS with !important, not Tailwind utilities, because the
			   legacy .nav-dropdown rule sets `transform` as a direct property
			   and beats Tailwind's !-prefixed utilities (which only mark the
			   underlying --tw-translate-x custom property important, not the
			   composed transform declaration that actually renders). */
			.mobile-nav-panel {
				left: auto !important;
				right: 0 !important;
				transform: none !important;
			}

			/* The hamburger trigger has its own icon and shouldn't also get
			   .nav-group summary's decorative "▾" (it has no text for the
			   arrow to sensibly follow). */
			.mobile-nav-trigger::after {
				content: none;
			}
		</style>
		<style is:global>
			/* .btn is global because Astro's scoped <style> only stamps its hash
			   attribute onto elements a component renders itself — buttons/labels
			   with class="btn" inside page components (not Layout.astro) never
			   matched the old scoped rule and silently fell back to unstyled
			   browser-default buttons. Anything meant to be used across pages
			   belongs here, not in the scoped block above. */
			/* The box-sizing reset MUST be global. It used to live in this
			   file's scoped <style>, where Astro rewrites `*` to match only
			   the elements Layout itself renders -- so every input, select
			   and textarea rendered by a *page* was still content-box, and
			   its padding was added on top of any height we set. That is why
			   a field styled `height: 44px; padding: 10px 14px` rendered ~66px
			   tall, and why fields never lined up with each other. */
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			/* Form controls don't inherit typography by default; without this
			   a page-rendered input silently falls back to the browser's
			   13px system font instead of the app's. */
			input,
			select,
			textarea,
			button {
				font-family: inherit;
				font-size: inherit;
			}

			/* =====================================================================
			   SHARED DESIGN SYSTEM
			   Everything below is the single definition of a primitive used on
			   more than one page. Pages must NOT re-declare these in their own
			   scoped <style> -- that is how the app ended up with six different
			   `h1` sizes and four different `.btn` heights, so a fix on one page
			   never reached the others. Page-scoped CSS is for genuinely
			   page-specific things only.
			   ===================================================================== */

			/* ---- Buttons ---- */
			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				min-height: 40px;
				padding: 0 18px;
				border: 1px solid var(--ink, #14110f);
				border-radius: 999px;
				background: var(--ink, #14110f);
				color: #fff;
				font-family: var(--sans);
				font-size: 14px;
				font-weight: 500;
				text-decoration: none;
				white-space: nowrap;
				cursor: pointer;
				transition:
					background 0.15s ease,
					color 0.15s ease,
					border-color 0.15s ease;
			}

			.btn.small {
				min-height: 32px;
				padding: 0 13px;
				font-size: 13px;
			}

			.btn.danger {
				color: #b4231f;
				background: transparent;
				border-color: var(--line);
			}

			.btn.danger:hover {
				background: #fbf0ef;
				border-color: #e7c3c1;
			}

			/* ---- Page header ---- */
			.page-head {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 24px;
				flex-wrap: wrap;
			}

			.page-head > div {
				min-width: 0;
			}

			.page-head-actions {
				display: flex;
				gap: 10px;
				flex-wrap: wrap;
			}

			.page-head .btn {
				flex-shrink: 0;
			}

			/* ---- Type ---- */
			h1 {
				margin: 0;
				font-family: var(--serif);
				font-weight: 600;
				font-size: clamp(2.1rem, 5vw, 3rem);
				letter-spacing: -0.02em;
			}

			.eyebrow {
				margin: 0 0 16px;
				font-size: 13px;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.lede {
				max-width: 60ch;
				margin: 18px 0 0;
				color: var(--muted);
				font-size: 16px;
				line-height: 1.6;
			}

			.back {
				display: inline-block;
				margin-bottom: 24px;
				color: var(--muted);
				text-decoration: none;
				font-size: 14px;
			}

			.back:hover {
				color: var(--ink);
			}

			/* ---- Feedback / empty states ---- */
			.form-error {
				margin: 20px 0 0;
				padding: 12px 16px;
				border: 1px solid #e7c3c1;
				background: #fbf0ef;
				border-radius: 10px;
				color: #b4231f;
				font-size: 14px;
			}

			.empty {
				/* Spans the full width when used inside a .card-grid. */
				grid-column: 1 / -1;
				margin: 0;
				padding: 32px 16px;
				text-align: center;
				color: var(--muted);
				border: 1px dashed var(--line);
				border-radius: 14px;
			}

			/* ---- Card grid: every list view in the app uses this ---- */
			.card-grid {
				margin-top: 40px;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 18px;
			}

			.card {
				display: flex;
				flex-direction: column;
				gap: 14px;
				padding: 22px;
				border: 1px solid var(--line);
				border-radius: 14px;
				background: var(--paper);
			}

			.card-head {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 12px;
				/* Wraps so a crowded head (rank badge + title + open + reorder +
				   delete) drops its controls to a second line on a narrow phone
				   instead of squeezing the title into a one-word column and
				   pushing the card past the viewport edge. */
				flex-wrap: wrap;
			}

			/* Trailing controls travel together, so they wrap as one unit
			   rather than breaking up across two lines. */
			.card-actions {
				display: flex;
				align-items: center;
				gap: 6px;
				margin-left: auto;
				flex-shrink: 0;
			}

			.card-title {
				flex: 1 1 10rem;
				min-width: 0;
				font-family: var(--serif);
				font-size: 19px;
				font-weight: 600;
				line-height: 1.3;
				color: var(--ink);
				text-decoration: none;
			}

			a.card-title:hover {
				text-decoration: underline;
			}

			.card-foot {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				flex-wrap: wrap;
				/* Pushes feet to the bottom so they align across a row of
				   cards with different amounts of content. */
				margin-top: auto;
				padding-top: 14px;
				border-top: 1px solid var(--line);
			}

			.card-field {
				display: flex;
				flex-direction: column;
				gap: 5px;
			}

			.card-field-label {
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.card-field-value {
				margin: 0;
				padding: 8px 10px;
				border: 1px solid transparent;
				border-radius: 8px;
				font-size: 14px;
				line-height: 1.6;
				color: var(--ink);
				white-space: pre-wrap;
				cursor: text;
				transition:
					border-color 0.15s ease,
					background 0.15s ease;
			}

			.card-field-value:hover {
				border-color: var(--line);
				background: var(--canvas);
			}

			.card-field-value[data-value=''] {
				color: var(--muted);
			}

			.card-date {
				font-size: 12px;
				color: var(--muted);
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}

			.card-delete {
				width: 26px;
				height: 26px;
				flex-shrink: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border-radius: 50%;
				border: 1px solid transparent;
				background: transparent;
				color: var(--muted);
				font-size: 16px;
				line-height: 1;
				cursor: pointer;
				transition:
					border-color 0.15s ease,
					color 0.15s ease;
			}

			.card-delete:hover {
				border-color: #e7c3c1;
				color: #b4231f;
			}

			/* Forms wrapping a single icon button inside a card shouldn't
			   introduce layout of their own. */
			.card form {
				margin: 0;
			}

			.rank-badge {
				flex-shrink: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 22px;
				height: 22px;
				padding: 0 6px;
				border-radius: 999px;
				background: var(--canvas);
				border: 1px solid var(--line);
				color: var(--muted);
				font-size: 12px;
				font-family: inherit;
				font-variant-numeric: tabular-nums;
				cursor: pointer;
				transition:
					border-color 0.15s ease,
					color 0.15s ease;
			}

			.rank-badge:hover {
				border-color: var(--ink);
				color: var(--ink);
			}

			.rank-badge-input {
				flex-shrink: 0;
				width: 40px;
				height: 22px;
				padding: 0 4px;
				border-radius: 999px;
				background: var(--paper);
				border: 1px solid var(--ink);
				color: var(--ink);
				font-size: 12px;
				font-family: inherit;
				text-align: center;
				font-variant-numeric: tabular-nums;
			}

			/* Opens the detail page from a list whose title is inline-editable,
			   so clicking the title renames and this opens. Without it the
			   only way into the detail view would be to give up inline rename. */
			.card-open {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 22px;
				height: 22px;
				border-radius: 6px;
				border: 1px solid transparent;
				color: var(--muted);
				font-size: 13px;
				line-height: 1;
				text-decoration: none;
				transition:
					border-color 0.15s ease,
					color 0.15s ease;
			}

			.card-open:hover {
				border-color: var(--ink);
				color: var(--ink);
			}

			.rank-controls {
				display: inline-flex;
				gap: 2px;
			}

			.rank-btn {
				width: 22px;
				height: 22px;
				flex-shrink: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border-radius: 6px;
				border: 1px solid var(--line);
				background: transparent;
				color: var(--muted);
				font-size: 12px;
				line-height: 1;
				cursor: pointer;
				transition:
					border-color 0.15s ease,
					color 0.15s ease;
			}

			.rank-btn:hover:not(:disabled) {
				border-color: var(--ink);
				color: var(--ink);
			}

			.rank-btn:disabled {
				opacity: 0.35;
				cursor: default;
			}

			/* ---- Chip: small inline status/link token in a card foot ---- */
			.chip {
				display: inline-block;
				font-size: 12px;
				padding: 4px 10px;
				border-radius: 999px;
				background: var(--canvas);
				border: 1px solid var(--line);
				color: var(--ink);
				font-family: var(--sans);
				text-decoration: none;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				max-width: 100%;
				cursor: pointer;
			}

			.chip:hover {
				border-color: var(--ink);
			}

			.chip-muted {
				background: transparent;
				border-style: dashed;
				color: var(--muted);
			}

			.chip-muted:hover {
				border-color: var(--line);
			}

			/* ---- Tables (finance views still use these) ---- */
			.table-wrap {
				overflow-x: auto;
				border: 1px solid var(--line);
				border-radius: 14px;
				background: var(--paper);
			}

			.data-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 14px;
			}

			.data-table th {
				text-align: left;
				padding: 12px 16px;
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--muted);
				border-bottom: 1px solid var(--line);
				background: var(--canvas);
				white-space: nowrap;
			}

			.data-table td {
				padding: 12px 16px;
				border-bottom: 1px solid var(--line);
				vertical-align: middle;
			}

			.data-table tr:last-child td {
				border-bottom: none;
			}

			.cell-muted {
				color: var(--muted);
			}

			.cell-date {
				color: var(--muted);
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}

			.cell-amount {
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}

			.empty-cell {
				padding: 32px 16px;
				text-align: center;
				color: var(--muted);
			}

			@media (max-width: 767.98px) {
				.page-head {
					align-items: flex-start;
					gap: 16px;
				}

				.card-grid {
					grid-template-columns: 1fr;
					margin-top: 28px;
				}

				.card {
					padding: 18px;
				}

				/* Bigger touch target without changing the visual size. */
				.card-delete {
					position: relative;
				}

				.card-delete::after {
					content: '';
					position: absolute;
					inset: -10px;
				}
			}

			.btn:hover {
				background: transparent;
				color: var(--ink);
			}

			.btn.ghost {
				background: transparent;
				color: var(--ink);
				border-color: var(--line);
			}

			.btn.ghost:hover {
				border-color: var(--ink);
			}

			/* Shared popup, used by every "add new" trigger across the app.
			   Native <dialog> + showModal(): the browser owns focus trapping,
			   Escape-to-close, scroll lock, and the backdrop — the only JS
			   needed is opening/closing by id (see the script below). Global
			   because the markup lives in each page component, outside
			   Layout's own scoped style boundary. */
			dialog.popup {
				width: min(480px, 100%);
				max-height: calc(100vh - 32px);
				margin: auto;
				overflow-y: auto;
				padding: 32px;
				border: 1px solid var(--line, #e4e0d8);
				border-radius: 18px;
				background: var(--paper, #fff);
				color: var(--ink, #14110f);
				box-shadow:
					0 1px 2px rgba(20, 17, 15, 0.06),
					0 32px 64px -16px rgba(20, 17, 15, 0.32);
				opacity: 0;
				transform: translateY(10px) scale(0.97);
				transition:
					opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1),
					transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
					overlay 0.18s allow-discrete,
					display 0.18s allow-discrete;
			}

			dialog.popup[open] {
				opacity: 1;
				transform: translateY(0) scale(1);
			}

			@starting-style {
				dialog.popup[open] {
					opacity: 0;
					transform: translateY(10px) scale(0.97);
				}
			}

			dialog.popup::backdrop {
				background: rgba(20, 17, 15, 0.45);
				backdrop-filter: blur(3px);
				-webkit-backdrop-filter: blur(3px);
				opacity: 0;
				transition:
					opacity 0.18s ease,
					overlay 0.18s allow-discrete,
					display 0.18s allow-discrete;
			}

			dialog.popup[open]::backdrop {
				opacity: 1;
			}

			@starting-style {
				dialog.popup[open]::backdrop {
					opacity: 0;
				}
			}

			.popup-close {
				position: absolute;
				top: 18px;
				right: 18px;
				width: 30px;
				height: 30px;
				display: flex;
				align-items: center;
				justify-content: center;
				border: none;
				border-radius: 50%;
				background: transparent;
				color: var(--muted);
				font-size: 18px;
				line-height: 1;
				cursor: pointer;
				transition:
					background 0.12s ease,
					color 0.12s ease;
			}

			.popup-close:hover {
				background: var(--canvas);
				color: var(--ink);
			}

			.popup h2 {
				margin: 0 0 4px;
				padding-right: 28px;
				font-family: var(--serif);
				font-size: 21px;
				font-weight: 600;
				letter-spacing: -0.01em;
			}

			.popup .popup-sub {
				margin: 0 0 22px;
				font-size: 13px;
				color: var(--muted);
			}

			.popup h2 + form,
			.popup .popup-sub + form {
				margin-top: 18px;
				padding-top: 20px;
				border-top: 1px solid var(--line);
			}

			/* Spacing is owned entirely by the label's margin so every
			   label→field pair has the same rhythm; a flex `gap` here would
			   stack on top of it and make the first pair (which also sits
			   under the header's padding) taller than the rest. */
			.popup form {
				display: flex;
				flex-direction: column;
				gap: 0;
			}

			.popup label:not(.btn) {
				margin: 18px 0 6px;
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.popup label:not(.btn):first-of-type {
				margin-top: 0;
			}

			.popup input,
			.popup select,
			.popup textarea {
				font-family: var(--sans);
				font-size: 16px;
				color: var(--ink);
				background: var(--canvas);
				border: 1px solid var(--line);
				border-radius: 10px;
				padding: 10px 14px;
				outline: none;
				width: 100%;
			}

			/* Single-line fields get a fixed height so Type/Amount/Category/Date
			   line up as a consistent stack -- date inputs in particular size
			   themselves differently from text/number inputs otherwise. Only
			   textareas are resizable; a resize grabber on an <input> is a
			   browser quirk, not something we want. */
			.popup input,
			.popup select {
				height: 44px;
				resize: none;
			}

			.popup textarea {
				resize: vertical;
			}

			.popup input:focus,
			.popup select:focus,
			.popup textarea:focus {
				border-color: var(--ink);
				box-shadow: 0 0 0 3px rgba(20, 17, 15, 0.08);
			}

			.popup .popup-row {
				display: flex;
				gap: 16px;
			}

			.popup .popup-row > div {
				flex: 1;
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 0;
			}

			/* Inside a row each column restarts the rhythm, so its first label
			   shouldn't inherit the 18px top margin used between stacked
			   fields -- the row itself already provides that separation. */
			.popup .popup-row > div > label:not(.btn) {
				margin-top: 0;
			}

			.popup .popup-actions {
				display: flex;
				justify-content: flex-end;
				gap: 10px;
				margin-top: 24px;
			}

			.popup .popup-actions label.btn {
				margin-top: 0;
			}

			/* Status pills. Global (not per-page scoped) because startCellEdit
			   below re-renders a saved select cell with
			   `<span class="pill pill-${value}">` via innerHTML -- markup Astro
			   never sees at build time, so it never receives a page's scoped
			   style hash. Scoped copies of these rules silently stopped
			   applying the moment a user changed a dropdown, leaving an
			   unstyled pill until the next full page load. Keeping every
			   variant here also stops six pages duplicating the same CSS. */
			.pill {
				display: inline-block;
				flex-shrink: 0;
				padding: 4px 12px;
				border-radius: 999px;
				font-size: 12px;
				font-weight: 500;
				white-space: nowrap;
			}

			/* Neutral / not-started */
			.pill-lead,
			.pill-not_started {
				background: var(--canvas);
				color: var(--muted);
				border: 1px solid var(--line);
			}

			/* In progress */
			.pill-contacted,
			.pill-active,
			.pill-saving {
				background: #eef4ff;
				color: #1d4ed8;
			}

			/* Attention / mid-stage */
			.pill-negotiating {
				background: #fff7e6;
				color: #92620a;
			}

			/* Positive */
			.pill-won,
			.pill-done,
			.pill-income {
				background: #eafaf0;
				color: #1f7a3d;
			}

			/* Negative */
			.pill-lost,
			.pill-expense {
				background: #fbf0ef;
				color: #b4231f;
			}

			/* Idea-generation taxonomy (see /opl): best = a pain you
			   have yourself at work, then clone plays, then secondhand pain,
			   then tech looking for a problem. */
			.pill-empty {
				background: transparent;
				color: var(--muted);
				border: 1px dashed var(--line);
			}

			.pill-work-mine {
				background: #eafaf0;
				color: #1f7a3d;
			}

			.pill-work-others,
			.pill-life-mine {
				background: #fff7e6;
				color: #92620a;
			}

			.pill-life-known,
			.pill-life-strangers,
			.pill-tech-app {
				background: #fbf0ef;
				color: #b4231f;
			}

			.pill-clone-niche,
			.pill-clone-geo,
			.pill-clone-pricing,
			.pill-clone-usecase,
			.pill-clone-oss {
				background: var(--canvas);
				color: var(--ink);
				border: 1px solid var(--line);
			}

			/* Funding/progress stage (see /projects/[id] metadata panel). */
			.pill-idea {
				background: var(--canvas);
				color: var(--ink);
				border: 1px solid var(--line);
			}

			.pill-building {
				background: #eef4ff;
				color: #1d4ed8;
			}

			.pill-bootstrapped {
				background: #fff7e6;
				color: #92620a;
			}

			.pill-funded,
			.pill-profitable {
				background: #eafaf0;
				color: #1f7a3d;
			}

			.pill-paused {
				background: #fbf0ef;
				color: #b4231f;
			}

			/* Specific knowledge kinds (see /specific-knowledge). */
			.pill-obsession {
				background: #f4eefe;
				color: #6b21a8;
			}

			.pill-skill {
				background: #eef4ff;
				color: #1d4ed8;
			}

			.pill-experience {
				background: #fff7e6;
				color: #92620a;
			}

			.pill-strength {
				background: #eafaf0;
				color: #1f7a3d;
			}

			/* System design (see /system-design): actor kinds, requirement kinds
			   and MoSCoW priority. */
			.pill-primary {
				background: #eef4ff;
				color: #1d4ed8;
			}

			.pill-secondary {
				background: #fff7e6;
				color: #92620a;
			}

			.pill-system {
				background: #f4eefe;
				color: #6b21a8;
			}

			.pill-functional {
				background: #eef4ff;
				color: #1d4ed8;
			}

			.pill-non_functional {
				background: #f4eefe;
				color: #6b21a8;
			}

			.pill-must {
				background: #fbf0ef;
				color: #b4231f;
			}

			.pill-should {
				background: #fff7e6;
				color: #92620a;
			}

			.pill-could {
				background: #eef4ff;
				color: #1d4ed8;
			}

			.pill-wont {
				background: var(--canvas);
				color: var(--muted);
			}

			/* OPL status (see /opl). */
			.pill-open {
				background: #fbf0ef;
				color: #b4231f;
			}

			.pill-in_progress {
				background: #fff7e6;
				color: #92620a;
			}

			.pill-closed {
				background: #eafaf0;
				color: #1f7a3d;
			}

			/* Inline editable table cells. Locked by default; click unlocks into an
			   input, blur/Enter saves and locks it back in. */
			[data-editable] {
				position: relative;
				cursor: pointer;
				border-radius: 6px;
				transition: background 0.1s ease;
			}

			[data-editable]:hover:not(.editing):not(.saving) {
				background: var(--canvas);
				box-shadow: inset 0 0 0 1px var(--line);
			}

			[data-editable]:hover:not(.editing):not(.saving)::after {
				content: '✎';
				position: absolute;
				top: 50%;
				right: 6px;
				transform: translateY(-50%);
				font-size: 11px;
				color: var(--muted);
				opacity: 0.7;
			}

			[data-editable].editing {
				background: var(--paper);
				box-shadow: inset 0 0 0 2px var(--ink);
				white-space: normal !important;
				overflow: visible !important;
				text-overflow: unset !important;
				max-width: none !important;
			}

			[data-editable].saving {
				opacity: 0.55;
				cursor: progress;
			}

			[data-editable].save-error {
				box-shadow: inset 0 0 0 2px #b4231f;
			}

			.cell-input {
				display: block;
				width: 100%;
				min-width: 120px;
				font-family: var(--sans);
				font-size: 16px;
				color: var(--ink);
				background: transparent;
				border: none;
				outline: none;
				padding: 0;
				resize: vertical;
			}

			select.cell-input {
				cursor: pointer;
			}

			@media (max-width: 767.98px) {
				dialog.popup {
					position: fixed;
					top: auto;
					bottom: 0;
					left: 0;
					right: 0;
					width: 100%;
					/* The UA stylesheet sets `dialog { max-width: calc(100% -
					   6px - 2em) }`, which silently beat our width:100% and
					   left the sheet 38px narrower than the screen on every
					   phone -- flush corners floating off both edges. Nothing
					   in our own CSS said 282px; the browser did. */
					max-width: none;
					/* dvh, not vh: on mobile Safari/Chrome `vh` is measured
					   against the viewport with the URL bar hidden, so 85vh can
					   be taller than what's actually on screen and the sheet's
					   action buttons end up under the browser chrome. */
					max-height: 85dvh;
					margin: 0;
					padding-top: 22px;
					/* Clear the home indicator on gesture-nav phones -- without
					   this the Cancel/Save row sits under it and is hard to hit. */
					padding-bottom: max(32px, calc(env(safe-area-inset-bottom) + 20px));
					padding-left: 20px;
					padding-right: 20px;
					border-radius: 20px 20px 0 0;
					border-bottom: none;
					transform: translateY(100%);
				}

				/* Side-by-side fields stack on phones. Two 44px-tall date inputs
				   sharing ~280px of usable width render as "yyyy. mm" with the
				   day clipped off -- the Hungarian date format simply doesn't
				   fit in half a phone. Stacking is the only version where the
				   value is fully readable. */
				.popup .popup-row {
					flex-direction: column;
					gap: 0;
				}

				/* Once stacked, each field is a normal row again and needs the
				   standard 18px rhythm back -- the desktop rule that zeroes it
				   only makes sense while the columns sit next to each other. */
				.popup .popup-row > div > label:not(.btn) {
					margin-top: 18px;
				}

				.popup .popup-row > div:first-child > label:not(.btn) {
					margin-top: 18px;
				}
				dialog.popup[open] {
					transform: translateY(0);
				}
				@starting-style {
					dialog.popup[open] {
						transform: translateY(100%);
					}
				}
				dialog.popup::before {
					content: '';
					position: absolute;
					top: 10px;
					left: 50%;
					width: 36px;
					height: 4px;
					border-radius: 999px;
					background: var(--line);
					transform: translateX(-50%);
				}
				.popup-close {
					top: 20px;
				}
			}
		</style>
	</head>
	<body>
		<div class="shell">
			<header class="site-header">
				<a href="/" class="brand">
					<span class="brand-mark">KAED</span>
				</a>
				{user ? (
					<>
						{/* Desktop: the original horizontal dropdown-group nav, unchanged. */}
						<nav class="nav !hidden md:!flex">
							{memberOnly ? (
								<a href="/finance" class="who-link">Finance</a>
							) : (
								<>
									<a href="/opl" class="btn nav-cta">OPL</a>
									<details class="nav-group">
										<summary>Delivery</summary>
										<div class="nav-dropdown">
											<a href="/business-ideas">Business ideas</a>
											<a href="/projects">Projects</a>
											<a href="/system-design">System design</a>
										</div>
									</details>
									<details class="nav-group">
										<summary>Personal</summary>
										<div class="nav-dropdown">
											<a href="/freedom">Freedom</a>
											<a href="/goals">Goals</a>
											<a href="/specific-knowledge">Specific knowledge</a>
										</div>
									</details>
									<details class="nav-group">
										<summary>Sales &amp; Marketing</summary>
										<div class="nav-dropdown">
											<a href="/clients">CRM</a>
										</div>
									</details>
									<details class="nav-group">
										<summary>Finance</summary>
										<div class="nav-dropdown">
											<a href="/finance">Personal finance</a>
											<a href="/finance/investments">Investments</a>
										</div>
									</details>
								</>
							)}
							<span class="who">{user.email}</span>
							<form method="post" action="/api/auth/signout">
								<button type="submit" class="btn ghost">Sign out</button>
							</form>
						</nav>

						{/* Mobile: a single hamburger opening one stacked, full-width
						   panel of large tap targets -- not four inline dropdown
						   triggers wrapped into cramped rows, which is what was here
						   before and read as broken on a phone. */}
						<details class="nav-group mobile-nav md:hidden relative">
							<summary
								class="mobile-nav-trigger flex items-center justify-center w-11 h-11 rounded-full border border-line text-ink cursor-pointer list-none"
								aria-label="Menu"
							>
								<span class="hamburger-icon relative block w-[18px] h-[13px]">
									<span class="absolute inset-x-0 top-0 h-[1.5px] bg-ink transition-transform duration-150"></span>
									<span class="absolute inset-x-0 top-[5.5px] h-[1.5px] bg-ink transition-opacity duration-150"></span>
									<span class="absolute inset-x-0 bottom-0 h-[1.5px] bg-ink transition-transform duration-150"></span>
								</span>
							</summary>
							<div class="nav-dropdown mobile-nav-panel flex flex-col gap-1 w-[min(85vw,320px)] max-h-[75vh] overflow-y-auto p-2">
								{memberOnly ? (
									<a href="/finance" class="mobile-nav-link">Finance</a>
								) : (
									<>
										<a href="/opl" class="btn mobile-nav-cta">OPL</a>
										<p class="mobile-nav-heading">Delivery</p>
										<a href="/business-ideas" class="mobile-nav-link">Business ideas</a>
										<a href="/projects" class="mobile-nav-link">Projects</a>
										<a href="/system-design" class="mobile-nav-link">System design</a>
										<p class="mobile-nav-heading">Personal</p>
										<a href="/freedom" class="mobile-nav-link">Freedom</a>
										<a href="/goals" class="mobile-nav-link">Goals</a>
										<a href="/specific-knowledge" class="mobile-nav-link">Specific knowledge</a>
										<p class="mobile-nav-heading">Sales &amp; Marketing</p>
										<a href="/clients" class="mobile-nav-link">CRM</a>
										<p class="mobile-nav-heading">Finance</p>
										<a href="/finance" class="mobile-nav-link">Personal finance</a>
										<a href="/finance/investments" class="mobile-nav-link">Investments</a>
									</>
								)}
								<div class="mt-2 pt-3 border-t border-line flex flex-col gap-2.5">
									<span class="px-3 text-[13px] text-muted break-all">{user.email}</span>
									<form method="post" action="/api/auth/signout" class="px-1">
										<button type="submit" class="btn ghost w-full justify-center">Sign out</button>
									</form>
								</div>
							</div>
						</details>
					</>
				) : (
					<a href="/login" class="btn ghost">Log in</a>
				)}
			</header>

			<main class="content">
				<slot />
			</main>

			<footer class="site-footer">
				<span>KAED — built by Marton Deak</span>
				<span>© 2026</span>
			</footer>
		</div>

		<script>
			document.addEventListener('click', (event) => {
				const target = event.target as HTMLElement;

				const cell = target.closest<HTMLElement>('[data-editable]');
				if (cell && !cell.classList.contains('editing') && !cell.classList.contains('saving')) {
					startCellEdit(cell);
				}

				const opener = target.closest<HTMLElement>('[data-open-popup]');
				if (opener) {
					const id = opener.dataset.openPopup ?? '';
					const dialog = document.getElementById(id);
					if (dialog instanceof HTMLDialogElement) dialog.showModal();
				}

				const closer = target.closest<HTMLElement>('[data-close-popup]');
				if (closer) {
					closer.closest('dialog')?.close();
				}

				// Clicking the ::backdrop fires on the <dialog> itself, not its content.
				if (target instanceof HTMLDialogElement && target.classList.contains('popup')) {
					target.close();
				}

				// Close nav dropdowns when clicking outside them or on a link inside them.
				const insideNavGroup = target.closest<HTMLDetailsElement>('.nav-group');
				document.querySelectorAll<HTMLDetailsElement>('.nav-group[open]').forEach((group) => {
					if (group !== insideNavGroup || target.closest('a')) group.open = false;
				});
			});

			/**
			 * Inline table-cell editing: click a cell to "unlock" it into an input,
			 * blur/Enter "locks" it back in by saving, Escape cancels without saving.
			 */
			function startCellEdit(cell: HTMLElement) {
				const type = cell.dataset.editable ?? 'text';
				const field = cell.dataset.field ?? '';
				const rowId = cell.dataset.id ?? '';
				const endpoint = cell.dataset.endpoint ?? '';
				const originalValue = cell.dataset.value ?? '';
				const originalHtml = cell.innerHTML;

				cell.classList.add('editing');

				let input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

				if (type === 'select') {
					const select = document.createElement('select');
					// JSON, not "value:label,value:label" -- labels are user text
					// and legitimately contain both commas and colons, which the
					// old delimiter format silently truncated (a project titled
					// "OPL: Open Point List" rendered as the option "OPL").
					// Built by selectOptions() in lib/select-options.ts.
					let options: [string, string][] = [];
					try {
						options = JSON.parse(cell.dataset.options || '[]');
					} catch {
						options = [];
					}
					for (const [value, label] of options) {
						const opt = document.createElement('option');
						opt.value = value;
						opt.textContent = label;
						if (value === originalValue) opt.selected = true;
						select.appendChild(opt);
					}
					input = select;
				} else if (type === 'textarea') {
					const textarea = document.createElement('textarea');
					textarea.rows = 2;
					textarea.value = originalValue;
					input = textarea;
				} else {
					const el = document.createElement('input');
					el.type = type === 'date' ? 'date' : type === 'number' ? 'number' : type === 'url' ? 'url' : 'text';
					el.value = originalValue;
					input = el;
				}

				input.className = 'cell-input';
				cell.innerHTML = '';
				cell.appendChild(input);
				input.focus();
				if (input instanceof HTMLInputElement) input.select();

				let settled = false;

				const finish = () => cell.classList.remove('editing', 'saving');

				const cancel = () => {
					if (settled) return;
					settled = true;
					cell.innerHTML = originalHtml;
					finish();
				};

				const save = async () => {
					if (settled) return;
					settled = true;
					const newValue = input.value.trim();

					if (newValue === originalValue) {
						cell.innerHTML = originalHtml;
						finish();
						return;
					}

					cell.classList.remove('editing');
					cell.classList.add('saving');

					try {
						const response = await fetch(`${endpoint}/${rowId}/field`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ field, value: newValue }),
						});
						if (!response.ok) throw new Error('save failed');

						cell.dataset.value = newValue;
						if (type === 'select' && input instanceof HTMLSelectElement) {
							const label = input.options[input.selectedIndex]?.textContent ?? newValue;
							cell.innerHTML = `<span class="pill pill-${newValue}">${label}</span>`;
						} else {
							cell.textContent = newValue || '—';
						}
					} catch {
						cell.innerHTML = originalHtml;
						cell.classList.add('save-error');
						setTimeout(() => cell.classList.remove('save-error'), 1200);
					} finally {
						finish();
					}
				};

				input.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' && type !== 'textarea') {
						event.preventDefault();
						save();
					} else if (event.key === 'Escape') {
						event.preventDefault();
						cancel();
					}
				});
				input.addEventListener('blur', save);
				if (type === 'select') input.addEventListener('change', save);
			}
		</script>
	</body>
</html>
