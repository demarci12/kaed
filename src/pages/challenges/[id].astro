---
import Layout from '../../layouts/Layout.astro';
import { requireUser, type Challenge, type ChallengeLog, type ChallengeTodo } from '../../lib/challenges';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { id } = Astro.params;

const { data: challenge } = await supabase
	.from('challenges')
	.select('*')
	.eq('id', id)
	.maybeSingle();

if (!challenge) {
	return Astro.redirect('/challenges');
}

const { data: logs } = await supabase
	.from('challenge_logs')
	.select('*')
	.eq('challenge_id', id)
	.order('created_at', { ascending: false });

const { data: todos } = await supabase
	.from('challenge_todos')
	.select('*')
	.eq('challenge_id', id)
	.order('created_at', { ascending: true });

const typed = challenge as Challenge;
const typedLogs = (logs ?? []) as ChallengeLog[];
const typedTodos = (todos ?? []) as ChallengeTodo[];

const doneCount = typedTodos.filter((t) => t.is_done).length;

const statusLabel: Record<string, string> = {
	not_started: 'Not started',
	active: 'Active',
	done: 'Done',
};

const proofStatusLabel: Record<string, string> = {
	pending: 'Pending',
	verified: 'Verified',
	rejected: 'Rejected',
};

const error = Astro.url.searchParams.get('error');
---

<Layout>
	<section class="detail">
		<a class="back" href="/challenges">← Challenges</a>

		<div class="head">
			<h1>{typed.title}</h1>
			<span class={`pill pill-${typed.status}`}>{statusLabel[typed.status]}</span>
		</div>

		{typed.description && <p class="lede">{typed.description}</p>}

		{(typed.start_date || typed.target_end_date) && (
			<p class="dates">{typed.start_date ?? '—'} → {typed.target_end_date ?? '—'}</p>
		)}

		{error && <p class="form-error">{error}</p>}

		<form method="post" action={`/api/challenges/${typed.id}/status`} class="status-form">
			<label for="status">Status</label>
			<select id="status" name="status">
				<option value="not_started" selected={typed.status === 'not_started'}>Not started</option>
				<option value="active" selected={typed.status === 'active'}>Active</option>
				<option value="done" selected={typed.status === 'done'}>Done</option>
			</select>
			<button type="submit" class="btn ghost">Update status</button>
		</form>

		<div class="section">
			<div class="section-head">
				<h2>To reach the goal</h2>
				{typedTodos.length > 0 && (
					<span class="progress-count">{doneCount}/{typedTodos.length}</span>
				)}
			</div>

			{typedTodos.length > 0 && (
				<div class="progress-bar">
					<div class="progress-bar-fill" style={`width: ${(doneCount / typedTodos.length) * 100}%`} />
				</div>
			)}

			<ul class="todo-list">
				{typedTodos.length ? (
					typedTodos.map((todo) => (
						<li class="todo-item">
							<form method="post" action={`/api/challenges/${typed.id}/todos/${todo.id}/toggle`} class="todo-form">
								<input type="hidden" name="is_done" value={String(todo.is_done)} />
								<button type="submit" class={`todo-check ${todo.is_done ? 'checked' : ''}`} aria-label="Toggle done">
									{todo.is_done && '✓'}
								</button>
							</form>
							<span class={`todo-title ${todo.is_done ? 'done' : ''}`}>{todo.title}</span>
						</li>
					))
				) : (
					<p class="empty">No sub-goals yet.</p>
				)}
			</ul>

			<details class="dropup">
				<summary class="dropup-trigger">+ Add sub-goal</summary>
				<div class="dropup-panel">
					<form method="post" action={`/api/challenges/${typed.id}/todos`} class="inline-form">
						<input name="title" type="text" placeholder="e.g. Ship the first draft" required maxlength="200" />
						<button type="submit" class="btn">Add</button>
					</form>
				</div>
			</details>
		</div>

		<div class="section">
			<h2>Timeline</h2>

			<div class="timeline">
				{typedLogs.length ? (
					typedLogs.map((log) => (
						<div class="timeline-entry">
							<div class="timeline-marker">
								<span class={`timeline-dot proof-${log.status}`} />
								<span class="timeline-line" />
							</div>
							<div class="timeline-content">
								<div class="timeline-head">
									<span class="log-date">{new Date(log.created_at).toLocaleString()}</span>
									<span class={`proof-pill proof-${log.status}`}>{proofStatusLabel[log.status]}</span>
								</div>
								<p class="log-note">{log.note}</p>
								{log.proof_type === 'link' && log.proof_url && (
									<a class="log-proof" href={log.proof_url} target="_blank" rel="noopener noreferrer">
										View proof link →
									</a>
								)}
								{log.proof_type === 'image' && log.proof_url && (
									<img class="log-proof-image" src={log.proof_url} alt="Proof" />
								)}
							</div>
						</div>
					))
				) : (
					<p class="empty">No progress logged yet.</p>
				)}
			</div>

			<details class="dropup">
				<summary class="dropup-trigger">+ Log progress</summary>
				<div class="dropup-panel">
					<form
						method="post"
						action={`/api/challenges/${typed.id}/logs`}
						enctype="multipart/form-data"
						class="log-form"
					>
						<label for="note">Note</label>
						<textarea id="note" name="note" rows="3" required></textarea>

						<label for="proof_type">Proof</label>
						<select id="proof_type" name="proof_type" data-proof-select>
							<option value="text">Text only</option>
							<option value="link">Link</option>
							<option value="image">Image</option>
						</select>

						<div class="proof-field" data-proof-field="link" hidden>
							<label for="proof_link">Proof URL</label>
							<input id="proof_link" name="proof_link" type="url" placeholder="https://" />
						</div>

						<div class="proof-field" data-proof-field="image" hidden>
							<label for="proof_file">Proof image</label>
							<input id="proof_file" name="proof_file" type="file" accept="image/*" />
						</div>

						<button type="submit" class="btn">Log progress</button>
					</form>
				</div>
			</details>
		</div>
	</section>
</Layout>

<script>
	const select = document.querySelector('[data-proof-select]') as HTMLSelectElement | null;
	const fields = document.querySelectorAll<HTMLElement>('[data-proof-field]');

	const sync = () => {
		const value = select?.value ?? 'text';
		fields.forEach((field) => {
			field.hidden = field.dataset.proofField !== value;
		});
	};

	select?.addEventListener('change', sync);
	sync();

	// Only one dropup open at a time.
	const dropups = document.querySelectorAll<HTMLDetailsElement>('.dropup');
	dropups.forEach((dropup) => {
		dropup.addEventListener('toggle', () => {
			if (dropup.open) {
				dropups.forEach((other) => {
					if (other !== dropup) other.open = false;
				});
			}
		});
	});
</script>

<style>
	.detail {
		max-width: 720px;
	}

	.back {
		display: inline-block;
		margin-bottom: 24px;
		color: var(--muted);
		text-decoration: none;
		font-size: 14px;
	}

	.back:hover {
		color: var(--ink);
	}

	.head {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2rem, 5vw, 2.8rem);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.dates {
		margin: 10px 0 0;
		font-size: 14px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.pill {
		flex-shrink: 0;
		padding: 4px 12px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 500;
		white-space: nowrap;
	}

	.pill-not_started {
		background: var(--canvas);
		color: var(--muted);
		border: 1px solid var(--line);
	}

	.pill-active {
		background: #eef4ff;
		color: #1d4ed8;
	}

	.pill-done {
		background: #eafaf0;
		color: #1f7a3d;
	}

	.status-form {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 32px;
	}

	.status-form label {
		font-size: 13px;
		color: var(--muted);
	}

	.status-form select {
		height: 40px;
		padding: 0 12px;
		font-family: var(--sans);
		font-size: 14px;
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 999px;
		outline: none;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		height: 40px;
		padding: 0 20px;
		font-family: var(--sans);
		font-size: 14px;
		font-weight: 500;
		color: #fff;
		background: var(--ink);
		border: 1px solid var(--ink);
		border-radius: 999px;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.btn:hover {
		background: transparent;
		color: var(--ink);
	}

	.btn.ghost {
		background: transparent;
		color: var(--ink);
		border-color: var(--line);
	}

	.btn.ghost:hover {
		border-color: var(--ink);
	}

	.section {
		margin-top: 56px;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
	}

	.section h2 {
		margin: 0 0 20px;
		font-family: var(--serif);
		font-size: 22px;
		font-weight: 600;
	}

	.progress-count {
		font-size: 13px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.progress-bar {
		height: 6px;
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 999px;
		overflow: hidden;
		margin: -8px 0 20px;
	}

	.progress-bar-fill {
		height: 100%;
		background: var(--ink);
		transition: width 0.2s ease;
	}

	.empty {
		color: var(--muted);
		font-size: 15px;
	}

	/* Todos */
	.todo-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.todo-item {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px 4px;
		border-bottom: 1px solid var(--line);
	}

	.todo-item:last-child {
		border-bottom: none;
	}

	.todo-form {
		margin: 0;
	}

	.todo-check {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid var(--line);
		background: var(--paper);
		color: #fff;
		font-size: 13px;
		cursor: pointer;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.todo-check.checked {
		background: var(--ink);
		border-color: var(--ink);
	}

	.todo-title {
		font-size: 15px;
	}

	.todo-title.done {
		color: var(--muted);
		text-decoration: line-through;
	}

	/* Timeline */
	.timeline {
		display: flex;
		flex-direction: column;
	}

	.timeline-entry {
		display: flex;
		gap: 18px;
	}

	.timeline-marker {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex-shrink: 0;
		width: 12px;
	}

	.timeline-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--muted);
		border: 2px solid var(--paper);
		box-shadow: 0 0 0 1px var(--line);
		margin-top: 6px;
	}

	.timeline-dot.proof-verified {
		background: #1f7a3d;
	}

	.timeline-dot.proof-rejected {
		background: #b4231f;
	}

	.timeline-dot.proof-pending {
		background: #92620a;
	}

	.timeline-line {
		flex: 1;
		width: 1px;
		background: var(--line);
		margin-top: 4px;
	}

	.timeline-entry:last-child .timeline-line {
		display: none;
	}

	.timeline-content {
		flex: 1;
		padding-bottom: 28px;
	}

	.timeline-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.log-date {
		font-size: 13px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.proof-pill {
		padding: 3px 10px;
		border-radius: 999px;
		font-size: 11px;
		font-weight: 500;
	}

	.proof-pending {
		background: #fff7e6;
		color: #92620a;
	}

	.proof-verified {
		background: #eafaf0;
		color: #1f7a3d;
	}

	.proof-rejected {
		background: #fbf0ef;
		color: #b4231f;
	}

	.log-note {
		margin: 8px 0 0;
		font-size: 15px;
		line-height: 1.6;
	}

	.log-proof {
		display: inline-block;
		margin-top: 10px;
		font-size: 14px;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--line);
	}

	.log-proof:hover {
		border-color: var(--ink);
	}

	.log-proof-image {
		display: block;
		margin-top: 12px;
		max-width: 100%;
		border-radius: 10px;
		border: 1px solid var(--line);
	}

	/* Dropup */
	.dropup {
		margin-top: 20px;
	}

	.dropup-trigger {
		display: inline-flex;
		align-items: center;
		height: 40px;
		padding: 0 20px;
		font-family: var(--sans);
		font-size: 14px;
		font-weight: 500;
		color: var(--ink);
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 999px;
		cursor: pointer;
		list-style: none;
		transition: border-color 0.15s ease;
	}

	.dropup-trigger::-webkit-details-marker {
		display: none;
	}

	.dropup-trigger:hover {
		border-color: var(--ink);
	}

	.dropup[open] .dropup-trigger {
		border-color: var(--ink);
	}

	.dropup-panel {
		display: flex;
		flex-direction: column;
		margin-bottom: 12px;
		padding: 24px;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 16px;
		animation: dropup-in 0.15s ease;
	}

	@keyframes dropup-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.inline-form {
		display: flex;
		gap: 10px;
	}

	.inline-form input {
		flex: 1;
		height: 44px;
		padding: 0 14px;
		font-family: var(--sans);
		font-size: 15px;
		color: var(--ink);
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 10px;
		outline: none;
	}

	.inline-form input:focus {
		border-color: var(--ink);
	}

	.log-form {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.log-form label {
		margin-top: 14px;
		font-size: 13px;
		font-weight: 500;
		color: var(--muted);
	}

	.log-form textarea,
	.log-form select,
	.log-form input {
		font-family: var(--sans);
		font-size: 15px;
		color: var(--ink);
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 10px 14px;
		outline: none;
		resize: vertical;
	}

	.log-form textarea:focus,
	.log-form select:focus,
	.log-form input:focus {
		border-color: var(--ink);
	}

	.log-form .btn {
		align-self: flex-start;
		margin-top: 24px;
	}
</style>
