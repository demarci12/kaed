---
import Layout from '../../layouts/Layout.astro';
import { requireUser, type Challenge } from '../../lib/challenges';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: challenges } = await supabase
	.from('challenges')
	.select('*')
	.order('created_at', { ascending: false });

const typedChallenges = (challenges ?? []) as Challenge[];

const statusLabel: Record<string, string> = {
	not_started: 'Not started',
	active: 'Active',
	done: 'Done',
};

const error = Astro.url.searchParams.get('error');
---

<Layout>
	<section class="challenges">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Challenges.</h1>
				<p class="lede">Things you've set out to accomplish, and the trail of proof behind them.</p>
			</div>
			<button type="button" class="btn" data-open-popup="new-challenge">+ New challenge</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="table-wrap">
			<table class="data-table">
				<thead>
					<tr>
						<th>Title</th>
						<th>Description</th>
						<th>Status</th>
						<th>Start</th>
						<th>Target end</th>
						<th>Created</th>
					</tr>
				</thead>
				<tbody>
					{typedChallenges.length ? (
						typedChallenges.map((challenge) => (
							<tr class="row-link">
								<td class="cell-title">
									<a href={`/challenges/${challenge.id}`}>{challenge.title}</a>
								</td>
								<td
									class="cell-muted"
									data-editable="textarea"
									data-field="description"
									data-id={challenge.id}
									data-endpoint="/api/challenges"
									data-value={challenge.description ?? ''}
								>
									{challenge.description ?? '—'}
								</td>
								<td
									data-editable="select"
									data-field="status"
									data-id={challenge.id}
									data-endpoint="/api/challenges"
									data-value={challenge.status}
									data-options="not_started:Not started,active:Active,done:Done"
								>
									<span class={`pill pill-${challenge.status}`}>{statusLabel[challenge.status]}</span>
								</td>
								<td
									class="cell-date"
									data-editable="date"
									data-field="start_date"
									data-id={challenge.id}
									data-endpoint="/api/challenges"
									data-value={challenge.start_date ?? ''}
								>
									{challenge.start_date ?? '—'}
								</td>
								<td
									class="cell-date"
									data-editable="date"
									data-field="target_end_date"
									data-id={challenge.id}
									data-endpoint="/api/challenges"
									data-value={challenge.target_end_date ?? ''}
								>
									{challenge.target_end_date ?? '—'}
								</td>
								<td class="cell-date">{new Date(challenge.created_at).toLocaleDateString()}</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="6" class="empty-cell">No challenges yet. Create your first one.</td>
						</tr>
					)}
				</tbody>
			</table>
		</div>
	</section>

	<dialog id="new-challenge" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>New challenge</h2>
		<form method="post" action="/api/challenges/create">
			<label for="title">Title</label>
			<input id="title" name="title" type="text" required maxlength="120" />

			<label for="description">Description</label>
			<textarea id="description" name="description" rows="3"></textarea>

			<div class="popup-row">
				<div>
					<label for="start_date">Start date</label>
					<input id="start_date" name="start_date" type="date" />
				</div>
				<div>
					<label for="target_end_date">Target end date</label>
					<input id="target_end_date" name="target_end_date" type="date" />
				</div>
			</div>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Create challenge</button>
			</div>
		</form>
	</dialog>
</Layout>

<style>
	.challenges {
		max-width: 1040px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.table-wrap {
		margin-top: 40px;
		overflow-x: auto;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
		white-space: nowrap;
	}

	.data-table th {
		text-align: left;
		padding: 12px 16px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		background: var(--canvas);
	}

	.data-table td {
		padding: 14px 16px;
		border-bottom: 1px solid var(--line);
		vertical-align: middle;
	}

	.data-table tr:last-child td {
		border-bottom: none;
	}

	.row-link {
		cursor: pointer;
		transition: background 0.1s ease;
	}

	.row-link:hover {
		background: var(--canvas);
	}

	.cell-title a {
		color: var(--ink);
		text-decoration: none;
		font-weight: 500;
	}

	.cell-title a:hover {
		text-decoration: underline;
	}

	.cell-muted {
		color: var(--muted);
		max-width: 320px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.cell-date {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.empty-cell {
		padding: 32px 16px;
		text-align: center;
		color: var(--muted);
	}

	.pill {
		flex-shrink: 0;
		padding: 4px 12px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 500;
		white-space: nowrap;
	}

	.pill-not_started {
		background: var(--canvas);
		color: var(--muted);
		border: 1px solid var(--line);
	}

	.pill-active {
		background: #eef4ff;
		color: #1d4ed8;
	}

	.pill-done {
		background: #eafaf0;
		color: #1f7a3d;
	}

	@media (max-width: 720px) {
		.page-head {
			flex-direction: column;
			align-items: stretch;
		}
		.page-head .btn {
			align-self: flex-start;
		}
		.cell-muted {
			max-width: 160px;
		}
	}
</style>
