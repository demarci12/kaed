---
import Layout from '../../layouts/Layout.astro';
import { HEADLINE_SIGNAL_TYPES, type Project, type ProjectLog, type SignalType } from '../../lib/projects';
import { requireUser, type Challenge } from '../../lib/challenges';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { id } = Astro.params;

const { data: project } = await supabase
	.from('projects')
	.select('*')
	.eq('id', id)
	.maybeSingle();

if (!project) {
	return Astro.redirect('/projects');
}

const { data: logs } = await supabase
	.from('project_logs')
	.select('*')
	.eq('project_id', id)
	.order('created_at', { ascending: false });

const { data: challenges } = await supabase
	.from('challenges')
	.select('*')
	.eq('project_id', id)
	.order('created_at', { ascending: true });

const typed = project as Project;
const typedLogs = (logs ?? []) as ProjectLog[];
const typedChallenges = (challenges ?? []) as Challenge[];

let originIdea: { id: string; title: string } | null = null;
if (typed.business_idea_id) {
	const { data } = await supabase
		.from('business_ideas')
		.select('id, title')
		.eq('id', typed.business_idea_id)
		.maybeSingle();
	originIdea = data;
}

const doneCount = typedChallenges.filter((c) => c.is_done).length;

const signalCounts = typedLogs.reduce(
	(acc, log) => {
		acc[log.signal_type] = (acc[log.signal_type] ?? 0) + 1;
		return acc;
	},
	{} as Record<SignalType, number>
);
const headlineSignalCount = HEADLINE_SIGNAL_TYPES.reduce((sum, type) => sum + (signalCounts[type] ?? 0), 0);

const signalLabel: Record<SignalType, string> = {
	progress: 'Progress',
	customer_contact: 'conversations',
	interest_expressed: 'interested',
	paid: 'paid',
	rejected: 'rejected',
};

const statusLabel: Record<string, string> = {
	not_started: 'Not started',
	active: 'Active',
	done: 'Done',
};

const proofStatusLabel: Record<string, string> = {
	pending: 'Pending',
	verified: 'Verified',
	rejected: 'Rejected',
};

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="detail">
		<a class="back" href="/projects">← Projects</a>

		<div class="head">
			<h1>{typed.title}</h1>
			<span class={`pill pill-${typed.status}`}>{statusLabel[typed.status]}</span>
		</div>

		{originIdea && (
			<a class="origin" href={`/business-ideas/${originIdea.id}`}>from business idea: {originIdea.title}</a>
		)}

		{typed.description && <p class="lede">{typed.description}</p>}

		{(typed.start_date || typed.target_end_date) && (
			<p class="dates">{typed.start_date ?? '—'} → {typed.target_end_date ?? '—'}</p>
		)}

		{error && <p class="form-error">{error}</p>}

		<form method="post" action={`/api/projects/${typed.id}/status`} class="status-form">
			<label for="status">Status</label>
			<select id="status" name="status">
				<option value="not_started" selected={typed.status === 'not_started'}>Not started</option>
				<option value="active" selected={typed.status === 'active'}>Active</option>
				<option value="done" selected={typed.status === 'done'}>Done</option>
			</select>
			<button type="submit" class="btn ghost">Update status</button>
			<button type="submit" form="delete-project" class="btn danger">Delete project</button>
		</form>

		<form id="delete-project" method="post" action={`/api/projects/${typed.id}/delete`}></form>

		<div class="section">
			<div class="section-head">
				<h2>Challenges</h2>
				<div class="section-head-actions">
					{typedChallenges.length > 0 && (
						<span class="progress-count">{doneCount}/{typedChallenges.length}</span>
					)}
					<button type="button" class="btn ghost small" data-open-popup="new-challenge">+ Add challenge</button>
				</div>
			</div>

			{typedChallenges.length > 0 && (
				<div class="progress-bar">
					<div class="progress-bar-fill" style={`width: ${(doneCount / typedChallenges.length) * 100}%`} />
				</div>
			)}

			<div class="table-wrap">
				<table class="data-table">
					<thead>
						<tr>
							<th>Done</th>
							<th>Challenge</th>
							<th>Added</th>
						</tr>
					</thead>
					<tbody>
						{typedChallenges.length ? (
							typedChallenges.map((challenge) => (
								<tr>
									<td>
										<form method="post" action={`/api/projects/${typed.id}/challenges/${challenge.id}/toggle`} class="challenge-form">
											<input type="hidden" name="is_done" value={String(challenge.is_done)} />
											<button type="submit" class={`challenge-check ${challenge.is_done ? 'checked' : ''}`} aria-label="Toggle done">
												{challenge.is_done && '✓'}
											</button>
										</form>
									</td>
									<td class={challenge.is_done ? 'challenge-title done' : 'challenge-title'}>{challenge.title}</td>
									<td class="cell-date">{new Date(challenge.created_at).toLocaleDateString()}</td>
								</tr>
							))
						) : (
							<tr>
								<td colspan="3" class="empty-cell">No challenges yet.</td>
							</tr>
						)}
					</tbody>
				</table>
			</div>
		</div>

		<div class="section">
			<div class="section-head">
				<h2>Timeline</h2>
				<button type="button" class="btn ghost small" data-open-popup="new-log">+ Log progress</button>
			</div>

			<div class="signals">
				<span class="signals-headline">{headlineSignalCount} validation signal{headlineSignalCount === 1 ? '' : 's'}</span>
				{(Object.keys(signalCounts) as SignalType[])
					.filter((type) => type !== 'progress' && signalCounts[type])
					.map((type) => (
						<span class="signals-breakdown">{signalCounts[type]} {signalLabel[type]}</span>
					))}
			</div>

			<div class="timeline">
				{typedLogs.length ? (
					typedLogs.map((log) => (
						<div class="timeline-entry">
							<div class="timeline-marker">
								<span class={`timeline-dot proof-${log.status}`} />
								<span class="timeline-line" />
							</div>
							<div class="timeline-content">
								<div class="timeline-head">
									<span class="log-date">{new Date(log.created_at).toLocaleString()}</span>
									<span class={`proof-pill proof-${log.status}`}>{proofStatusLabel[log.status]}</span>
								</div>
								<p class="log-note">{log.note}</p>
								{log.proof_type === 'link' && log.proof_url && (
									<a class="log-proof" href={log.proof_url} target="_blank" rel="noopener noreferrer">
										View proof link →
									</a>
								)}
								{log.proof_type === 'image' && log.proof_url && (
									<img class="log-proof-image" src={log.proof_url} alt="Proof" />
								)}
							</div>
						</div>
					))
				) : (
					<p class="empty">No progress logged yet.</p>
				)}
			</div>
		</div>
	</section>

	<dialog id="new-challenge" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Add challenge</h2>
		<form method="post" action={`/api/projects/${typed.id}/challenges`}>
			<label for="challenge-title">Title</label>
			<input id="challenge-title" name="title" type="text" placeholder="e.g. Ship the first draft" required maxlength="200" />
			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Add</button>
			</div>
		</form>
	</dialog>

	<dialog id="new-log" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Log progress</h2>
		<form method="post" action={`/api/projects/${typed.id}/logs`} enctype="multipart/form-data">
			<label for="note">Note</label>
			<textarea id="note" name="note" rows="3" required></textarea>

			<label for="signal_type">Signal</label>
			<select id="signal_type" name="signal_type">
				<option value="progress">Just progress — no external signal</option>
				<option value="customer_contact">Talked to a prospect</option>
				<option value="interest_expressed">Someone expressed interest</option>
				<option value="paid">Someone paid</option>
				<option value="rejected">Got a rejection</option>
			</select>

			<label for="proof_type">Proof</label>
			<select id="proof_type" name="proof_type" data-proof-select>
				<option value="text">Text only</option>
				<option value="link">Link</option>
				<option value="image">Image</option>
			</select>

			<div class="proof-field" data-proof-field="link" hidden>
				<label for="proof_link">Proof URL</label>
				<input id="proof_link" name="proof_link" type="url" placeholder="https://" />
			</div>

			<div class="proof-field" data-proof-field="image" hidden>
				<label for="proof_file">Proof image</label>
				<input id="proof_file" name="proof_file" type="file" accept="image/*" />
			</div>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Log progress</button>
			</div>
		</form>
	</dialog>
</Layout>

<script>
	const select = document.querySelector('[data-proof-select]') as HTMLSelectElement | null;
	const fields = document.querySelectorAll<HTMLElement>('[data-proof-field]');

	const sync = () => {
		const value = select?.value ?? 'text';
		fields.forEach((field) => {
			field.hidden = field.dataset.proofField !== value;
		});
	};

	select?.addEventListener('change', sync);
	sync();
</script>

<style>
	.detail {
		max-width: 860px;
	}

	.head {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}

	.origin {
		display: inline-block;
		margin-top: 10px;
		font-size: 13px;
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px dotted var(--line);
	}

	.origin:hover {
		color: var(--ink);
		border-color: var(--ink);
	}

	.dates {
		margin: 10px 0 0;
		font-size: 14px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.status-form {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 32px;
	}

	.status-form label {
		font-size: 13px;
		color: var(--muted);
	}

	.status-form select {
		height: 40px;
		padding: 0 12px;
		font-family: var(--sans);
		font-size: 14px;
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 999px;
		outline: none;
	}

	.section {
		margin-top: 56px;
	}

	.section-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
	}

	.section-head-actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.section h2 {
		margin: 0 0 20px;
		font-family: var(--serif);
		font-size: 22px;
		font-weight: 600;
	}

	.progress-count {
		font-size: 13px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.progress-bar {
		height: 6px;
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 999px;
		overflow: hidden;
		margin-bottom: 20px;
	}

	.progress-bar-fill {
		height: 100%;
		background: var(--ink);
		transition: width 0.2s ease;
	}

	/* Plain inline sentence here, not the boxed empty state a card grid uses. */
	.empty {
		grid-column: auto;
		padding: 0;
		border: none;
		text-align: left;
		color: var(--muted);
		font-size: 15px;
	}

	.signals {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 20px;
	}

	.signals-headline {
		font-size: 14px;
		font-weight: 500;
	}

	.signals-breakdown {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--canvas);
		border: 1px solid var(--line);
		font-size: 12px;
		color: var(--muted);
	}

	/* Denser rows than the shared table default. */
	.data-table td {
		padding: 10px 16px;
	}

	.empty-cell {
		padding: 28px 16px;
	}

	.challenge-form {
		margin: 0;
	}

	.challenge-check {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid var(--line);
		background: var(--paper);
		color: #fff;
		font-size: 13px;
		cursor: pointer;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.challenge-check.checked {
		background: var(--ink);
		border-color: var(--ink);
	}

	.challenge-title.done {
		color: var(--muted);
		text-decoration: line-through;
	}

	/* Timeline */
	.timeline {
		display: flex;
		flex-direction: column;
	}

	.timeline-entry {
		display: flex;
		gap: 18px;
	}

	.timeline-marker {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex-shrink: 0;
		width: 12px;
	}

	.timeline-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--muted);
		border: 2px solid var(--paper);
		box-shadow: 0 0 0 1px var(--line);
		margin-top: 6px;
	}

	.timeline-dot.proof-verified {
		background: #1f7a3d;
	}

	.timeline-dot.proof-rejected {
		background: #b4231f;
	}

	.timeline-dot.proof-pending {
		background: #92620a;
	}

	.timeline-line {
		flex: 1;
		width: 1px;
		background: var(--line);
		margin-top: 4px;
	}

	.timeline-entry:last-child .timeline-line {
		display: none;
	}

	.timeline-content {
		flex: 1;
		padding-bottom: 28px;
	}

	.timeline-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.log-date {
		font-size: 13px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.proof-pill {
		padding: 3px 10px;
		border-radius: 999px;
		font-size: 11px;
		font-weight: 500;
	}

	.proof-pending {
		background: #fff7e6;
		color: #92620a;
	}

	.proof-verified {
		background: #eafaf0;
		color: #1f7a3d;
	}

	.proof-rejected {
		background: #fbf0ef;
		color: #b4231f;
	}

	.log-note {
		margin: 8px 0 0;
		font-size: 15px;
		line-height: 1.6;
	}

	.log-proof {
		display: inline-block;
		margin-top: 10px;
		font-size: 14px;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--line);
	}

	.log-proof:hover {
		border-color: var(--ink);
	}

	.log-proof-image {
		display: block;
		margin-top: 12px;
		max-width: 100%;
		border-radius: 10px;
		border: 1px solid var(--line);
	}

	@media (max-width: 720px) {
		.section-head {
			align-items: flex-start;
		}
	}
</style>
