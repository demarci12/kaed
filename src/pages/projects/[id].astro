---
import Layout from '../../layouts/Layout.astro';
import { selectOptionsFromLabels } from '../../lib/select-options';
import { HEADLINE_SIGNAL_TYPES, FUNDING_STAGE_LABELS, type Project, type ProjectLog, type SignalType , externalHref } from '../../lib/projects';
import { requireUser } from '../../lib/projects';
import { OPEN_POINT_STATUS_LABELS, type OpenPoint } from '../../lib/open-points';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { id } = Astro.params;

const { data: project } = await supabase
	.from('projects')
	.select('*')
	.eq('id', id)
	.maybeSingle();

if (!project) {
	return Astro.redirect('/projects');
}

const [{ data: logs }, { data: openPoints }] = await Promise.all([
	supabase.from('project_logs').select('*').eq('project_id', id).order('created_at', { ascending: false }),
	supabase.from('open_points').select('*').eq('project_id', id).order('created_at', { ascending: true }),
]);

const typed = project as Project;
const typedLogs = (logs ?? []) as ProjectLog[];
const typedOpenPoints = (openPoints ?? []) as OpenPoint[];

let originIdea: { id: string; title: string } | null = null;
if (typed.business_idea_id) {
	const { data } = await supabase
		.from('business_ideas')
		.select('id, title')
		.eq('id', typed.business_idea_id)
		.maybeSingle();
	originIdea = data;
}

const doneCount = typedOpenPoints.filter((point) => point.status === 'closed').length;

const signalCounts = typedLogs.reduce(
	(acc, log) => {
		acc[log.signal_type] = (acc[log.signal_type] ?? 0) + 1;
		return acc;
	},
	{} as Record<SignalType, number>
);
const headlineSignalCount = HEADLINE_SIGNAL_TYPES.reduce((sum, type) => sum + (signalCounts[type] ?? 0), 0);

const signalLabel: Record<SignalType, string> = {
	progress: 'Progress',
	customer_contact: 'conversations',
	interest_expressed: 'interested',
	paid: 'paid',
	rejected: 'rejected',
};

const statusLabel: Record<string, string> = {
	not_started: 'Not started',
	active: 'Active',
	done: 'Done',
};

const proofStatusLabel: Record<string, string> = {
	pending: 'Pending',
	verified: 'Verified',
	rejected: 'Rejected',
};

const proofPillClass: Record<string, string> = {
	pending: 'bg-warn-bg text-warn',
	verified: 'bg-positive-bg text-positive',
	rejected: 'bg-negative-bg text-negative',
};

const fundingStageOptions = selectOptionsFromLabels(FUNDING_STAGE_LABELS, ['', 'Pick stage']);

const timelineDotClass: Record<string, string> = {
	pending: 'bg-warn',
	verified: 'bg-positive',
	rejected: 'bg-negative',
};

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="detail max-w-[860px]">
		<a class="back" href="/projects">← Projects</a>

		<div class="head flex items-center gap-3.5 flex-wrap">
			<h1>{typed.title}</h1>
			<span class={`pill pill-${typed.status}`}>{statusLabel[typed.status]}</span>
		</div>

		{originIdea && (
			<a class="origin inline-block mt-2.5 text-[13px] text-muted no-underline border-b border-dotted border-line hover:text-ink hover:border-ink" href={`/business-ideas/${originIdea.id}`}>from business idea: {originIdea.title}</a>
		)}

		{typed.description && <p class="lede">{typed.description}</p>}

		{(typed.start_date || typed.target_end_date) && (
			<p class="dates mt-2.5 mb-0 text-sm text-muted tabular-nums">{typed.start_date ?? '—'} → {typed.target_end_date ?? '—'}</p>
		)}

		{error && <p class="form-error">{error}</p>}

		<form method="post" action={`/api/projects/${typed.id}/status`} class="status-form flex items-center gap-3 mt-8">
			<label for="status" class="text-[13px] text-muted">Status</label>
			<select id="status" name="status" class="h-10 px-3 font-sans text-sm bg-canvas border border-line rounded-full outline-none">
				<option value="not_started" selected={typed.status === 'not_started'}>Not started</option>
				<option value="active" selected={typed.status === 'active'}>Active</option>
				<option value="done" selected={typed.status === 'done'}>Done</option>
			</select>
			<button type="submit" class="btn ghost">Update status</button>
			<button type="submit" form="delete-project" class="btn danger">Delete project</button>
		</form>

		<form id="delete-project" method="post" action={`/api/projects/${typed.id}/delete`}></form>

		<div class="section mt-10">
			<h2 class="m-0 mb-5 font-serif text-[22px] font-semibold">Overview</h2>
			<p
				class="tagline text-lg leading-relaxed py-[10px] px-3 -mx-3 rounded-[10px] cursor-text transition-colors duration-150"
				data-editable="text"
				data-field="tagline"
				data-id={typed.id}
				data-endpoint="/api/projects"
				data-value={typed.tagline ?? ''}
			>
				{typed.tagline || 'Add a one-line pitch…'}
			</p>

			<div class="metadata-grid grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-5 mt-2">
				<div class="card-field">
					<span class="card-field-label flex items-center justify-between gap-2">
						Website
						{externalHref(typed.website_url) && (
							<a class="text-[11px] font-normal normal-case tracking-normal text-ink no-underline border-b border-line hover:border-ink" href={externalHref(typed.website_url)} target="_blank" rel="noopener noreferrer">Visit ↗</a>
						)}
					</span>
					<p
						class="card-field-value"
						data-editable="url"
						data-field="website_url"
						data-id={typed.id}
						data-endpoint="/api/projects"
						data-value={typed.website_url ?? ''}
					>
						{typed.website_url || 'Not set.'}
					</p>
				</div>

				<div class="card-field">
					<span class="card-field-label">Location</span>
					<p
						class="card-field-value"
						data-editable="text"
						data-field="location"
						data-id={typed.id}
						data-endpoint="/api/projects"
						data-value={typed.location ?? ''}
					>
						{typed.location || 'Not set.'}
					</p>
				</div>

				<div class="card-field">
					<span class="card-field-label">Team size</span>
					<p
						class="card-field-value"
						data-editable="number"
						data-field="team_size"
						data-id={typed.id}
						data-endpoint="/api/projects"
						data-value={typed.team_size ?? ''}
					>
						{typed.team_size ?? 'Not set.'}
					</p>
				</div>

				<div class="card-field">
					<span class="card-field-label">Industry</span>
					<p
						class="card-field-value"
						data-editable="text"
						data-field="industry"
						data-id={typed.id}
						data-endpoint="/api/projects"
						data-value={typed.industry ?? ''}
					>
						{typed.industry || 'Not set.'}
					</p>
				</div>

				<div class="card-field">
					<span class="card-field-label">Founded</span>
					<p
						class="card-field-value"
						data-editable="number"
						data-field="founded_year"
						data-id={typed.id}
						data-endpoint="/api/projects"
						data-value={typed.founded_year ?? ''}
					>
						{typed.founded_year ?? 'Not set.'}
					</p>
				</div>

				<div class="card-field">
					<span class="card-field-label">Stage</span>
					<div
						class="inline-block self-start cursor-pointer"
						data-editable="select"
						data-field="funding_stage"
						data-id={typed.id}
						data-endpoint="/api/projects"
						data-value={typed.funding_stage ?? ''}
						data-options={fundingStageOptions}
					>
						{typed.funding_stage ? (
							<span class={`pill pill-${typed.funding_stage}`}>{FUNDING_STAGE_LABELS[typed.funding_stage]}</span>
						) : (
							<span class="pill pill-empty">Pick stage</span>
						)}
					</div>
				</div>
			</div>
		</div>

		<div class="section mt-14">
			<div class="section-head flex justify-between gap-3 flex-wrap items-start md:items-center">
				<h2 class="m-0 mb-5 font-serif text-[22px] font-semibold">Open points</h2>
				<div class="section-head-actions flex items-center gap-3">
					{typedOpenPoints.length > 0 && (
						<span class="progress-count text-[13px] text-muted tabular-nums">{doneCount}/{typedOpenPoints.length} closed</span>
					)}
					<a class="btn ghost small" href="/opl">Open the OPL →</a>
				</div>
			</div>

			{typedOpenPoints.length > 0 && (
				<div class="progress-bar h-1.5 bg-canvas border border-line rounded-full overflow-hidden mb-5">
					<div class="progress-bar-fill" style={`width: ${(doneCount / typedOpenPoints.length) * 100}%`} />
				</div>
			)}

			<div class="table-wrap">
				<table class="data-table">
					<thead>
						<tr>
							<th>Status</th>
							<th>Item</th>
							<th>Contributors</th>
							<th>Added</th>
						</tr>
					</thead>
					<tbody>
						{typedOpenPoints.length ? (
							typedOpenPoints.map((point) => (
								<tr>
									<td class="px-4 py-2.5">
										<span class={`pill pill-${point.status}`}>{OPEN_POINT_STATUS_LABELS[point.status]}</span>
									</td>
									<td class={`px-4 py-2.5 ${point.status === 'closed' ? 'text-muted line-through' : ''}`}>
										{point.title || 'Untitled'}
									</td>
									<td class="px-4 py-2.5 text-muted">{point.contributors || '—'}</td>
									<td class="cell-date px-4 py-2.5">{new Date(point.created_at).toLocaleDateString()}</td>
								</tr>
							))
						) : (
							<tr>
								<td colspan="4" class="py-7 px-4">
									No open points linked to this project yet. Add one on the <a href="/opl">OPL</a> and link it here.
								</td>
							</tr>
						)}
					</tbody>
				</table>
			</div>
		</div>

		<div class="section mt-14">
			<div class="section-head flex justify-between gap-3 flex-wrap items-start md:items-center">
				<h2 class="m-0 mb-5 font-serif text-[22px] font-semibold">Timeline</h2>
				<button type="button" class="btn ghost small" data-open-popup="new-log">+ Log progress</button>
			</div>

			<div class="signals flex items-center flex-wrap gap-2.5 mb-5">
				<span class="signals-headline text-sm font-medium">{headlineSignalCount} validation signal{headlineSignalCount === 1 ? '' : 's'}</span>
				{(Object.keys(signalCounts) as SignalType[])
					.filter((type) => type !== 'progress' && signalCounts[type])
					.map((type) => (
						<span class="signals-breakdown py-[3px] px-2.5 rounded-full bg-canvas border border-line text-xs text-muted">{signalCounts[type]} {signalLabel[type]}</span>
					))}
			</div>

			<div class="timeline flex flex-col">
				{typedLogs.length ? (
					typedLogs.map((log) => (
						<div class="timeline-entry flex gap-[18px]">
							<div class="timeline-marker flex flex-col items-center shrink-0 w-3">
								<span class={`timeline-dot w-3 h-3 rounded-full border-2 border-paper mt-1.5 shadow-[0_0_0_1px_var(--line)] ${timelineDotClass[log.status] ?? 'bg-muted'}`} />
								<span class="timeline-line flex-1 w-px bg-line mt-1" />
							</div>
							<div class="timeline-content flex-1 pb-7">
								<div class="timeline-head flex items-center justify-between gap-3">
									<span class="log-date text-[13px] text-muted tabular-nums">{new Date(log.created_at).toLocaleString()}</span>
									<span class={`proof-pill px-2.5 py-[3px] rounded-full text-[11px] font-medium ${proofPillClass[log.status]}`}>{proofStatusLabel[log.status]}</span>
								</div>
								<p class="log-note mt-2 mb-0 text-[15px] leading-relaxed">{log.note}</p>
								{log.proof_type === 'link' && log.proof_url && (
									<a class="log-proof inline-block mt-2.5 text-sm text-ink no-underline border-b border-line hover:border-ink" href={log.proof_url} target="_blank" rel="noopener noreferrer">
										View proof link →
									</a>
								)}
								{log.proof_type === 'image' && log.proof_url && (
									<img class="log-proof-image block mt-3 max-w-full rounded-[10px] border border-line" src={log.proof_url} alt="Proof" />
								)}
							</div>
						</div>
					))
				) : (
					<p class="empty p-0 border-none text-left text-muted text-[15px]">No progress logged yet.</p>
				)}
			</div>
		</div>
	</section>

	<dialog id="new-log" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Log progress</h2>
		<form method="post" action={`/api/projects/${typed.id}/logs`} enctype="multipart/form-data">
			<label for="note">Note</label>
			<textarea id="note" name="note" rows="3" required></textarea>

			<label for="signal_type">Signal</label>
			<select id="signal_type" name="signal_type">
				<option value="progress">Just progress — no external signal</option>
				<option value="customer_contact">Talked to a prospect</option>
				<option value="interest_expressed">Someone expressed interest</option>
				<option value="paid">Someone paid</option>
				<option value="rejected">Got a rejection</option>
			</select>

			<label for="proof_type">Proof</label>
			<select id="proof_type" name="proof_type" data-proof-select>
				<option value="text">Text only</option>
				<option value="link">Link</option>
				<option value="image">Image</option>
			</select>

			<div class="proof-field" data-proof-field="link" hidden>
				<label for="proof_link">Proof URL</label>
				<input id="proof_link" name="proof_link" type="url" placeholder="https://" />
			</div>

			<div class="proof-field" data-proof-field="image" hidden>
				<label for="proof_file">Proof image</label>
				<input id="proof_file" name="proof_file" type="file" accept="image/*" />
			</div>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Log progress</button>
			</div>
		</form>
	</dialog>
</Layout>

<script>
	const select = document.querySelector('[data-proof-select]') as HTMLSelectElement | null;
	const fields = document.querySelectorAll<HTMLElement>('[data-proof-field]');

	const sync = () => {
		const value = select?.value ?? 'text';
		fields.forEach((field) => {
			field.hidden = field.dataset.proofField !== value;
		});
	};

	select?.addEventListener('change', sync);
	sync();
</script>

<style>
	/* Timeline connector: hides the trailing vertical line after the last
	   entry. Kept as scoped CSS -- there's no clean utility-only way to
	   express ":last-child, then target a specific descendant" here. */
	.timeline-entry:last-child .timeline-line {
		display: none;
	}

	/* Tagline: an inline-edit field like .pain-title/.pain-text, but
	   presented as plain hero text rather than a boxed input -- only gets a
	   background/border once hovered or actively being edited. */
	.tagline {
		color: var(--muted);
	}

	.tagline[data-value]:not([data-value='']) {
		color: var(--ink);
	}

	.tagline:hover {
		background: var(--canvas);
	}

	.tagline.editing {
		background: var(--paper);
		border: 1px solid var(--ink);
	}
</style>
