---
import Layout from '../../layouts/Layout.astro';
import { selectOptions } from '../../lib/select-options';
import { requireUser, type Project } from '../../lib/projects';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: projects } = await supabase
	.from('projects')
	.select('*')
	.order('created_at', { ascending: false });

const typedProjects = (projects ?? []) as Project[];

const statusLabel: Record<string, string> = {
	not_started: 'Not started',
	active: 'Active',
	done: 'Done',
};

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="projects max-w-[1040px]">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Projects.</h1>
				<p class="lede">Things you've set out to accomplish, and the trail of proof behind them.</p>
			</div>
			<button type="button" class="btn" data-open-popup="new-project">+ New project</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="card-grid">
			{typedProjects.length ? (
				typedProjects.map((project) => (
					<article class="card">
						<div class="card-head">
							<a class="card-title" href={`/projects/${project.id}`}>{project.title}</a>
							<form method="post" action={`/api/projects/${project.id}/delete`} class="project-delete-form m-0 shrink-0">
								<button type="submit" class="card-delete" aria-label="Delete project">×</button>
							</form>
						</div>

						<div class="card-field min-w-0">
							<span class="card-field-label">Description</span>
							<p
								class="card-field-value"
								data-editable="textarea"
								data-field="description"
								data-id={project.id}
								data-endpoint="/api/projects"
								data-value={project.description ?? ''}
							>
								{project.description || 'Not set.'}
							</p>
						</div>

						<div class="project-dates grid grid-cols-2 gap-3">
							<div class="card-field min-w-0">
								<span class="card-field-label">Start</span>
								<p
									class="card-field-value tabular-nums"
									data-editable="date"
									data-field="start_date"
									data-id={project.id}
									data-endpoint="/api/projects"
									data-value={project.start_date ?? ''}
								>
									{project.start_date || 'Not set.'}
								</p>
							</div>
							<div class="card-field min-w-0">
								<span class="card-field-label">Target end</span>
								<p
									class="card-field-value tabular-nums"
									data-editable="date"
									data-field="target_end_date"
									data-id={project.id}
									data-endpoint="/api/projects"
									data-value={project.target_end_date ?? ''}
								>
									{project.target_end_date || 'Not set.'}
								</p>
							</div>
						</div>

						<div class="card-foot">
							<span
								class="project-status cursor-pointer"
								data-editable="select"
								data-field="status"
								data-id={project.id}
								data-endpoint="/api/projects"
								data-value={project.status}
								data-options={selectOptions([["not_started","Not started"],["active","Active"],["done","Done"]])}
							>
								<span class={`pill pill-${project.status}`}>{statusLabel[project.status]}</span>
							</span>
							<span class="card-date">{new Date(project.created_at).toLocaleDateString()}</span>
						</div>
					</article>
				))
			) : (
				<p class="empty">No projects yet. Create your first one.</p>
			)}
		</div>
	</section>

	<dialog id="new-project" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>New project</h2>
		<form method="post" action="/api/projects/create">
			<label for="title">Title</label>
			<input id="title" name="title" type="text" required maxlength="120" />

			<label for="description">Description</label>
			<textarea id="description" name="description" rows="3"></textarea>

			<div class="popup-row">
				<div>
					<label for="start_date">Start date</label>
					<input id="start_date" name="start_date" type="date" />
				</div>
				<div>
					<label for="target_end_date">Target end date</label>
					<input id="target_end_date" name="target_end_date" type="date" />
				</div>
			</div>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Create project</button>
			</div>
		</form>
	</dialog>
</Layout>
