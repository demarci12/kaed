---
import Layout from '../../layouts/Layout.astro';
import { requireUser, type Project } from '../../lib/projects';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: projects } = await supabase
	.from('projects')
	.select('*')
	.order('created_at', { ascending: false });

const typedProjects = (projects ?? []) as Project[];

const statusLabel: Record<string, string> = {
	not_started: 'Not started',
	active: 'Active',
	done: 'Done',
};

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="projects">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Projects.</h1>
				<p class="lede">Things you've set out to accomplish, and the trail of proof behind them.</p>
			</div>
			<button type="button" class="btn" data-open-popup="new-project">+ New project</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="projects-grid">
			{typedProjects.length ? (
				typedProjects.map((project) => (
					<article class="project-card">
						<div class="project-card-head">
							<a class="project-title" href={`/projects/${project.id}`}>{project.title}</a>
							<form method="post" action={`/api/projects/${project.id}/delete`} class="project-delete-form">
								<button type="submit" class="project-delete" aria-label="Delete project">×</button>
							</form>
						</div>

						<div class="project-field">
							<span class="project-field-label">Description</span>
							<p
								class="project-field-value"
								data-editable="textarea"
								data-field="description"
								data-id={project.id}
								data-endpoint="/api/projects"
								data-value={project.description ?? ''}
							>
								{project.description || 'Not set.'}
							</p>
						</div>

						<div class="project-dates">
							<div class="project-field">
								<span class="project-field-label">Start</span>
								<p
									class="project-field-value"
									data-editable="date"
									data-field="start_date"
									data-id={project.id}
									data-endpoint="/api/projects"
									data-value={project.start_date ?? ''}
								>
									{project.start_date || 'Not set.'}
								</p>
							</div>
							<div class="project-field">
								<span class="project-field-label">Target end</span>
								<p
									class="project-field-value"
									data-editable="date"
									data-field="target_end_date"
									data-id={project.id}
									data-endpoint="/api/projects"
									data-value={project.target_end_date ?? ''}
								>
									{project.target_end_date || 'Not set.'}
								</p>
							</div>
						</div>

						<div class="project-card-foot">
							<span
								class="project-status"
								data-editable="select"
								data-field="status"
								data-id={project.id}
								data-endpoint="/api/projects"
								data-value={project.status}
								data-options="not_started:Not started,active:Active,done:Done"
							>
								<span class={`pill pill-${project.status}`}>{statusLabel[project.status]}</span>
							</span>
							<span class="project-date">{new Date(project.created_at).toLocaleDateString()}</span>
						</div>
					</article>
				))
			) : (
				<p class="empty">No projects yet. Create your first one.</p>
			)}
		</div>
	</section>

	<dialog id="new-project" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>New project</h2>
		<form method="post" action="/api/projects/create">
			<label for="title">Title</label>
			<input id="title" name="title" type="text" required maxlength="120" />

			<label for="description">Description</label>
			<textarea id="description" name="description" rows="3"></textarea>

			<div class="popup-row">
				<div>
					<label for="start_date">Start date</label>
					<input id="start_date" name="start_date" type="date" />
				</div>
				<div>
					<label for="target_end_date">Target end date</label>
					<input id="target_end_date" name="target_end_date" type="date" />
				</div>
			</div>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Create project</button>
			</div>
		</form>
	</dialog>
</Layout>

<style>
	.projects {
		max-width: 1040px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	/* Cards, not a table: description and dates were all truncated to an
	   ellipsis in a six-column row. A card shows every field in full. */
	.projects-grid {
		margin-top: 40px;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 18px;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 22px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.project-card-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
	}

	.project-title {
		font-family: var(--serif);
		font-size: 19px;
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink);
		text-decoration: none;
	}

	.project-title:hover {
		text-decoration: underline;
	}

	.project-delete-form {
		margin: 0;
		flex-shrink: 0;
	}

	.project-delete {
		width: 26px;
		height: 26px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		font-size: 16px;
		line-height: 1;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.project-delete:hover {
		border-color: #e7c3c1;
		color: #b4231f;
	}

	.project-field {
		display: flex;
		flex-direction: column;
		gap: 5px;
		min-width: 0;
	}

	.project-field-label {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.project-field-value {
		margin: 0;
		padding: 8px 10px;
		border: 1px solid transparent;
		border-radius: 8px;
		font-size: 14px;
		line-height: 1.6;
		color: var(--ink);
		white-space: pre-wrap;
		cursor: text;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.project-field-value:hover {
		border-color: var(--line);
		background: var(--canvas);
	}

	.project-field-value[data-value=''] {
		color: var(--muted);
	}

	.project-dates {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}

	.project-dates .project-field-value {
		font-variant-numeric: tabular-nums;
	}

	.project-card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: auto;
		padding-top: 14px;
		border-top: 1px solid var(--line);
	}

	.project-status {
		cursor: pointer;
	}

	.project-date {
		font-size: 12px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.empty {
		/* Span the whole grid rather than sitting in one narrow column. */
		grid-column: 1 / -1;
		margin: 0;
		padding: 32px 16px;
		text-align: center;
		color: var(--muted);
		border: 1px dashed var(--line);
		border-radius: 14px;
	}

	@media (max-width: 720px) {
		.page-head {
			flex-direction: column;
			align-items: stretch;
		}

		.page-head .btn {
			align-self: flex-start;
		}

		.projects-grid {
			grid-template-columns: 1fr;
			margin-top: 28px;
		}

		.project-card {
			padding: 18px;
		}
	}
</style>
