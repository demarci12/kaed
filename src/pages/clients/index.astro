---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/auth';
import type { Client, ClientStage } from '../../lib/clients';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: clients } = await supabase
	.from('clients')
	.select('*')
	.order('created_at', { ascending: false });

const typedClients = (clients ?? []) as Client[];

const stageLabel: Record<ClientStage, string> = {
	lead: 'Lead',
	contacted: 'Contacted',
	negotiating: 'Negotiating',
	won: 'Won',
	lost: 'Lost',
};

const error = Astro.url.searchParams.get('error');
---

<Layout>
	<section class="clients">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Clients.</h1>
				<p class="lede">A lightweight pipeline for people you're talking to.</p>
			</div>
			<button type="button" class="btn" data-open-dialog="new-client">+ New client</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="table-wrap">
			<table class="data-table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Company</th>
						<th>Email</th>
						<th>Phone</th>
						<th>Stage</th>
						<th>Next follow-up</th>
						<th>Added</th>
					</tr>
				</thead>
				<tbody>
					{typedClients.length ? (
						typedClients.map((client) => (
							<tr>
								<td class="cell-title">
									<a href={`/clients/${client.id}`}>{client.name}</a>
								</td>
								<td class="cell-muted">{client.company ?? '—'}</td>
								<td class="cell-muted">{client.email ?? '—'}</td>
								<td class="cell-muted">{client.phone ?? '—'}</td>
								<td><span class={`pill pill-${client.stage}`}>{stageLabel[client.stage]}</span></td>
								<td class="cell-date">{client.next_follow_up ?? '—'}</td>
								<td class="cell-date">{new Date(client.created_at).toLocaleDateString()}</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="7" class="empty-cell">No clients yet. Add your first one.</td>
						</tr>
					)}
				</tbody>
			</table>
		</div>
	</section>

	<dialog id="new-client" class="popup">
		<div class="popup-inner">
			<h2>New client</h2>
			<form method="post" action="/api/clients/create">
				<label for="name">Name</label>
				<input id="name" name="name" type="text" required maxlength="160" />

				<label for="company">Company</label>
				<input id="company" name="company" type="text" maxlength="160" />

				<div class="popup-row">
					<div>
						<label for="email">Email</label>
						<input id="email" name="email" type="email" />
					</div>
					<div>
						<label for="phone">Phone</label>
						<input id="phone" name="phone" type="tel" />
					</div>
				</div>

				<div class="popup-row">
					<div>
						<label for="stage">Stage</label>
						<select id="stage" name="stage">
							<option value="lead">Lead</option>
							<option value="contacted">Contacted</option>
							<option value="negotiating">Negotiating</option>
							<option value="won">Won</option>
							<option value="lost">Lost</option>
						</select>
					</div>
					<div>
						<label for="next_follow_up">Next follow-up</label>
						<input id="next_follow_up" name="next_follow_up" type="date" />
					</div>
				</div>

				<div class="popup-actions">
					<button type="button" class="btn ghost" data-close-dialog>Cancel</button>
					<button type="submit" class="btn">Add client</button>
				</div>
			</form>
		</div>
	</dialog>
</Layout>

<style>
	.clients {
		max-width: 1120px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.table-wrap {
		margin-top: 40px;
		overflow-x: auto;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}

	.data-table th {
		text-align: left;
		padding: 12px 16px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		background: var(--canvas);
		white-space: nowrap;
	}

	.data-table td {
		padding: 12px 16px;
		border-bottom: 1px solid var(--line);
		vertical-align: middle;
		white-space: nowrap;
	}

	.data-table tr:last-child td {
		border-bottom: none;
	}

	.cell-title a {
		color: var(--ink);
		text-decoration: none;
		font-weight: 500;
	}

	.cell-title a:hover {
		text-decoration: underline;
	}

	.cell-muted {
		color: var(--muted);
	}

	.cell-date {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.empty-cell {
		padding: 32px 16px;
		text-align: center;
		color: var(--muted);
		white-space: normal;
	}

	.pill {
		flex-shrink: 0;
		padding: 4px 12px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 500;
		white-space: nowrap;
	}

	.pill-lead {
		background: var(--canvas);
		color: var(--muted);
		border: 1px solid var(--line);
	}

	.pill-contacted {
		background: #eef4ff;
		color: #1d4ed8;
	}

	.pill-negotiating {
		background: #fff7e6;
		color: #92620a;
	}

	.pill-won {
		background: #eafaf0;
		color: #1f7a3d;
	}

	.pill-lost {
		background: #fbf0ef;
		color: #b4231f;
	}

	@media (max-width: 720px) {
		.page-head {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
