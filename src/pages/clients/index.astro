---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/auth';
import type { Client, ClientStage } from '../../lib/clients';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: clients } = await supabase
	.from('clients')
	.select('*')
	.order('created_at', { ascending: false });

const typedClients = (clients ?? []) as Client[];

const stageLabel: Record<ClientStage, string> = {
	lead: 'Lead',
	contacted: 'Contacted',
	negotiating: 'Negotiating',
	won: 'Won',
	lost: 'Lost',
};

const stageOrder: ClientStage[] = ['lead', 'contacted', 'negotiating', 'won', 'lost'];

const error = Astro.url.searchParams.get('error');
---

<Layout>
	<section class="clients">
		<p class="eyebrow">Personal</p>
		<h1>Clients.</h1>
		<p class="lede">A lightweight pipeline for people you're talking to.</p>

		{error && <p class="form-error">{error}</p>}

		<div class="list">
			{typedClients.length ? (
				stageOrder.map((stage) => {
					const inStage = typedClients.filter((c) => c.stage === stage);
					return inStage.length > 0 ? (
						<div class="stage-group">
							<h2 class="stage-heading">
								{stageLabel[stage]} <span class="stage-count">{inStage.length}</span>
							</h2>
							<div class="stage-list">
								{inStage.map((client) => (
									<a class="card" href={`/clients/${client.id}`}>
										<div class="card-head">
											<h3>{client.name}</h3>
											{client.next_follow_up && (
												<span class="follow-up">Follow up {client.next_follow_up}</span>
											)}
										</div>
										{client.company && <p class="card-company">{client.company}</p>}
										{(client.email || client.phone) && (
											<p class="card-contact">
												{[client.email, client.phone].filter(Boolean).join(' · ')}
											</p>
										)}
									</a>
								))}
							</div>
						</div>
					) : null;
				})
			) : (
				<p class="empty">No clients yet. Add your first one below.</p>
			)}
		</div>

		<details class="dropup">
			<summary class="dropup-trigger">+ New client</summary>
			<div class="dropup-panel">
				<form method="post" action="/api/clients/create" class="client-form">
					<label for="name">Name</label>
					<input id="name" name="name" type="text" required maxlength="160" />

					<label for="company">Company</label>
					<input id="company" name="company" type="text" maxlength="160" />

					<div class="row">
						<div>
							<label for="email">Email</label>
							<input id="email" name="email" type="email" />
						</div>
						<div>
							<label for="phone">Phone</label>
							<input id="phone" name="phone" type="tel" />
						</div>
					</div>

					<div class="row">
						<div>
							<label for="stage">Stage</label>
							<select id="stage" name="stage">
								<option value="lead">Lead</option>
								<option value="contacted">Contacted</option>
								<option value="negotiating">Negotiating</option>
								<option value="won">Won</option>
								<option value="lost">Lost</option>
							</select>
						</div>
						<div>
							<label for="next_follow_up">Next follow-up</label>
							<input id="next_follow_up" name="next_follow_up" type="date" />
						</div>
					</div>

					<button type="submit" class="btn">Add client</button>
				</form>
			</div>
		</details>
	</section>
</Layout>

<style>
	.clients {
		max-width: 760px;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.empty {
		color: var(--muted);
		font-size: 15px;
		margin-top: 40px;
	}

	.list {
		margin-top: 40px;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.stage-heading {
		margin: 0 0 14px;
		font-family: var(--serif);
		font-size: 16px;
		font-weight: 600;
		display: flex;
		align-items: baseline;
		gap: 8px;
	}

	.stage-count {
		font-family: var(--sans);
		font-size: 12px;
		font-weight: 500;
		color: var(--muted);
	}

	.stage-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.card {
		display: block;
		padding: 16px 20px;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 12px;
		text-decoration: none;
		color: var(--ink);
		transition: border-color 0.15s ease;
	}

	.card:hover {
		border-color: var(--ink);
	}

	.card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.card-head h3 {
		margin: 0;
		font-family: var(--serif);
		font-size: 16px;
		font-weight: 600;
	}

	.follow-up {
		flex-shrink: 0;
		font-size: 12px;
		color: var(--muted);
		white-space: nowrap;
	}

	.card-company,
	.card-contact {
		margin: 6px 0 0;
		font-size: 13px;
		color: var(--muted);
	}

	.dropup {
		margin-top: 40px;
	}

	.dropup-trigger {
		display: inline-flex;
		align-items: center;
		height: 44px;
		padding: 0 22px;
		font-family: var(--sans);
		font-size: 15px;
		font-weight: 500;
		color: var(--ink);
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 999px;
		cursor: pointer;
		list-style: none;
		transition: border-color 0.15s ease;
	}

	.dropup-trigger::-webkit-details-marker {
		display: none;
	}

	.dropup-trigger:hover {
		border-color: var(--ink);
	}

	.dropup[open] .dropup-trigger {
		border-color: var(--ink);
	}

	.dropup-panel {
		margin-top: 16px;
		padding: 32px;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 16px;
		animation: dropup-in 0.15s ease;
	}

	@keyframes dropup-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.client-form {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.client-form label {
		margin-top: 14px;
		font-size: 13px;
		font-weight: 500;
		color: var(--muted);
	}

	.client-form input,
	.client-form select {
		height: 44px;
		padding: 0 14px;
		font-family: var(--sans);
		font-size: 15px;
		color: var(--ink);
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 10px;
		outline: none;
	}

	.client-form input:focus,
	.client-form select:focus {
		border-color: var(--ink);
	}

	.row {
		display: flex;
		gap: 16px;
	}

	.row > div {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		margin-top: 24px;
		height: 44px;
		padding: 0 22px;
		font-family: var(--sans);
		font-size: 15px;
		font-weight: 500;
		color: #fff;
		background: var(--ink);
		border: 1px solid var(--ink);
		border-radius: 999px;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.btn:hover {
		background: transparent;
		color: var(--ink);
	}
</style>
