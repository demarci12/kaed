---
import Layout from '../../layouts/Layout.astro';
import { selectOptions } from '../../lib/select-options';
import { requireOwner } from '../../lib/auth';
import type { Client, ClientStage } from '../../lib/clients';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: clients } = await supabase
	.from('clients')
	.select('*')
	.order('created_at', { ascending: false });

const typedClients = (clients ?? []) as Client[];

const stageLabel: Record<ClientStage, string> = {
	lead: 'Lead',
	contacted: 'Contacted',
	negotiating: 'Negotiating',
	won: 'Won',
	lost: 'Lost',
};

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="clients max-w-[1120px]">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Clients.</h1>
				<p class="lede">A lightweight pipeline for people you're talking to.</p>
			</div>
			<button type="button" class="btn" data-open-popup="new-client">+ New client</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="table-wrap mt-10">
			<table class="data-table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Company</th>
						<th>Email</th>
						<th>Phone</th>
						<th>Stage</th>
						<th>Next follow-up</th>
						<th>Added</th>
					</tr>
				</thead>
				<tbody>
					{typedClients.length ? (
						typedClients.map((client) => (
							<tr class="[&>td]:whitespace-nowrap">
								<td class="cell-title">
									<a class="text-ink no-underline font-medium hover:underline" href={`/clients/${client.id}`}>{client.name}</a>
								</td>
								<td
									class="cell-muted"
									data-editable="text"
									data-field="company"
									data-id={client.id}
									data-endpoint="/api/clients"
									data-value={client.company ?? ''}
								>
									{client.company ?? '—'}
								</td>
								<td
									class="cell-muted"
									data-editable="text"
									data-field="email"
									data-id={client.id}
									data-endpoint="/api/clients"
									data-value={client.email ?? ''}
								>
									{client.email ?? '—'}
								</td>
								<td
									class="cell-muted"
									data-editable="text"
									data-field="phone"
									data-id={client.id}
									data-endpoint="/api/clients"
									data-value={client.phone ?? ''}
								>
									{client.phone ?? '—'}
								</td>
								<td
									data-editable="select"
									data-field="stage"
									data-id={client.id}
									data-endpoint="/api/clients"
									data-value={client.stage}
									data-options={selectOptions([["lead","Lead"],["contacted","Contacted"],["negotiating","Negotiating"],["won","Won"],["lost","Lost"]])}
								>
									<span class={`pill pill-${client.stage}`}>{stageLabel[client.stage]}</span>
								</td>
								<td
									class="cell-date"
									data-editable="date"
									data-field="next_follow_up"
									data-id={client.id}
									data-endpoint="/api/clients"
									data-value={client.next_follow_up ?? ''}
								>
									{client.next_follow_up ?? '—'}
								</td>
								<td class="cell-date">{new Date(client.created_at).toLocaleDateString()}</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="7" class="empty-cell whitespace-normal">No clients yet. Add your first one.</td>
						</tr>
					)}
				</tbody>
			</table>
		</div>
	</section>

	<dialog id="new-client" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>New client</h2>
		<form method="post" action="/api/clients/create">
			<label for="name">Name</label>
			<input id="name" name="name" type="text" required maxlength="160" />

			<label for="company">Company</label>
			<input id="company" name="company" type="text" maxlength="160" />

			<div class="popup-row">
				<div>
					<label for="email">Email</label>
					<input id="email" name="email" type="email" />
				</div>
				<div>
					<label for="phone">Phone</label>
					<input id="phone" name="phone" type="tel" />
				</div>
			</div>

			<div class="popup-row">
				<div>
					<label for="stage">Stage</label>
					<select id="stage" name="stage">
						<option value="lead">Lead</option>
						<option value="contacted">Contacted</option>
						<option value="negotiating">Negotiating</option>
						<option value="won">Won</option>
						<option value="lost">Lost</option>
					</select>
				</div>
				<div>
					<label for="next_follow_up">Next follow-up</label>
					<input id="next_follow_up" name="next_follow_up" type="date" />
				</div>
			</div>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Add client</button>
			</div>
		</form>
	</dialog>
</Layout>

