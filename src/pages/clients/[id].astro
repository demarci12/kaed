---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import type { Client, ClientNote, ClientStage } from '../../lib/clients';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { id } = Astro.params;

const { data: client } = await supabase.from('clients').select('*').eq('id', id).maybeSingle();

if (!client) {
	return Astro.redirect('/clients');
}

const { data: notes } = await supabase
	.from('client_notes')
	.select('*')
	.eq('client_id', id)
	.order('created_at', { ascending: false });

const typed = client as Client;
const typedNotes = (notes ?? []) as ClientNote[];

const stageLabel: Record<ClientStage, string> = {
	lead: 'Lead',
	contacted: 'Contacted',
	negotiating: 'Negotiating',
	won: 'Won',
	lost: 'Lost',
};

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="detail max-w-[720px]">
		<a class="back" href="/clients">← Clients</a>

		<div class="head flex items-center gap-3.5 flex-wrap">
			<h1>{typed.name}</h1>
			<span class={`pill pill-${typed.stage}`}>{stageLabel[typed.stage]}</span>
		</div>

		{typed.company && <p class="lede">{typed.company}</p>}

		{(typed.email || typed.phone) && (
			<p class="contact mt-2 mb-0 text-sm text-muted">{[typed.email, typed.phone].filter(Boolean).join(' · ')}</p>
		)}

		{error && <p class="form-error">{error}</p>}

		<form method="post" action={`/api/clients/${typed.id}/update`} class="update-form flex items-end gap-3.5 mt-8 flex-wrap items-stretch md:items-end">
			<div class="flex flex-col gap-1.5 flex-1 basis-40 md:flex-initial">
				<label for="stage" class="text-[13px] text-muted">Stage</label>
				<select id="stage" name="stage" class="h-10 px-3 font-sans text-base bg-canvas border border-line rounded-full outline-none w-full md:w-auto">
					<option value="lead" selected={typed.stage === 'lead'}>Lead</option>
					<option value="contacted" selected={typed.stage === 'contacted'}>Contacted</option>
					<option value="negotiating" selected={typed.stage === 'negotiating'}>Negotiating</option>
					<option value="won" selected={typed.stage === 'won'}>Won</option>
					<option value="lost" selected={typed.stage === 'lost'}>Lost</option>
				</select>
			</div>
			<div class="flex flex-col gap-1.5 flex-1 basis-40 md:flex-initial">
				<label for="next_follow_up" class="text-[13px] text-muted">Next follow-up</label>
				<input id="next_follow_up" name="next_follow_up" type="date" value={typed.next_follow_up ?? ''} class="h-10 px-3 font-sans text-base bg-canvas border border-line rounded-full outline-none w-full md:w-auto" />
			</div>
			<button type="submit" class="btn ghost w-full md:w-auto justify-center">Update</button>
		</form>

		<div class="section mt-14">
			<div class="section-head flex items-center justify-between gap-3 flex-wrap">
				<h2 class="m-0 mb-5 font-serif text-[22px] font-semibold">Notes</h2>
				<button type="button" class="btn ghost small" data-open-popup="new-note">+ Add note</button>
			</div>

			<div class="timeline flex flex-col">
				{typedNotes.length ? (
					typedNotes.map((note) => (
						<div class="timeline-entry flex gap-3 md:gap-[18px]">
							<div class="timeline-marker flex flex-col items-center shrink-0 w-3">
								<span class="timeline-dot w-3 h-3 rounded-full bg-ink border-2 border-paper shadow-[0_0_0_1px_var(--line)] mt-1.5" />
								<span class="timeline-line flex-1 w-px bg-line mt-1" />
							</div>
							<div class="timeline-content flex-1 pb-7">
								<span class="note-date text-[13px] text-muted tabular-nums">{new Date(note.created_at).toLocaleString()}</span>
								<p class="note-text mt-2 mb-0 text-[15px] leading-relaxed">{note.note}</p>
							</div>
						</div>
					))
				) : (
					<p class="empty">No notes yet.</p>
				)}
			</div>
		</div>
	</section>

	<dialog id="new-note" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Add note</h2>
		<form method="post" action={`/api/clients/${typed.id}/notes`}>
			<textarea name="note" rows="3" placeholder="What happened?" required></textarea>
			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Add note</button>
			</div>
		</form>
	</dialog>
</Layout>

<style>
	/* Timeline connector: hides the trailing vertical line after the last
	   entry. Kept as scoped CSS -- there's no clean utility-only way to
	   express ":last-child, then target a specific descendant" here. */
	.timeline-entry:last-child .timeline-line {
		display: none;
	}
</style>
