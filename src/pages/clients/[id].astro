---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import type { Client, ClientNote, ClientStage } from '../../lib/clients';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { id } = Astro.params;

const { data: client } = await supabase.from('clients').select('*').eq('id', id).maybeSingle();

if (!client) {
	return Astro.redirect('/clients');
}

const { data: notes } = await supabase
	.from('client_notes')
	.select('*')
	.eq('client_id', id)
	.order('created_at', { ascending: false });

const typed = client as Client;
const typedNotes = (notes ?? []) as ClientNote[];

const stageLabel: Record<ClientStage, string> = {
	lead: 'Lead',
	contacted: 'Contacted',
	negotiating: 'Negotiating',
	won: 'Won',
	lost: 'Lost',
};

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="detail">
		<a class="back" href="/clients">← Clients</a>

		<div class="head">
			<h1>{typed.name}</h1>
			<span class={`pill pill-${typed.stage}`}>{stageLabel[typed.stage]}</span>
		</div>

		{typed.company && <p class="lede">{typed.company}</p>}

		{(typed.email || typed.phone) && (
			<p class="contact">{[typed.email, typed.phone].filter(Boolean).join(' · ')}</p>
		)}

		{error && <p class="form-error">{error}</p>}

		<form method="post" action={`/api/clients/${typed.id}/update`} class="update-form">
			<div>
				<label for="stage">Stage</label>
				<select id="stage" name="stage">
					<option value="lead" selected={typed.stage === 'lead'}>Lead</option>
					<option value="contacted" selected={typed.stage === 'contacted'}>Contacted</option>
					<option value="negotiating" selected={typed.stage === 'negotiating'}>Negotiating</option>
					<option value="won" selected={typed.stage === 'won'}>Won</option>
					<option value="lost" selected={typed.stage === 'lost'}>Lost</option>
				</select>
			</div>
			<div>
				<label for="next_follow_up">Next follow-up</label>
				<input id="next_follow_up" name="next_follow_up" type="date" value={typed.next_follow_up ?? ''} />
			</div>
			<button type="submit" class="btn ghost">Update</button>
		</form>

		<div class="section">
			<div class="section-head">
				<h2>Notes</h2>
				<button type="button" class="btn ghost small" data-open-popup="new-note">+ Add note</button>
			</div>

			<div class="timeline">
				{typedNotes.length ? (
					typedNotes.map((note) => (
						<div class="timeline-entry">
							<div class="timeline-marker">
								<span class="timeline-dot" />
								<span class="timeline-line" />
							</div>
							<div class="timeline-content">
								<span class="note-date">{new Date(note.created_at).toLocaleString()}</span>
								<p class="note-text">{note.note}</p>
							</div>
						</div>
					))
				) : (
					<p class="empty">No notes yet.</p>
				)}
			</div>
		</div>
	</section>

	<dialog id="new-note" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Add note</h2>
		<form method="post" action={`/api/clients/${typed.id}/notes`}>
			<textarea name="note" rows="3" placeholder="What happened?" required></textarea>
			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Add note</button>
			</div>
		</form>
	</dialog>
</Layout>

<style>
	.detail {
		max-width: 720px;
	}

	.head {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}

	.contact {
		margin: 8px 0 0;
		font-size: 14px;
		color: var(--muted);
	}

	.update-form {
		display: flex;
		align-items: flex-end;
		gap: 14px;
		margin-top: 32px;
		flex-wrap: wrap;
	}

	.update-form > div {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.update-form label {
		font-size: 13px;
		color: var(--muted);
	}

	.update-form select,
	.update-form input {
		height: 40px;
		padding: 0 12px;
		font-family: var(--sans);
		font-size: 16px;
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 999px;
		outline: none;
	}

	.section {
		margin-top: 56px;
	}

	.section-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
	}

	.section h2 {
		margin: 0 0 20px;
		font-family: var(--serif);
		font-size: 22px;
		font-weight: 600;
	}

	.timeline {
		display: flex;
		flex-direction: column;
	}

	.timeline-entry {
		display: flex;
		gap: 18px;
	}

	.timeline-marker {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex-shrink: 0;
		width: 12px;
	}

	.timeline-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--ink);
		border: 2px solid var(--paper);
		box-shadow: 0 0 0 1px var(--line);
		margin-top: 6px;
	}

	.timeline-line {
		flex: 1;
		width: 1px;
		background: var(--line);
		margin-top: 4px;
	}

	.timeline-entry:last-child .timeline-line {
		display: none;
	}

	.timeline-content {
		flex: 1;
		padding-bottom: 28px;
	}

	.note-date {
		font-size: 13px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.note-text {
		margin: 8px 0 0;
		font-size: 15px;
		line-height: 1.6;
	}

	@media (max-width: 720px) {
		.update-form {
			align-items: stretch;
		}

		.update-form > div {
			flex: 1 1 160px;
		}

		.update-form select,
		.update-form input {
			width: 100%;
		}

		.update-form .btn {
			width: 100%;
			justify-content: center;
		}

		.timeline-entry {
			gap: 12px;
		}
	}
</style>
