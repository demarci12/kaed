---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import { HEADLINE_SIGNAL_TYPES } from '../../lib/projects';
import type { BusinessIdea } from '../../lib/business-ideas';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { id } = Astro.params;

const { data: idea } = await supabase.from('business_ideas').select('*').eq('id', id).maybeSingle();

if (!idea) {
	return Astro.redirect('/business-ideas');
}

const typed = idea as BusinessIdea;
const error = Astro.url.searchParams.get('error');

const { data: linkedProject } = await supabase
	.from('projects')
	.select('id, title')
	.eq('business_idea_id', typed.id)
	.maybeSingle();

let headlineSignalCount = 0;
if (linkedProject) {
	const { data: logs } = await supabase
		.from('project_logs')
		.select('signal_type')
		.eq('project_id', linkedProject.id)
		.in('signal_type', HEADLINE_SIGNAL_TYPES);
	headlineSignalCount = logs?.length ?? 0;
}
---

<Layout user={auth.user}>
	<section class="detail max-w-[760px]">
		<a class="back" href="/business-ideas">← Business ideas</a>

		<h1>{typed.title}</h1>
		<p class="mt-[10px] text-[13px] text-muted">
			Registered {new Date(typed.created_at).toLocaleDateString()}
			{typed.updated_at !== typed.created_at &&
				` · updated ${new Date(typed.updated_at).toLocaleDateString()}`}
		</p>

		{error && <p class="form-error">{error}</p>}

		<div class="mt-6 flex items-center gap-3 flex-wrap md:flex-nowrap">
			{linkedProject ? (
				<>
					<a class="btn ghost w-full md:w-auto justify-center md:justify-normal" href={`/projects/${linkedProject.id}`}>→ {linkedProject.title}</a>
					<span class="text-[13px] text-muted">
						{headlineSignalCount} signal{headlineSignalCount === 1 ? '' : 's'}
					</span>
				</>
			) : (
				<form method="post" action="/api/projects/create" class="m-0">
					<input type="hidden" name="title" value={typed.title} />
					<input type="hidden" name="description" value={typed.pain_point ?? ''} />
					<input type="hidden" name="business_idea_id" value={typed.id} />
					<input type="hidden" name="return_to" value={`/business-ideas/${typed.id}`} />
					<button type="submit" class="btn w-full md:w-auto justify-center md:justify-normal">Start working on this →</button>
				</form>
			)}
		</div>

		<form method="post" action={`/api/business-ideas/${typed.id}/update`} class="flex flex-col gap-7 mt-10 w-full">
			<div class="flex flex-col gap-2">
				<label for="title" class="text-xs font-semibold tracking-[0.06em] uppercase text-muted">Title</label>
				<input id="title" name="title" type="text" required maxlength="160" value={typed.title} class="w-full font-serif text-xl font-semibold text-ink bg-canvas border border-line rounded-[10px] px-[14px] py-[10px] outline-none resize-y transition-colors duration-150 focus:border-ink focus:shadow-[0_0_0_3px_rgba(20,17,15,0.08)]" />
			</div>

			<div class="flex flex-col gap-2">
				<label for="pain_point" class="text-xs font-semibold tracking-[0.06em] uppercase text-muted">Pain point</label>
				<textarea id="pain_point" name="pain_point" rows="3" class="w-full font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-[14px] py-[10px] outline-none resize-y transition-colors duration-150 focus:border-ink focus:shadow-[0_0_0_3px_rgba(20,17,15,0.08)]">{typed.pain_point}</textarea>
			</div>

			<div class="flex flex-col gap-2">
				<label for="target_market" class="text-xs font-semibold tracking-[0.06em] uppercase text-muted">Target market</label>
				<textarea id="target_market" name="target_market" rows="3" class="w-full font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-[14px] py-[10px] outline-none resize-y transition-colors duration-150 focus:border-ink focus:shadow-[0_0_0_3px_rgba(20,17,15,0.08)]">{typed.target_market}</textarea>
			</div>

			<div class="flex flex-col gap-2">
				<label for="validation" class="text-xs font-semibold tracking-[0.06em] uppercase text-muted">Validation</label>
				<textarea id="validation" name="validation" rows="3" class="w-full font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-[14px] py-[10px] outline-none resize-y transition-colors duration-150 focus:border-ink focus:shadow-[0_0_0_3px_rgba(20,17,15,0.08)]">{typed.validation}</textarea>
			</div>

			<div class="flex items-center gap-[14px] mt-2 flex-wrap md:flex-nowrap">
				<button type="submit" class="btn w-full md:w-auto justify-center md:justify-normal">Save changes</button>
				<button type="submit" form="delete-idea" class="btn danger w-full md:w-auto justify-center md:justify-normal">Delete idea</button>
			</div>
		</form>

		<form id="delete-idea" method="post" action={`/api/business-ideas/${typed.id}/delete`}></form>
	</section>
</Layout>
