---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/auth';
import type { BusinessIdea } from '../../lib/business-ideas';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { id } = Astro.params;

const { data: idea } = await supabase.from('business_ideas').select('*').eq('id', id).maybeSingle();

if (!idea) {
	return Astro.redirect('/business-ideas');
}

const typed = idea as BusinessIdea;
const error = Astro.url.searchParams.get('error');

const { data: linkedChallenge } = await supabase
	.from('challenges')
	.select('id, title')
	.eq('business_idea_id', typed.id)
	.maybeSingle();
---

<Layout>
	<section class="detail">
		<a class="back" href="/business-ideas">← Business ideas</a>

		<h1>{typed.title}</h1>
		<p class="dates">
			Registered {new Date(typed.created_at).toLocaleDateString()}
			{typed.updated_at !== typed.created_at &&
				` · updated ${new Date(typed.updated_at).toLocaleDateString()}`}
		</p>

		{error && <p class="form-error">{error}</p>}

		<div class="promote">
			{linkedChallenge ? (
				<a class="btn ghost" href={`/challenges/${linkedChallenge.id}`}>→ {linkedChallenge.title}</a>
			) : (
				<form method="post" action="/api/challenges/create">
					<input type="hidden" name="title" value={typed.title} />
					<input type="hidden" name="description" value={typed.pain_point ?? ''} />
					<input type="hidden" name="business_idea_id" value={typed.id} />
					<input type="hidden" name="return_to" value={`/business-ideas/${typed.id}`} />
					<button type="submit" class="btn">Start working on this →</button>
				</form>
			)}
		</div>

		<form method="post" action={`/api/business-ideas/${typed.id}/update`} class="edit-form">
			<div class="field">
				<label for="title">Title</label>
				<input id="title" name="title" type="text" required maxlength="160" value={typed.title} />
			</div>

			<div class="field">
				<label for="pain_point">Pain point</label>
				<textarea id="pain_point" name="pain_point" rows="3">{typed.pain_point}</textarea>
			</div>

			<div class="field">
				<label for="target_market">Target market</label>
				<textarea id="target_market" name="target_market" rows="3">{typed.target_market}</textarea>
			</div>

			<div class="field">
				<label for="validation">Validation</label>
				<textarea id="validation" name="validation" rows="3">{typed.validation}</textarea>
			</div>

			<div class="actions">
				<button type="submit" class="btn">Save changes</button>
				<button type="submit" form="delete-idea" class="btn danger">Delete idea</button>
			</div>
		</form>

		<form id="delete-idea" method="post" action={`/api/business-ideas/${typed.id}/delete`}></form>
	</section>
</Layout>

<style>
	.detail {
		max-width: 760px;
	}

	.back {
		display: inline-block;
		margin-bottom: 24px;
		color: var(--muted);
		text-decoration: none;
		font-size: 14px;
	}

	.back:hover {
		color: var(--ink);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2rem, 5vw, 2.8rem);
		letter-spacing: -0.02em;
	}

	.dates {
		margin: 10px 0 0;
		font-size: 13px;
		color: var(--muted);
	}

	.promote {
		margin-top: 24px;
	}

	.promote form {
		margin: 0;
	}

	.promote .btn.ghost {
		background: transparent;
		color: var(--ink);
		border-color: var(--line);
		text-decoration: none;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.edit-form {
		display: flex;
		flex-direction: column;
		gap: 28px;
		margin-top: 40px;
		width: 100%;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field label {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.field input,
	.field textarea {
		width: 100%;
		font-family: var(--sans);
		font-size: 16px;
		color: var(--ink);
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--line);
		padding: 8px 0;
		outline: none;
		resize: vertical;
		transition: border-color 0.15s ease;
	}

	.field input {
		font-family: var(--serif);
		font-size: 22px;
	}

	.field input:focus,
	.field textarea:focus {
		border-color: var(--ink);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 8px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		height: 44px;
		padding: 0 22px;
		font-family: var(--sans);
		font-size: 15px;
		font-weight: 500;
		color: #fff;
		background: var(--ink);
		border: 1px solid var(--ink);
		border-radius: 999px;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.btn:hover {
		background: transparent;
		color: var(--ink);
	}

	.btn.danger {
		color: #b4231f;
		background: transparent;
		border-color: var(--line);
	}

	.btn.danger:hover {
		background: #fbf0ef;
		border-color: #e7c3c1;
	}
</style>
