---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import { HEADLINE_SIGNAL_TYPES } from '../../lib/projects';
import type { BusinessIdea } from '../../lib/business-ideas';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('business_ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as BusinessIdea[];

const ideaIds = typedIdeas.map((idea) => idea.id);
const signalCountByIdeaId = new Map<string, number>();
const linkedProjectByIdeaId = new Map<string, { id: string; title: string }>();

if (ideaIds.length) {
	const { data: linkedProjects } = await supabase
		.from('projects')
		.select('id, title, business_idea_id')
		.in('business_idea_id', ideaIds);

	const projectIdToIdeaId = new Map<string, string>();
	for (const p of linkedProjects ?? []) {
		const ideaId = p.business_idea_id as string;
		linkedProjectByIdeaId.set(ideaId, { id: p.id, title: p.title });
		projectIdToIdeaId.set(p.id, ideaId);
	}

	if (projectIdToIdeaId.size) {
		const { data: logs } = await supabase
			.from('project_logs')
			.select('project_id, signal_type')
			.in('project_id', [...projectIdToIdeaId.keys()])
			.in('signal_type', HEADLINE_SIGNAL_TYPES);

		for (const log of logs ?? []) {
			const ideaId = projectIdToIdeaId.get(log.project_id);
			if (!ideaId) continue;
			signalCountByIdeaId.set(ideaId, (signalCountByIdeaId.get(ideaId) ?? 0) + 1);
		}
	}
}

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="ideas">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Business idea register.</h1>
				<p class="lede">
					Ideas worth evaluating as businesses — the pain point they solve, who has it, and
					what's been done to validate it.
				</p>
			</div>
			<button type="button" class="btn" data-open-popup="new-business-idea">+ Register idea</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="ideas-grid">
			{typedIdeas.length ? (
				typedIdeas.map((idea) => {
					const linkedProject = linkedProjectByIdeaId.get(idea.id);
					const signalCount = signalCountByIdeaId.get(idea.id) ?? 0;
					return (
						<article class="idea-card">
							<div class="idea-card-head">
								<a class="idea-title" href={`/business-ideas/${idea.id}`}>{idea.title}</a>
								<form method="post" action={`/api/business-ideas/${idea.id}/delete`} class="idea-delete-form">
									<button type="submit" class="idea-delete" aria-label="Delete business idea">×</button>
								</form>
							</div>

							<div class="idea-field">
								<span class="idea-field-label">Pain point</span>
								<p
									class="idea-field-value"
									data-editable="textarea"
									data-field="pain_point"
									data-id={idea.id}
									data-endpoint="/api/business-ideas"
									data-value={idea.pain_point ?? ''}
								>
									{idea.pain_point || 'Not set.'}
								</p>
							</div>

							<div class="idea-field">
								<span class="idea-field-label">Target market</span>
								<p
									class="idea-field-value"
									data-editable="textarea"
									data-field="target_market"
									data-id={idea.id}
									data-endpoint="/api/business-ideas"
									data-value={idea.target_market ?? ''}
								>
									{idea.target_market || 'Not set.'}
								</p>
							</div>

							<div class="idea-field">
								<span class="idea-field-label">Validation</span>
								<p
									class="idea-field-value"
									data-editable="textarea"
									data-field="validation"
									data-id={idea.id}
									data-endpoint="/api/business-ideas"
									data-value={idea.validation ?? ''}
								>
									{idea.validation || 'Not set.'}
								</p>
							</div>

							<div class="idea-card-foot">
								{linkedProject ? (
									<a class="idea-chip" href={`/projects/${linkedProject.id}`}>
										→ {linkedProject.title} · {signalCount} signal{signalCount === 1 ? '' : 's'}
									</a>
								) : (
									<span class="idea-chip idea-chip-muted">Not started as a project</span>
								)}
								<span class="idea-date">{new Date(idea.created_at).toLocaleDateString()}</span>
							</div>
						</article>
					);
				})
			) : (
				<p class="empty">No business ideas registered yet.</p>
			)}
		</div>
	</section>

	<dialog id="new-business-idea" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Register idea</h2>
		<form method="post" action="/api/business-ideas/create">
			<label for="title">Title</label>
			<input id="title" name="title" type="text" required maxlength="160" />

			<label for="pain_point">Pain point</label>
			<textarea id="pain_point" name="pain_point" rows="2" placeholder="What problem does this solve, for whom?"></textarea>

			<label for="target_market">Target market</label>
			<textarea id="target_market" name="target_market" rows="2" placeholder="Who would pay for this?"></textarea>

			<label for="validation">Validation</label>
			<textarea id="validation" name="validation" rows="2" placeholder="What have you done to test this so far?"></textarea>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Register idea</button>
			</div>
		</form>
	</dialog>
</Layout>

<style>
	.ideas {
		max-width: 1080px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 54ch;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.6;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	/* Cards, not a table: six columns of free text truncated every field to
	   an unreadable ellipsis. A card can show all three fields in full. */
	.ideas-grid {
		margin-top: 40px;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 18px;
	}

	.idea-card {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 22px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.idea-card-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
	}

	.idea-title {
		font-family: var(--serif);
		font-size: 19px;
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink);
		text-decoration: none;
	}

	.idea-title:hover {
		text-decoration: underline;
	}

	.idea-delete-form {
		margin: 0;
		flex-shrink: 0;
	}

	.idea-delete {
		width: 26px;
		height: 26px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		font-size: 16px;
		line-height: 1;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.idea-delete:hover {
		border-color: #e7c3c1;
		color: #b4231f;
	}

	.idea-field {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.idea-field-label {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.idea-field-value {
		margin: 0;
		padding: 8px 10px;
		border: 1px solid transparent;
		border-radius: 8px;
		font-size: 14px;
		line-height: 1.6;
		color: var(--ink);
		white-space: pre-wrap;
		cursor: text;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.idea-field-value:hover {
		border-color: var(--line);
		background: var(--canvas);
	}

	.idea-field-value[data-value=''] {
		color: var(--muted);
	}

	.idea-card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: auto;
		padding-top: 14px;
		border-top: 1px solid var(--line);
	}

	.idea-chip {
		font-size: 12px;
		padding: 4px 10px;
		border-radius: 999px;
		background: var(--canvas);
		border: 1px solid var(--line);
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
	}

	.idea-chip:hover {
		border-color: var(--ink);
	}

	.idea-chip-muted {
		background: transparent;
		border-style: dashed;
		color: var(--muted);
	}

	.idea-chip-muted:hover {
		border-color: var(--line);
	}

	.idea-date {
		font-size: 12px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.empty {
		/* Span the whole grid rather than sitting in one narrow column. */
		grid-column: 1 / -1;
		margin: 0;
		padding: 32px 16px;
		text-align: center;
		color: var(--muted);
		border: 1px dashed var(--line);
		border-radius: 14px;
	}

	@media (max-width: 720px) {
		.page-head {
			flex-direction: column;
			align-items: stretch;
		}

		.ideas-grid {
			grid-template-columns: 1fr;
			margin-top: 28px;
		}

		.idea-card {
			padding: 18px;
		}
	}
</style>
