---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/auth';
import type { BusinessIdea } from '../../lib/business-ideas';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('business_ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as BusinessIdea[];

const error = Astro.url.searchParams.get('error');
---

<Layout>
	<section class="ideas">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Business idea register.</h1>
				<p class="lede">
					Ideas worth evaluating as businesses — the pain point they solve, who has it, and
					what's been done to validate it.
				</p>
			</div>
			<label for="new-business-idea" class="btn">+ Register idea</label>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="table-wrap">
			<table class="data-table">
				<thead>
					<tr>
						<th>Title</th>
						<th>Pain point</th>
						<th>Target market</th>
						<th>Validation</th>
						<th>Added</th>
					</tr>
				</thead>
				<tbody>
					{typedIdeas.length ? (
						typedIdeas.map((idea) => (
							<tr>
								<td class="cell-title">
									<a href={`/business-ideas/${idea.id}`}>{idea.title}</a>
								</td>
								<td
									class="cell-muted"
									data-editable="textarea"
									data-field="pain_point"
									data-id={idea.id}
									data-endpoint="/api/business-ideas"
									data-value={idea.pain_point ?? ''}
								>
									{idea.pain_point ?? '—'}
								</td>
								<td
									class="cell-muted"
									data-editable="textarea"
									data-field="target_market"
									data-id={idea.id}
									data-endpoint="/api/business-ideas"
									data-value={idea.target_market ?? ''}
								>
									{idea.target_market ?? '—'}
								</td>
								<td
									class="cell-muted"
									data-editable="textarea"
									data-field="validation"
									data-id={idea.id}
									data-endpoint="/api/business-ideas"
									data-value={idea.validation ?? ''}
								>
									{idea.validation ?? '—'}
								</td>
								<td class="cell-date">{new Date(idea.created_at).toLocaleDateString()}</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="5" class="empty-cell">No business ideas registered yet.</td>
						</tr>
					)}
				</tbody>
			</table>
		</div>
	</section>

	<input type="checkbox" id="new-business-idea" class="popup-toggle" />
	<div class="popup-overlay">
		<label for="new-business-idea" class="popup-backdrop" aria-hidden="true"></label>
		<div class="popup">
			<h2>Register idea</h2>
			<form method="post" action="/api/business-ideas/create">
				<label for="title">Title</label>
				<input id="title" name="title" type="text" required maxlength="160" />

				<label for="pain_point">Pain point</label>
				<textarea id="pain_point" name="pain_point" rows="2" placeholder="What problem does this solve, for whom?"></textarea>

				<label for="target_market">Target market</label>
				<textarea id="target_market" name="target_market" rows="2" placeholder="Who would pay for this?"></textarea>

				<label for="validation">Validation</label>
				<textarea id="validation" name="validation" rows="2" placeholder="What have you done to test this so far?"></textarea>

				<div class="popup-actions">
					<label for="new-business-idea" class="btn ghost">Cancel</label>
					<button type="submit" class="btn">Register idea</button>
				</div>
			</form>
		</div>
	</div>
</Layout>

<style>
	.ideas {
		max-width: 1080px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 54ch;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.6;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.table-wrap {
		margin-top: 40px;
		overflow-x: auto;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}

	.data-table th {
		text-align: left;
		padding: 12px 16px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		background: var(--canvas);
		white-space: nowrap;
	}

	.data-table td {
		padding: 12px 16px;
		border-bottom: 1px solid var(--line);
		vertical-align: middle;
	}

	.data-table tr:last-child td {
		border-bottom: none;
	}

	.cell-title {
		white-space: nowrap;
	}

	.cell-title a {
		color: var(--ink);
		text-decoration: none;
		font-weight: 500;
	}

	.cell-title a:hover {
		text-decoration: underline;
	}

	.cell-muted {
		color: var(--muted);
		max-width: 260px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.cell-date {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.empty-cell {
		padding: 32px 16px;
		text-align: center;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.page-head {
			flex-direction: column;
			align-items: stretch;
		}
		.cell-muted {
			max-width: 140px;
		}
	}
</style>
