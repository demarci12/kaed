---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import { HEADLINE_SIGNAL_TYPES } from '../../lib/projects';
import type { BusinessIdea } from '../../lib/business-ideas';
import { IDEA_CATEGORY_PILL_LABELS } from '../../lib/idea-categories';
import { selectOptionsFromLabels } from '../../lib/select-options';

const categoryOptions = selectOptionsFromLabels(IDEA_CATEGORY_PILL_LABELS, ['', 'Pick category']);

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('business_ideas')
	.select('*')
	.order('rank', { ascending: true });

const typedIdeas = (ideas ?? []) as BusinessIdea[];

const ideaIds = typedIdeas.map((idea) => idea.id);
const signalCountByIdeaId = new Map<string, number>();
const linkedProjectByIdeaId = new Map<string, { id: string; title: string }>();

if (ideaIds.length) {
	const { data: linkedProjects } = await supabase
		.from('projects')
		.select('id, title, business_idea_id')
		.in('business_idea_id', ideaIds);

	const projectIdToIdeaId = new Map<string, string>();
	for (const p of linkedProjects ?? []) {
		const ideaId = p.business_idea_id as string;
		linkedProjectByIdeaId.set(ideaId, { id: p.id, title: p.title });
		projectIdToIdeaId.set(p.id, ideaId);
	}

	if (projectIdToIdeaId.size) {
		const { data: logs } = await supabase
			.from('project_logs')
			.select('project_id, signal_type')
			.in('project_id', [...projectIdToIdeaId.keys()])
			.in('signal_type', HEADLINE_SIGNAL_TYPES);

		for (const log of logs ?? []) {
			const ideaId = projectIdToIdeaId.get(log.project_id);
			if (!ideaId) continue;
			signalCountByIdeaId.set(ideaId, (signalCountByIdeaId.get(ideaId) ?? 0) + 1);
		}
	}
}

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="ideas max-w-[1080px]">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Business idea register.</h1>
				<p class="lede">
					Ideas worth evaluating as businesses — the pain point they solve, who has it, and
					what's been done to validate it.
				</p>
			</div>
			<button type="button" class="btn" data-open-popup="new-business-idea">+ Register idea</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="card-grid" id="idea-grid">
			{typedIdeas.length ? (
				typedIdeas.map((idea, index) => {
					const linkedProject = linkedProjectByIdeaId.get(idea.id);
					const signalCount = signalCountByIdeaId.get(idea.id) ?? 0;
					return (
						<article class="card" id={`idea-${idea.id}`} data-idea-card data-id={idea.id}>
							<div class="card-head">
								<button
									type="button"
									class="rank-badge"
									data-rank-badge
									data-id={idea.id}
									title="Click to set position"
								>{index + 1}</button>
								<a class="card-title" href={`/business-ideas/${idea.id}`}>{idea.title}</a>
								<div class="rank-controls shrink-0">
									<button
										type="button"
										class="rank-btn"
										data-move="up"
										data-id={idea.id}
										aria-label="Move up"
										disabled={index === 0}
									>↑</button>
									<button
										type="button"
										class="rank-btn"
										data-move="down"
										data-id={idea.id}
										aria-label="Move down"
										disabled={index === typedIdeas.length - 1}
									>↓</button>
								</div>
								<form class="shrink-0" method="post" action={`/api/business-ideas/${idea.id}/delete`}>
									<button type="submit" class="card-delete" aria-label="Delete business idea">×</button>
								</form>
							</div>

							<div
								class="inline-block self-start cursor-pointer"
								data-editable="select"
								data-field="category"
								data-id={idea.id}
								data-endpoint="/api/business-ideas"
								data-value={idea.category ?? ''}
								data-options={categoryOptions}
							>
								{idea.category ? (
									<span class={`pill pill-${idea.category}`}>{IDEA_CATEGORY_PILL_LABELS[idea.category]}</span>
								) : (
									<span class="pill pill-empty">Pick category</span>
								)}
							</div>

							<div class="card-field">
								<span class="card-field-label">Pain point</span>
								<p
									class="card-field-value"
									data-editable="textarea"
									data-field="pain_point"
									data-id={idea.id}
									data-endpoint="/api/business-ideas"
									data-value={idea.pain_point ?? ''}
								>
									{idea.pain_point || 'Not set.'}
								</p>
							</div>

							<div class="card-field">
								<span class="card-field-label">Target market</span>
								<p
									class="card-field-value"
									data-editable="textarea"
									data-field="target_market"
									data-id={idea.id}
									data-endpoint="/api/business-ideas"
									data-value={idea.target_market ?? ''}
								>
									{idea.target_market || 'Not set.'}
								</p>
							</div>

							<div class="card-field">
								<span class="card-field-label">Validation</span>
								<p
									class="card-field-value"
									data-editable="textarea"
									data-field="validation"
									data-id={idea.id}
									data-endpoint="/api/business-ideas"
									data-value={idea.validation ?? ''}
								>
									{idea.validation || 'Not set.'}
								</p>
							</div>

							<div class="card-foot">
								{linkedProject ? (
									<a class="chip" href={`/projects/${linkedProject.id}`}>
										→ {linkedProject.title} · {signalCount} signal{signalCount === 1 ? '' : 's'}
									</a>
								) : (
									<span class="chip chip-muted">Not started as a project</span>
								)}
								<span class="card-date">{new Date(idea.created_at).toLocaleDateString()}</span>
							</div>
						</article>
					);
				})
			) : (
				<p class="empty">No business ideas registered yet.</p>
			)}
		</div>
	</section>

	<dialog id="new-business-idea" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Register idea</h2>
		<form method="post" action="/api/business-ideas/create">
			<label for="title">Title</label>
			<input id="title" name="title" type="text" required maxlength="160" />

			<label for="pain_point">Pain point</label>
			<textarea id="pain_point" name="pain_point" rows="2" placeholder="What problem does this solve, for whom?"></textarea>

			<label for="target_market">Target market</label>
			<textarea id="target_market" name="target_market" rows="2" placeholder="Who would pay for this?"></textarea>

			<label for="validation">Validation</label>
			<textarea id="validation" name="validation" rows="2" placeholder="What have you done to test this so far?"></textarea>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Register idea</button>
			</div>
		</form>
	</dialog>
</Layout>

<script>
	// Delegated from `document` (survives ClientRouter soft navigations, per
	// Layout.astro's established pattern) instead of binding to the buttons
	// directly, which would go stale after a soft nav away and back.
	document.addEventListener('click', async (event) => {
		const target = event.target as HTMLElement;
		const button = target.closest<HTMLButtonElement>('[data-move]');
		if (!button || button.disabled) return;

		const direction = button.dataset.move;
		const id = button.dataset.id;
		if ((direction !== 'up' && direction !== 'down') || !id) return;

		const card = document.getElementById(`idea-${id}`);
		if (!card) return;

		const sibling = direction === 'up' ? card.previousElementSibling : card.nextElementSibling;
		if (!sibling || !(sibling instanceof HTMLElement) || !sibling.hasAttribute('data-idea-card')) return;

		button.disabled = true;

		try {
			const response = await fetch(`/api/business-ideas/${id}/move`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ direction }),
			});
			const payload = await response.json().catch(() => null);
			if (!response.ok || !payload?.ok) {
				throw new Error(payload?.error || 'Could not reorder.');
			}
			if (!payload.moved) return;

			if (direction === 'up') {
				card.parentElement?.insertBefore(card, sibling);
			} else {
				card.parentElement?.insertBefore(sibling, card);
			}

			renumberIdeaCards();
		} catch (error) {
			console.error(error);
		} finally {
			button.disabled = false;
		}
	});

	function renumberIdeaCards() {
		const cards = document.querySelectorAll<HTMLElement>('#idea-grid [data-idea-card]');
		cards.forEach((card, index) => {
			const badge = card.querySelector('[data-rank-badge]');
			if (badge && badge.tagName !== 'INPUT') badge.textContent = String(index + 1);

			const upBtn = card.querySelector<HTMLButtonElement>('[data-move="up"]');
			const downBtn = card.querySelector<HTMLButtonElement>('[data-move="down"]');
			if (upBtn) upBtn.disabled = index === 0;
			if (downBtn) downBtn.disabled = index === cards.length - 1;
		});
	}

	// Click-to-edit the rank badge: swap the button for a number input, submit
	// the new 1-based position on Enter/blur, reorder the grid from the
	// server's authoritative order rather than guessing locally.
	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;
		const badge = target.closest<HTMLButtonElement>('[data-rank-badge]');
		if (!badge || badge.dataset.editing) return;

		startRankEdit(badge);
	});

	function startRankEdit(badge: HTMLButtonElement) {
		const id = badge.dataset.id;
		if (!id) return;

		const originalValue = badge.textContent?.trim() ?? '1';
		const input = document.createElement('input');
		input.type = 'number';
		input.min = '1';
		input.value = originalValue;
		input.className = 'rank-badge-input';
		input.dataset.id = id;

		badge.replaceWith(input);
		input.focus();
		input.select();

		let settled = false;
		const cancel = () => {
			if (settled) return;
			settled = true;
			input.replaceWith(badge);
		};
		const commit = async () => {
			if (settled) return;
			settled = true;

			const position = Number(input.value);
			if (!Number.isFinite(position) || position < 1 || String(position) === originalValue) {
				input.replaceWith(badge);
				return;
			}

			input.disabled = true;
			try {
				const response = await fetch(`/api/business-ideas/${id}/rank`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ position }),
				});
				const payload = await response.json().catch(() => null);
				if (!response.ok || !payload?.ok) {
					throw new Error(payload?.error || 'Could not set position.');
				}

				input.replaceWith(badge);
				reorderIdeaCards(payload.order as string[]);
			} catch (error) {
				console.error(error);
				input.replaceWith(badge);
			}
		};

		input.addEventListener('blur', commit);
		input.addEventListener('keydown', (keyEvent) => {
			if (keyEvent.key === 'Enter') {
				keyEvent.preventDefault();
				input.blur();
			} else if (keyEvent.key === 'Escape') {
				keyEvent.preventDefault();
				cancel();
			}
		});
	}

	function reorderIdeaCards(order: string[]) {
		const grid = document.getElementById('idea-grid');
		if (!grid) return;

		for (const id of order) {
			const card = document.getElementById(`idea-${id}`);
			if (card) grid.appendChild(card);
		}

		renumberIdeaCards();
	}
</script>
