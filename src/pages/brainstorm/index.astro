---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/auth';
import type { Idea } from '../../lib/ideas';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as Idea[];

const error = Astro.url.searchParams.get('error');
---

<Layout>
	<section class="brainstorm">
		<p class="eyebrow">Personal</p>
		<h1>Brainstorm.</h1>
		<p class="lede">A dumping ground for ideas before they're worth anything more formal.</p>

		{error && <p class="form-error">{error}</p>}

		<div class="grid">
			{typedIdeas.length ? (
				typedIdeas.map((idea) => (
					<div class="idea-card">
						<div class="idea-head">
							<h3>{idea.title}</h3>
							<form method="post" action={`/api/ideas/${idea.id}/delete`}>
								<button type="submit" class="idea-delete" aria-label="Delete idea">×</button>
							</form>
						</div>
						{idea.body && <p class="idea-body">{idea.body}</p>}
						<span class="idea-date">{new Date(idea.created_at).toLocaleDateString()}</span>
					</div>
				))
			) : (
				<p class="empty">No ideas yet. Drop your first one below.</p>
			)}
		</div>

		<details class="dropup">
			<summary class="dropup-trigger">+ New idea</summary>
			<div class="dropup-panel">
				<form method="post" action="/api/ideas/create" class="idea-form">
					<label for="title">Title</label>
					<input id="title" name="title" type="text" required maxlength="160" />

					<label for="body">Notes</label>
					<textarea id="body" name="body" rows="4"></textarea>

					<button type="submit" class="btn">Add idea</button>
				</form>
			</div>
		</details>
	</section>
</Layout>

<style>
	.brainstorm {
		max-width: 860px;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.empty {
		color: var(--muted);
		font-size: 15px;
		margin-top: 40px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 16px;
		margin-top: 40px;
	}

	.idea-card {
		padding: 20px;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 14px;
		display: flex;
		flex-direction: column;
	}

	.idea-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 8px;
	}

	.idea-head h3 {
		margin: 0;
		font-family: var(--serif);
		font-size: 17px;
		font-weight: 600;
	}

	.idea-head form {
		margin: 0;
	}

	.idea-delete {
		flex-shrink: 0;
		width: 24px;
		height: 24px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		font-size: 16px;
		line-height: 1;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.idea-delete:hover {
		border-color: var(--line);
		color: #b4231f;
	}

	.idea-body {
		margin: 10px 0 0;
		font-size: 14px;
		line-height: 1.5;
		color: var(--muted);
		white-space: pre-wrap;
	}

	.idea-date {
		margin-top: 16px;
		font-size: 12px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.dropup {
		margin-top: 40px;
	}

	.dropup-trigger {
		display: inline-flex;
		align-items: center;
		height: 44px;
		padding: 0 22px;
		font-family: var(--sans);
		font-size: 15px;
		font-weight: 500;
		color: var(--ink);
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 999px;
		cursor: pointer;
		list-style: none;
		transition: border-color 0.15s ease;
	}

	.dropup-trigger::-webkit-details-marker {
		display: none;
	}

	.dropup-trigger:hover {
		border-color: var(--ink);
	}

	.dropup[open] .dropup-trigger {
		border-color: var(--ink);
	}

	.dropup-panel {
		margin-top: 16px;
		padding: 32px;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 16px;
		max-width: 480px;
		animation: dropup-in 0.15s ease;
	}

	@keyframes dropup-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.idea-form {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.idea-form label {
		margin-top: 14px;
		font-size: 13px;
		font-weight: 500;
		color: var(--muted);
	}

	.idea-form input,
	.idea-form textarea {
		font-family: var(--sans);
		font-size: 15px;
		color: var(--ink);
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 10px 14px;
		outline: none;
		resize: vertical;
	}

	.idea-form input:focus,
	.idea-form textarea:focus {
		border-color: var(--ink);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		margin-top: 24px;
		height: 44px;
		padding: 0 22px;
		font-family: var(--sans);
		font-size: 15px;
		font-weight: 500;
		color: #fff;
		background: var(--ink);
		border: 1px solid var(--ink);
		border-radius: 999px;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.btn:hover {
		background: transparent;
		color: var(--ink);
	}
</style>
