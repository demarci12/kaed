---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/auth';
import type { Idea } from '../../lib/ideas';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as Idea[];

const error = Astro.url.searchParams.get('error');
---

<Layout>
	<section class="brainstorm">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Brainstorm.</h1>
				<p class="lede">A dumping ground for ideas before they're worth anything more formal.</p>
			</div>
			<button type="button" class="btn" data-open-dialog="new-idea">+ New idea</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="table-wrap">
			<table class="data-table">
				<thead>
					<tr>
						<th>Title</th>
						<th>Notes</th>
						<th>Added</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{typedIdeas.length ? (
						typedIdeas.map((idea) => (
							<tr>
								<td
									class="cell-title"
									data-editable="text"
									data-field="title"
									data-id={idea.id}
									data-endpoint="/api/ideas"
									data-value={idea.title}
								>
									{idea.title}
								</td>
								<td
									class="cell-muted"
									data-editable="textarea"
									data-field="body"
									data-id={idea.id}
									data-endpoint="/api/ideas"
									data-value={idea.body ?? ''}
								>
									{idea.body ?? '—'}
								</td>
								<td class="cell-date">{new Date(idea.created_at).toLocaleDateString()}</td>
								<td class="cell-actions">
									<form method="post" action={`/api/ideas/${idea.id}/delete`}>
										<button type="submit" class="idea-delete" aria-label="Delete idea">×</button>
									</form>
								</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="4" class="empty-cell">No ideas yet. Drop your first one.</td>
						</tr>
					)}
				</tbody>
			</table>
		</div>
	</section>

	<dialog id="new-idea" class="popup">
		<div class="popup-inner">
			<h2>New idea</h2>
			<form method="post" action="/api/ideas/create">
				<label for="title">Title</label>
				<input id="title" name="title" type="text" required maxlength="160" />

				<label for="body">Notes</label>
				<textarea id="body" name="body" rows="4"></textarea>

				<div class="popup-actions">
					<button type="button" class="btn ghost" data-close-dialog>Cancel</button>
					<button type="submit" class="btn">Add idea</button>
				</div>
			</form>
		</div>
	</dialog>
</Layout>

<style>
	.brainstorm {
		max-width: 1040px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.table-wrap {
		margin-top: 40px;
		overflow-x: auto;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}

	.data-table th {
		text-align: left;
		padding: 12px 16px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		background: var(--canvas);
		white-space: nowrap;
	}

	.data-table td {
		padding: 12px 16px;
		border-bottom: 1px solid var(--line);
		vertical-align: middle;
	}

	.data-table tr:last-child td {
		border-bottom: none;
	}

	.cell-title {
		font-weight: 500;
		white-space: nowrap;
	}

	.cell-muted {
		color: var(--muted);
		max-width: 420px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.cell-date {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.cell-actions {
		text-align: right;
	}

	.cell-actions form {
		margin: 0;
		display: inline-block;
	}

	.idea-delete {
		width: 24px;
		height: 24px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		font-size: 16px;
		line-height: 1;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.idea-delete:hover {
		border-color: var(--line);
		color: #b4231f;
	}

	.empty-cell {
		padding: 32px 16px;
		text-align: center;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.page-head {
			flex-direction: column;
			align-items: stretch;
		}
		.cell-muted {
			max-width: 160px;
		}
	}
</style>
