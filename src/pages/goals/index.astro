---
import Layout from '../../layouts/Layout.astro';
import { requireUser, type Goal } from '../../lib/goals';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: goals } = await supabase.from('goals').select('*').order('rank', { ascending: true });

const typedGoals = (goals ?? []) as Goal[];

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="goals max-w-[1080px]">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Goals.</h1>
				<p class="lede">
					What you're working toward. Drag a card by its handle to reorder — top of the list is the
					priority.
				</p>
			</div>
			<button type="button" class="btn" data-open-popup="new-goal">+ Register goal</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="card-grid" id="goal-grid">
			{typedGoals.length ? (
				typedGoals.map((goal) => (
					<article class="card" id={`goal-${goal.id}`} data-goal-card data-id={goal.id} draggable="true">
						<div class="card-head">
							<span class="drag-handle" title="Drag to reorder">⠿</span>
							<div
								class="card-title cursor-text"
								data-editable="text"
								data-field="title"
								data-id={goal.id}
								data-endpoint="/api/goals"
								data-value={goal.title}
							>
								{goal.title}
							</div>
							<form class="shrink-0" method="post" action={`/api/goals/${goal.id}/delete`}>
								<button type="submit" class="card-delete" aria-label="Delete goal">×</button>
							</form>
						</div>

						<div class="card-field">
							<span class="card-field-label">Description</span>
							<p
								class="card-field-value"
								data-editable="textarea"
								data-field="description"
								data-id={goal.id}
								data-endpoint="/api/goals"
								data-value={goal.description ?? ''}
							>
								{goal.description || 'Not set.'}
							</p>
						</div>

						<div class="card-foot justify-end">
							<span class="card-date">{new Date(goal.created_at).toLocaleDateString()}</span>
						</div>
					</article>
				))
			) : (
				<p class="empty">No goals yet. Register your first one.</p>
			)}
		</div>
	</section>

	<dialog id="new-goal" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Register goal</h2>
		<form method="post" action="/api/goals/create">
			<label for="title">Title</label>
			<input id="title" name="title" type="text" required maxlength="160" />

			<label for="description">Description</label>
			<textarea id="description" name="description" rows="3" placeholder="What does reaching this look like?"></textarea>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Register goal</button>
			</div>
		</form>
	</dialog>
</Layout>

<script>
	// Native HTML5 drag-and-drop, delegated from `document` so it survives
	// ClientRouter soft navigations (see Layout.astro's established pattern) --
	// a listener bound straight to the cards would go stale after a soft nav
	// away and back.
	let draggedId: string | null = null;

	document.addEventListener('dragstart', (event) => {
		const target = event.target as HTMLElement;
		const card = target.closest<HTMLElement>('[data-goal-card]');
		if (!card) return;
		draggedId = card.dataset.id ?? null;
		card.classList.add('dragging');
		if (event.dataTransfer) {
			event.dataTransfer.effectAllowed = 'move';
			event.dataTransfer.setData('text/plain', draggedId ?? '');
		}
	});

	document.addEventListener('dragend', (event) => {
		const target = event.target as HTMLElement;
		const card = target.closest<HTMLElement>('[data-goal-card]');
		card?.classList.remove('dragging');
		draggedId = null;
	});

	document.addEventListener('dragover', (event) => {
		if (!draggedId) return;
		const grid = document.getElementById('goal-grid');
		if (!grid || !grid.contains(event.target as Node)) return;
		event.preventDefault();

		const draggedCard = document.getElementById(`goal-${draggedId}`);
		if (!draggedCard) return;

		const target = (event.target as HTMLElement).closest<HTMLElement>('[data-goal-card]');
		if (!target || target === draggedCard) return;

		const rect = target.getBoundingClientRect();
		const before = event.clientY < rect.top + rect.height / 2;
		grid.insertBefore(draggedCard, before ? target : target.nextSibling);
	});

	document.addEventListener('drop', async (event) => {
		const grid = document.getElementById('goal-grid');
		if (!grid || !grid.contains(event.target as Node)) return;
		event.preventDefault();

		const order = Array.from(grid.querySelectorAll<HTMLElement>('[data-goal-card]')).map((card) => card.dataset.id);

		try {
			const response = await fetch('/api/goals/reorder', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ order }),
			});
			const payload = await response.json().catch(() => null);
			if (!response.ok || !payload?.ok) {
				throw new Error(payload?.error || 'Could not save the new order.');
			}
		} catch (error) {
			console.error(error);
		}
	});
</script>

<style>
	.drag-handle {
		flex-shrink: 0;
		cursor: grab;
		color: var(--muted);
		font-size: 16px;
		line-height: 1;
		user-select: none;
	}

	[data-goal-card].dragging {
		opacity: 0.4;
	}

	[data-goal-card] {
		cursor: default;
	}
</style>
