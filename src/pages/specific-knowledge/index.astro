---
import Layout from '../../layouts/Layout.astro';
import { requireUser, KNOWLEDGE_KIND_LABELS, type KnowledgeCard } from '../../lib/knowledge';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: cards } = await supabase
	.from('knowledge_cards')
	.select('*')
	.order('created_at', { ascending: false });

const typedCards = (cards ?? []) as KnowledgeCard[];

const kindOptions = [
	':No kind',
	...Object.entries(KNOWLEDGE_KIND_LABELS).map(([value, label]) => `${value}:${label}`),
].join(',');

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="knowledge">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Specific knowledge.</h1>
				<p class="lede">
					What you can't be trained for — the things you're genuinely obsessed with, unusually good at,
					or have actually lived through. Feels like play to you, looks like work to everyone else.
					Click any field to edit it.
				</p>
			</div>
			<button type="button" class="btn" data-open-popup="new-knowledge-card">+ Add card</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="knowledge-grid">
			{typedCards.length ? (
				typedCards.map((card) => (
					<article class="knowledge-card">
						<div class="knowledge-card-head">
							<div
								class="knowledge-title"
								data-editable="text"
								data-field="title"
								data-id={card.id}
								data-endpoint="/api/knowledge-cards"
								data-value={card.title}
							>
								{card.title}
							</div>
							<form method="post" action={`/api/knowledge-cards/${card.id}/delete`} class="knowledge-delete-form">
								<button type="submit" class="knowledge-delete" aria-label="Delete card">×</button>
							</form>
						</div>

						<div
							class="knowledge-kind"
							data-editable="select"
							data-field="kind"
							data-id={card.id}
							data-endpoint="/api/knowledge-cards"
							data-value={card.kind ?? ''}
							data-options={kindOptions}
						>
							{card.kind ? (
								<span class={`pill pill-${card.kind}`}>{KNOWLEDGE_KIND_LABELS[card.kind]}</span>
							) : (
								<span class="pill pill-empty">Pick kind</span>
							)}
						</div>

						<div class="knowledge-field">
							<span class="knowledge-field-label">What it is</span>
							<p
								class="knowledge-field-value"
								data-editable="textarea"
								data-field="body"
								data-id={card.id}
								data-endpoint="/api/knowledge-cards"
								data-value={card.body ?? ''}
							>
								{card.body || 'Not set.'}
							</p>
						</div>

						<div class="knowledge-field">
							<span class="knowledge-field-label">Evidence</span>
							<p
								class="knowledge-field-value"
								data-editable="textarea"
								data-field="evidence"
								data-id={card.id}
								data-endpoint="/api/knowledge-cards"
								data-value={card.evidence ?? ''}
							>
								{card.evidence || 'Not set.'}
							</p>
						</div>

						<div class="knowledge-card-foot">
							<span class="knowledge-date">{new Date(card.created_at).toLocaleDateString()}</span>
						</div>
					</article>
				))
			) : (
				<p class="empty">Nothing here yet. Add your first card to start mapping what you actually know.</p>
			)}
		</div>
	</section>

	<dialog id="new-knowledge-card" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Add knowledge card</h2>
		<form method="post" action="/api/knowledge-cards/create">
			<label for="title">Title</label>
			<input id="title" name="title" type="text" required maxlength="160" placeholder="e.g. Reading systems under load" />

			<label for="kind">Kind</label>
			<select id="kind" name="kind">
				<option value="">No kind</option>
				{Object.entries(KNOWLEDGE_KIND_LABELS).map(([value, label]) => (
					<option value={value}>{label}</option>
				))}
			</select>

			<label for="body">What it is</label>
			<textarea id="body" name="body" rows="3" placeholder="What is this, and why does it come easily to you?"></textarea>

			<label for="evidence">Evidence</label>
			<textarea id="evidence" name="evidence" rows="3" placeholder="What proves you have it? Things you've built, been asked for, lost time to."></textarea>

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Add card</button>
			</div>
		</form>
	</dialog>
</Layout>

<style>
	.knowledge {
		max-width: 1080px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 60ch;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.6;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.knowledge-grid {
		margin-top: 40px;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 18px;
	}

	.knowledge-card {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 22px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.knowledge-card-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
	}

	.knowledge-title {
		flex: 1;
		font-family: var(--serif);
		font-size: 19px;
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink);
		cursor: text;
	}

	.knowledge-kind {
		display: inline-block;
		align-self: flex-start;
		cursor: pointer;
	}

	.knowledge-kind select.cell-input {
		font-size: 14px;
		padding: 4px 6px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--paper);
	}

	.knowledge-delete-form {
		margin: 0;
		flex-shrink: 0;
	}

	.knowledge-delete {
		width: 26px;
		height: 26px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		font-size: 16px;
		line-height: 1;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.knowledge-delete:hover {
		border-color: #e7c3c1;
		color: #b4231f;
	}

	.knowledge-field {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.knowledge-field-label {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.knowledge-field-value {
		margin: 0;
		padding: 8px 10px;
		border: 1px solid transparent;
		border-radius: 8px;
		font-size: 14px;
		line-height: 1.6;
		color: var(--ink);
		white-space: pre-wrap;
		cursor: text;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.knowledge-field-value:hover {
		border-color: var(--line);
		background: var(--canvas);
	}

	.knowledge-field-value[data-value=''] {
		color: var(--muted);
	}

	.knowledge-card-foot {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px solid var(--line);
	}

	.knowledge-date {
		font-size: 12px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.empty {
		grid-column: 1 / -1;
		margin: 0;
		padding: 32px 16px;
		text-align: center;
		color: var(--muted);
		border: 1px dashed var(--line);
		border-radius: 14px;
	}

	@media (max-width: 720px) {
		.page-head {
			flex-direction: column;
			align-items: stretch;
		}

		.page-head .btn {
			width: 100%;
			justify-content: center;
		}

		.knowledge-grid {
			grid-template-columns: 1fr;
			margin-top: 28px;
		}

		.knowledge-card {
			padding: 18px;
		}
	}
</style>
