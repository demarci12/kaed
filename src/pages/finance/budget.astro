---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/finance';
import type { FinanceBudget, FinanceCategory, FinanceTransaction } from '../../lib/finance';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const monthParam = Astro.url.searchParams.get('month');
const monthValid = monthParam && /^\d{4}-\d{2}-01$/.test(monthParam);
const now = new Date();
const month = monthValid ? monthParam : `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-01`;

const monthDate = new Date(`${month}T00:00:00Z`);
const nextMonthDate = new Date(Date.UTC(monthDate.getUTCFullYear(), monthDate.getUTCMonth() + 1, 1));
const prevMonthDate = new Date(Date.UTC(monthDate.getUTCFullYear(), monthDate.getUTCMonth() - 1, 1));
const toMonthStr = (d: Date) => d.toISOString().slice(0, 10).replace(/\d{2}$/, '01');
const nextMonth = toMonthStr(nextMonthDate);
const prevMonth = toMonthStr(prevMonthDate);
const monthLabel = monthDate.toLocaleDateString(undefined, { year: 'numeric', month: 'long', timeZone: 'UTC' });

const { data: categories } = await supabase
	.from('finance_categories')
	.select('*')
	.eq('type', 'expense')
	.order('name', { ascending: true });

const { data: budgets } = await supabase.from('finance_budgets').select('*').eq('month', month);

const { data: transactions } = await supabase
	.from('finance_transactions')
	.select('*')
	.eq('type', 'expense')
	.gte('occurred_on', month)
	.lt('occurred_on', nextMonth);

const typedCategories = (categories ?? []) as FinanceCategory[];
const typedBudgets = (budgets ?? []) as FinanceBudget[];
const typedTransactions = (transactions ?? []) as FinanceTransaction[];

const budgetByCategoryId = new Map(typedBudgets.map((b) => [b.category_id, b]));
const actualByCategoryId = new Map<string, number>();
for (const t of typedTransactions) {
	if (!t.category_id) continue;
	actualByCategoryId.set(t.category_id, (actualByCategoryId.get(t.category_id) ?? 0) + Number(t.amount));
}

const totalBudgeted = typedBudgets.reduce((sum, b) => sum + Number(b.amount), 0);
const totalActual = [...actualByCategoryId.values()].reduce((sum, n) => sum + n, 0);

function formatAmount(n: number) {
	return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const error = Astro.url.searchParams.get('error');
---

<Layout>
	<section class="budget">
		<a class="back" href="/finance">← Finance</a>

		<div class="page-head">
			<div>
				<p class="eyebrow">Household</p>
				<h1>Budget planning.</h1>
				<p class="lede">Set a monthly budget per expense category and see it against what actually went out.</p>
			</div>
		</div>

		<div class="month-nav">
			<a href={`/finance/budget?month=${prevMonth}`} class="btn ghost small">← Prev</a>
			<span class="month-label">{monthLabel}</span>
			<a href={`/finance/budget?month=${nextMonth}`} class="btn ghost small">Next →</a>
		</div>

		{error && <p class="form-error">{error}</p>}

		{typedCategories.length ? (
			<div class="table-wrap">
				<table class="data-table">
					<thead>
						<tr>
							<th>Category</th>
							<th>Budgeted</th>
							<th>Actual</th>
							<th>Remaining</th>
						</tr>
					</thead>
					<tbody>
						{typedCategories.map((cat) => {
							const budgeted = Number(budgetByCategoryId.get(cat.id)?.amount ?? 0);
							const actual = actualByCategoryId.get(cat.id) ?? 0;
							const remaining = budgeted - actual;
							const pct = budgeted > 0 ? Math.min(100, Math.round((actual / budgeted) * 100)) : 0;
							return (
								<tr>
									<td class="cell-title">{cat.name}</td>
									<td>
										<form method="post" action="/api/finance/budgets/set" class="budget-form">
											<input type="hidden" name="category_id" value={cat.id} />
											<input type="hidden" name="month" value={month} />
											<input
												type="number"
												name="amount"
												step="0.01"
												min="0"
												value={budgeted || ''}
												placeholder="0.00"
											/>
											<button type="submit" class="btn ghost small">Save</button>
										</form>
									</td>
									<td class="cell-amount">{formatAmount(actual)}</td>
									<td>
										<div class="remaining-cell">
											<span class={remaining < 0 ? 'negative' : ''}>{formatAmount(remaining)}</span>
											{budgeted > 0 && (
												<div class="progress-bar">
													<div
														class={`progress-bar-fill ${actual > budgeted ? 'over' : ''}`}
														style={`width: ${pct}%`}
													/>
												</div>
											)}
										</div>
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>
		) : (
			<div class="empty-state">No expense categories yet. Add some from the Finance page first.</div>
		)}

		{totalBudgeted > 0 && (
			<div class="summary-bar">
				<div>
					<span class="summary-bar-label">Budgeted</span>
					<span class="summary-bar-value">{formatAmount(totalBudgeted)}</span>
				</div>
				<div>
					<span class="summary-bar-label">Spent</span>
					<span class="summary-bar-value">{formatAmount(totalActual)}</span>
				</div>
				<div>
					<span class="summary-bar-label">Remaining</span>
					<span class={`summary-bar-value ${totalBudgeted - totalActual < 0 ? 'negative' : 'positive'}`}>
						{formatAmount(totalBudgeted - totalActual)}
					</span>
				</div>
			</div>
		)}
	</section>
</Layout>

<style>
	.budget {
		max-width: 900px;
	}

	.back {
		display: inline-block;
		margin-bottom: 24px;
		color: var(--muted);
		text-decoration: none;
		font-size: 14px;
	}

	.back:hover {
		color: var(--ink);
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2rem, 5vw, 2.8rem);
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 54ch;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.month-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		margin-top: 32px;
	}

	.month-label {
		font-family: var(--serif);
		font-size: 18px;
		font-weight: 600;
		min-width: 180px;
		text-align: center;
	}

	.btn.ghost {
		display: inline-flex;
		align-items: center;
		height: 36px;
		padding: 0 16px;
		font-family: var(--sans);
		font-size: 13px;
		font-weight: 500;
		color: var(--ink);
		background: transparent;
		border: 1px solid var(--line);
		border-radius: 999px;
		cursor: pointer;
		text-decoration: none;
		transition: border-color 0.15s ease;
	}

	.btn.ghost:hover {
		border-color: var(--ink);
	}

	.btn.ghost.small {
		height: 30px;
		padding: 0 12px;
		font-size: 12px;
	}

	.table-wrap {
		margin-top: 28px;
		overflow-x: auto;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}

	.data-table th {
		text-align: left;
		padding: 12px 16px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		background: var(--canvas);
		white-space: nowrap;
	}

	.data-table td {
		padding: 12px 16px;
		border-bottom: 1px solid var(--line);
		vertical-align: middle;
	}

	.data-table tr:last-child td {
		border-bottom: none;
	}

	.cell-title {
		font-weight: 500;
		white-space: nowrap;
	}

	.cell-amount {
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.budget-form {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
	}

	.budget-form input[type='number'] {
		width: 100px;
		font-family: var(--sans);
		font-size: 14px;
		color: var(--ink);
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 8px;
		padding: 6px 10px;
		outline: none;
	}

	.budget-form input[type='number']:focus {
		border-color: var(--ink);
	}

	.remaining-cell {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 120px;
	}

	.remaining-cell .negative {
		color: #b4231f;
		font-weight: 500;
	}

	.progress-bar {
		height: 5px;
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 999px;
		overflow: hidden;
	}

	.progress-bar-fill {
		height: 100%;
		background: var(--ink);
	}

	.progress-bar-fill.over {
		background: #b4231f;
	}

	.empty-state {
		margin-top: 28px;
		padding: 32px;
		text-align: center;
		color: var(--muted);
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.summary-bar {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-top: 24px;
		padding: 20px 24px;
		background: var(--ink);
		color: #fff;
		border-radius: 14px;
		flex-wrap: wrap;
	}

	.summary-bar > div {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.summary-bar-label {
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.7;
	}

	.summary-bar-value {
		font-family: var(--serif);
		font-size: 20px;
		font-weight: 600;
	}

	.summary-bar-value.negative {
		color: #ff9b95;
	}

	.summary-bar-value.positive {
		color: #8fe0ac;
	}

	@media (max-width: 720px) {
		.month-nav {
			gap: 10px;
		}
		.month-label {
			min-width: 0;
			font-size: 15px;
		}
	}
</style>
