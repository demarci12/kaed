---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/finance';
import type { FinanceBudget, FinanceCategory, FinanceLimits, FinanceTransaction, FinanceType } from '../../lib/finance';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const monthParam = Astro.url.searchParams.get('month');
const monthValid = monthParam && /^\d{4}-\d{2}-01$/.test(monthParam);
const now = new Date();
const month = monthValid ? monthParam : `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-01`;

const monthDate = new Date(`${month}T00:00:00Z`);
const nextMonthDate = new Date(Date.UTC(monthDate.getUTCFullYear(), monthDate.getUTCMonth() + 1, 1));
const prevMonthDate = new Date(Date.UTC(monthDate.getUTCFullYear(), monthDate.getUTCMonth() - 1, 1));
const toMonthStr = (d: Date) => d.toISOString().slice(0, 10).replace(/\d{2}$/, '01');
const nextMonth = toMonthStr(nextMonthDate);
const prevMonth = toMonthStr(prevMonthDate);
const monthLabel = monthDate.toLocaleDateString(undefined, { year: 'numeric', month: 'long', timeZone: 'UTC' });

// Savings balance is a global, all-time running total (matches the card on
// the Finance page) -- not something that resets or gets "planned" per
// month the way income/expense do. Shown here for context only.
const [{ data: categories }, { data: budgets }, { data: transactions }, { data: allSavingTx }, { data: limits }] =
	await Promise.all([
		supabase.from('finance_categories').select('*').order('name', { ascending: true }),
		supabase.from('finance_budgets').select('*').eq('month', month),
		supabase.from('finance_transactions').select('*').gte('occurred_on', month).lt('occurred_on', nextMonth),
		supabase.from('finance_transactions').select('amount').eq('type', 'saving'),
		supabase.from('finance_limits').select('*').limit(1).maybeSingle(),
	]);
const startingSavingsBalance = Number((limits as FinanceLimits | null)?.starting_savings_balance ?? 0);
const globalSavingsBalance =
	startingSavingsBalance + (allSavingTx ?? []).reduce((sum, t) => sum + Number(t.amount), 0);

const typedCategories = (categories ?? []) as FinanceCategory[];
const typedBudgets = (budgets ?? []) as FinanceBudget[];
const typedTransactions = (transactions ?? []) as FinanceTransaction[];

const categoriesByType: Record<FinanceType, FinanceCategory[]> = {
	income: typedCategories.filter((c) => c.type === 'income'),
	expense: typedCategories.filter((c) => c.type === 'expense'),
	saving: typedCategories.filter((c) => c.type === 'saving'),
};

const budgetByCategoryId = new Map(typedBudgets.map((b) => [b.category_id, b]));
const actualByCategoryId = new Map<string, number>();
for (const t of typedTransactions) {
	if (!t.category_id) continue;
	actualByCategoryId.set(t.category_id, (actualByCategoryId.get(t.category_id) ?? 0) + Number(t.amount));
}

// A category's planned amount for this month: the saved finance_budgets
// row if one exists, otherwise the category's configured default -- so a
// fresh month shows the default plan pre-filled, editable, and only
// persisted once the user hits Save.
function budgetedFor(cat: FinanceCategory): number {
	const saved = budgetByCategoryId.get(cat.id)?.amount;
	return saved != null ? Number(saved) : Number(cat.default_amount ?? 0);
}

function totals(type: FinanceType) {
	const cats = categoriesByType[type];
	const budgeted = cats.reduce((sum, c) => sum + budgetedFor(c), 0);
	const actual = typedTransactions.filter((t) => t.type === type).reduce((sum, t) => sum + Number(t.amount), 0);
	return { budgeted, actual };
}

const incomeTotals = totals('income');
const expenseTotals = totals('expense');
const savingTotals = totals('saving');

// Projected balance if the plan is followed exactly, and the actual
// position so far based on what's really been logged this month.
const plannedEndOfMonth = incomeTotals.budgeted - expenseTotals.budgeted - savingTotals.budgeted;
const actualSoFar = incomeTotals.actual - expenseTotals.actual - savingTotals.actual;

// Weekly/daily equivalents of a monthly amount. Weeks-in-month is
// approximate (days / 7) since months don't divide evenly into weeks.
const daysInMonth = new Date(Date.UTC(monthDate.getUTCFullYear(), monthDate.getUTCMonth() + 1, 0)).getUTCDate();
const weeksInMonth = daysInMonth / 7;
const toWeekly = (n: number) => n / weeksInMonth;
const toDaily = (n: number) => n / daysInMonth;

function formatAmount(n: number) {
	return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const sectionLabel: Record<FinanceType, string> = { income: 'Income', expense: 'Expense', saving: 'Saving' };
const error = Astro.url.searchParams.get('error');

// Projected savings balance if this month's planned saving amount is kept
// up every month going forward, starting from today's global balance,
// compounding at a blended monthly interest rate across saving categories
// (weighted by each category's planned monthly amount).
const savingCategories = categoriesByType.saving;
const savingWeightedRateSum = savingCategories.reduce(
	(sum, c) => sum + budgetedFor(c) * Number(c.interest_rate ?? 0),
	0,
);
const savingContributionSum = savingCategories.reduce((sum, c) => sum + budgetedFor(c), 0);
const blendedMonthlyRatePct = savingContributionSum > 0 ? savingWeightedRateSum / savingContributionSum : 0;
const blendedMonthlyRate = blendedMonthlyRatePct / 100;

const projectionMonths = [1, 3, 6, 12, 24];
const projections = projectionMonths.map((months) => {
	const P = globalSavingsBalance;
	const C = savingTotals.budgeted;
	const r = blendedMonthlyRate;
	const balance =
		r === 0
			? P + C * months
			: P * Math.pow(1 + r, months) + C * ((Math.pow(1 + r, months) - 1) / r);
	return { months, balance };
});
---

<Layout user={auth.user}>
	<section class="budget max-w-[900px]">
		<a class="back" href="/finance">← Finance</a>

		<div class="page-head">
			<div>
				<p class="eyebrow">Household</p>
				<h1>Budget planning.</h1>
				<p class="lede">
					Plan income, spending, and saving for the month together, and see what's left over if you
					stick to it.
				</p>
			</div>
		</div>

		<div class="month-nav flex items-center justify-center gap-2.5 md:gap-5 mt-8">
			<a href={`/finance/budget?month=${prevMonth}`} class="btn ghost small">← Prev</a>
			<span class="month-label font-serif text-[15px] md:text-lg font-semibold min-w-0 md:min-w-[180px] text-center">{monthLabel}</span>
			<a href={`/finance/budget?month=${nextMonth}`} class="btn ghost small">Next →</a>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="summary-bar flex justify-between gap-4 flex-wrap mt-7 px-6 py-5 bg-ink text-white rounded-[14px]">
			<div class="flex flex-col gap-1">
				<span class="summary-bar-label text-[11px] tracking-[0.06em] uppercase opacity-70">Planned income</span>
				<span class="summary-bar-value font-serif text-xl font-semibold">{formatAmount(incomeTotals.budgeted)}</span>
			</div>
			<div class="flex flex-col gap-1">
				<span class="summary-bar-label text-[11px] tracking-[0.06em] uppercase opacity-70">Planned expense</span>
				<span class="summary-bar-value font-serif text-xl font-semibold">{formatAmount(expenseTotals.budgeted)}</span>
			</div>
			<div class="flex flex-col gap-1">
				<span class="summary-bar-label text-[11px] tracking-[0.06em] uppercase opacity-70">Planned saving</span>
				<span class="summary-bar-value font-serif text-xl font-semibold">{formatAmount(savingTotals.budgeted)}</span>
			</div>
			<div class="flex flex-col gap-1">
				<span class="summary-bar-label text-[11px] tracking-[0.06em] uppercase opacity-70">End-of-month balance</span>
				<span class={`summary-bar-value font-serif text-[26px] font-semibold ${plannedEndOfMonth < 0 ? 'text-[#ff9b95]' : 'text-[#8fe0ac]'}`}>
					{formatAmount(plannedEndOfMonth)}
				</span>
			</div>
		</div>

		<div class="sub-summary flex gap-8 flex-wrap mt-4 px-1">
			<div class="flex flex-col gap-0.5">
				<span class="sub-summary-label text-[11px] tracking-[0.06em] uppercase text-muted">Actual so far this month</span>
				<span class={`sub-summary-value font-serif text-base font-semibold ${actualSoFar < 0 ? 'text-negative' : 'text-positive'}`}>{formatAmount(actualSoFar)}</span>
			</div>
			<div class="flex flex-col gap-0.5">
				<span class="sub-summary-label text-[11px] tracking-[0.06em] uppercase text-muted">Global savings balance</span>
				<span class="sub-summary-value font-serif text-base font-semibold text-info">{formatAmount(globalSavingsBalance)}</span>
			</div>
		</div>

		<div class="type-section mt-10">
			<h2 class="m-0 mb-3.5 font-serif text-lg font-semibold">If you keep this plan</h2>
			{savingTotals.budgeted > 0 ? (
				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>In</th>
								<th>Projected savings balance</th>
							</tr>
						</thead>
						<tbody>
							{projections.map((p) => (
								<tr>
									<td class="cell-title font-medium whitespace-nowrap">{p.months === 1 ? 'End of this month' : `${p.months} months`}</td>
									<td class="cell-amount">{formatAmount(p.balance)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			) : (
				<div class="empty-state p-6 text-center text-muted border border-line rounded-[14px] bg-paper">Set a planned saving amount above to see a projection.</div>
			)}
			<p class="projection-note mt-3.5 mx-1 mb-0 text-[13px] text-muted">
				Starting from today's balance of {formatAmount(globalSavingsBalance)}, assuming you keep saving{' '}
				{formatAmount(savingTotals.budgeted)} every month
				{blendedMonthlyRate > 0 ? ` at a blended ${blendedMonthlyRatePct.toFixed(2)}%/mo return.` : '.'}
			</p>
		</div>

		{(['income', 'expense', 'saving'] as FinanceType[]).map((type) => (
			<div class="type-section mt-10">
				<h2 class="m-0 mb-3.5 font-serif text-lg font-semibold">{sectionLabel[type]}</h2>
				{categoriesByType[type].length ? (
					<div class="table-wrap">
						<table class="data-table">
							<thead>
								<tr>
									<th>Category</th>
									<th>Planned / month</th>
									<th>≈ / week</th>
									<th>≈ / day</th>
									<th>Actual</th>
									<th>{type === 'expense' ? 'Remaining' : 'Difference'}</th>
								</tr>
							</thead>
							<tbody>
								{categoriesByType[type].map((cat) => {
									const budgeted = budgetedFor(cat);
									const actual = actualByCategoryId.get(cat.id) ?? 0;
									const remaining = type === 'expense' ? budgeted - actual : actual - budgeted;
									const pct = budgeted > 0 ? Math.min(100, Math.round((actual / budgeted) * 100)) : 0;
									return (
										<tr>
											<td class="cell-title font-medium whitespace-nowrap">{cat.name}</td>
											<td>
												<form method="post" action="/api/finance/budgets/set" class="budget-form flex items-center gap-2 m-0">
													<input type="hidden" name="category_id" value={cat.id} />
													<input type="hidden" name="month" value={month} />
													<input type="number" name="amount" step="0.01" min="0" value={budgeted || ''} placeholder="0.00" class="w-[100px] font-sans text-base text-ink bg-canvas border border-line rounded-lg px-2.5 py-1.5 outline-none focus:border-ink" />
													<button type="submit" class="btn ghost small">Save</button>
												</form>
											</td>
											<td class="cell-amount cell-muted">{budgeted > 0 ? formatAmount(toWeekly(budgeted)) : '—'}</td>
											<td class="cell-amount cell-muted">{budgeted > 0 ? formatAmount(toDaily(budgeted)) : '—'}</td>
											<td class="cell-amount">{formatAmount(actual)}</td>
											<td>
												<div class="remaining-cell flex flex-col gap-1.5 min-w-[120px]">
													<span class={type === 'expense' && remaining < 0 ? 'text-negative font-medium' : ''}>{formatAmount(remaining)}</span>
													{budgeted > 0 && (
														<div class="progress-bar h-[5px] bg-canvas border border-line rounded-full overflow-hidden">
															<div
																class={`progress-bar-fill h-full ${type === 'expense' && actual > budgeted ? 'bg-negative' : 'bg-ink'}`}
																style={`width: ${pct}%`}
															/>
														</div>
													)}
												</div>
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				) : (
					<div class="empty-state p-6 text-center text-muted border border-line rounded-[14px] bg-paper">No {sectionLabel[type].toLowerCase()} categories yet. Add some from the Finance page.</div>
				)}
			</div>
		))}
	</section>
</Layout>

