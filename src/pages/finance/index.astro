---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/finance';
import type { FinanceBudget, FinanceCategory, FinanceLimits, FinanceTransaction } from '../../lib/finance';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const currentMonth = `${new Date().getFullYear()}-${String(new Date().getMonth() + 1).padStart(2, '0')}-01`;

const [{ data: transactions }, { data: categories }, { data: currentBudgets }, { data: limits }] = await Promise.all([
	supabase
		.from('finance_transactions')
		.select('*')
		.order('occurred_on', { ascending: false })
		.order('created_at', { ascending: false }),
	supabase.from('finance_categories').select('*').order('name', { ascending: true }),
	supabase.from('finance_budgets').select('*').eq('month', currentMonth),
	supabase.from('finance_limits').select('*').limit(1).maybeSingle(),
]);

const typedTransactions = (transactions ?? []) as FinanceTransaction[];
const typedCategories = (categories ?? []) as FinanceCategory[];
const typedBudgets = (currentBudgets ?? []) as FinanceBudget[];
const startingSavingsBalance = Number((limits as FinanceLimits | null)?.starting_savings_balance ?? 0);

const categoryById = new Map(typedCategories.map((c) => [c.id, c]));
const incomeCategories = typedCategories.filter((c) => c.type === 'income');
const expenseCategories = typedCategories.filter((c) => c.type === 'expense');
const savingCategories = typedCategories.filter((c) => c.type === 'saving');

// Daily/weekly limits come from budget planning's total planned expense for
// the current month, not a separately-entered number -- plan it once on
// /finance/budget and both views stay in sync.
const expenseCategoryIds = new Set(expenseCategories.map((c) => c.id));
const plannedExpenseThisMonth = typedBudgets
	.filter((b) => expenseCategoryIds.has(b.category_id))
	.reduce((sum, b) => sum + Number(b.amount), 0);

const now0 = new Date();
const daysInMonth = new Date(now0.getFullYear(), now0.getMonth() + 1, 0).getDate();
const weeksInMonth = daysInMonth / 7;
const dailyLimit = plannedExpenseThisMonth > 0 ? plannedExpenseThisMonth / daysInMonth : null;
const weeklyLimit = plannedExpenseThisMonth > 0 ? plannedExpenseThisMonth / weeksInMonth : null;

const totalIncome = typedTransactions
	.filter((t) => t.type === 'income')
	.reduce((sum, t) => sum + Number(t.amount), 0);
const totalExpense = typedTransactions
	.filter((t) => t.type === 'expense')
	.reduce((sum, t) => sum + Number(t.amount), 0);
const totalSaving =
	startingSavingsBalance +
	typedTransactions.filter((t) => t.type === 'saving').reduce((sum, t) => sum + Number(t.amount), 0);
const balance = totalIncome - totalExpense;

// Today (local date) and this ISO week (Monday..Sunday) spend, for the
// daily/weekly limit panel.
const todayStr = new Date().toISOString().slice(0, 10);
const now = new Date();
const dayOfWeek = (now.getDay() + 6) % 7; // 0 = Monday
const monday = new Date(now);
monday.setDate(now.getDate() - dayOfWeek);
const mondayStr = monday.toISOString().slice(0, 10);

const spentToday = typedTransactions
	.filter((t) => t.type === 'expense' && t.occurred_on === todayStr)
	.reduce((sum, t) => sum + Number(t.amount), 0);
const spentThisWeek = typedTransactions
	.filter((t) => t.type === 'expense' && t.occurred_on >= mondayStr && t.occurred_on <= todayStr)
	.reduce((sum, t) => sum + Number(t.amount), 0);

const dailyRemaining = dailyLimit != null ? dailyLimit - spentToday : null;
const weeklyRemaining = weeklyLimit != null ? weeklyLimit - spentThisWeek : null;

function formatAmount(n: number) {
	return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="finance">
		<div class="page-head">
			<div>
				<p class="eyebrow">Household</p>
				<h1>Finance.</h1>
				<p class="lede">Shared income and spending — every transaction visible to both of you.</p>
			</div>
			<div class="page-head-actions">
				<a href="/finance/budget" class="btn ghost">Budget planning →</a>
				<a href="/finance/settings" class="btn ghost">Settings</a>
				<button type="button" class="btn ghost disabled" disabled aria-disabled="true">
					Statistics <span class="soon-badge">Soon</span>
				</button>
				<button type="button" class="btn" data-open-popup="new-transaction">+ Add transaction</button>
			</div>
		</div>

		{error && <p class="form-error">{error}</p>}

		<form method="post" action="/api/finance/transactions/create" class="quick-add-bar" id="quick-add-form">
			<input type="hidden" name="type" id="quick-add-type" value="expense" />
			<select id="quick-add-category" name="category_id" required>
				<optgroup label="Income">
					{incomeCategories.map((c) => <option value={c.id} data-type="income">{c.name}</option>)}
				</optgroup>
				<optgroup label="Expense">
					{expenseCategories.map((c) => <option value={c.id} data-type="expense">{c.name}</option>)}
				</optgroup>
				<optgroup label="Saving">
					{savingCategories.map((c) => <option value={c.id} data-type="saving">{c.name}</option>)}
				</optgroup>
			</select>
			<input type="number" name="amount" step="0.01" min="0.01" required placeholder="Amount" />
			<button type="submit" class="btn">Add</button>
		</form>

		<div class="summary-cards">
			<div class="summary-card">
				<span class="summary-label">Balance</span>
				<span class={`summary-value ${balance >= 0 ? '' : 'negative'}`}>{formatAmount(balance)}</span>
			</div>
			<div class="summary-card">
				<span class="summary-label">Total income</span>
				<span class="summary-value positive">{formatAmount(totalIncome)}</span>
			</div>
			<div class="summary-card">
				<span class="summary-label">Total spending</span>
				<span class="summary-value negative">{formatAmount(totalExpense)}</span>
			</div>
			<div class="summary-card">
				<span class="summary-label">Savings balance</span>
				<span class="summary-value saving">{formatAmount(totalSaving)}</span>
			</div>
		</div>

		<div class="limits-panel">
			<div class="limits-head">
				<h2>Spending limits</h2>
				<a href="/finance/budget" class="link-btn">From budget plan →</a>
			</div>
			<div class="limits-cards">
				<div class="limit-card">
					<span class="summary-label">Today</span>
					{dailyLimit != null ? (
						<>
							<span class={`summary-value ${dailyRemaining! < 0 ? 'negative' : 'positive'}`}>
								{formatAmount(dailyRemaining!)} left
							</span>
							<span class="limit-sub">{formatAmount(spentToday)} of {formatAmount(dailyLimit)}</span>
							<div class="progress-bar">
								<div
									class={`progress-bar-fill ${spentToday > dailyLimit ? 'over' : ''}`}
									style={`width: ${Math.min(100, Math.round((spentToday / dailyLimit) * 100))}%`}
								/>
							</div>
						</>
					) : (
						<span class="limit-sub">No expense budget planned this month yet. {formatAmount(spentToday)} spent today.</span>
					)}
				</div>
				<div class="limit-card">
					<span class="summary-label">This week</span>
					{weeklyLimit != null ? (
						<>
							<span class={`summary-value ${weeklyRemaining! < 0 ? 'negative' : 'positive'}`}>
								{formatAmount(weeklyRemaining!)} left
							</span>
							<span class="limit-sub">{formatAmount(spentThisWeek)} of {formatAmount(weeklyLimit)}</span>
							<div class="progress-bar">
								<div
									class={`progress-bar-fill ${spentThisWeek > weeklyLimit ? 'over' : ''}`}
									style={`width: ${Math.min(100, Math.round((spentThisWeek / weeklyLimit) * 100))}%`}
								/>
							</div>
						</>
					) : (
						<span class="limit-sub">No expense budget planned this month yet. {formatAmount(spentThisWeek)} spent this week.</span>
					)}
				</div>
			</div>
		</div>

		<div class="table-wrap">
			<table class="data-table">
				<thead>
					<tr>
						<th>Date</th>
						<th>Type</th>
						<th>Category</th>
						<th>Note</th>
						<th>Amount</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{typedTransactions.length ? (
						typedTransactions.map((t) => (
							<tr>
								<td class="cell-date">{t.occurred_on}</td>
								<td>
									<span class={`pill pill-${t.type}`}>
									{t.type === 'income' ? 'Income' : t.type === 'saving' ? 'Saving' : 'Expense'}
								</span>
								</td>
								<td class="cell-muted">{t.category_id ? categoryById.get(t.category_id)?.name ?? '—' : '—'}</td>
								<td class="cell-muted">{t.note ?? '—'}</td>
								<td class={`cell-amount ${t.type === 'income' ? 'positive' : t.type === 'saving' ? 'saving' : 'negative'}`}>
									{t.type === 'expense' ? '−' : '+'}
									{formatAmount(Number(t.amount))}
								</td>
								<td class="cell-actions">
									<form method="post" action={`/api/finance/transactions/${t.id}/delete`}>
										<button type="submit" class="row-delete" aria-label="Delete transaction">×</button>
									</form>
								</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="6" class="empty-cell">No transactions yet. Add your first one.</td>
						</tr>
					)}
				</tbody>
			</table>
		</div>
	</section>

	<dialog id="new-transaction" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Add transaction</h2>
		<form method="post" action="/api/finance/transactions/create">
			<label for="type">Type</label>
			<select id="type" name="type" required>
				<option value="expense">Expense</option>
				<option value="income">Income</option>
				<option value="saving">Saving</option>
			</select>

			<label for="amount">Amount</label>
			<input id="amount" name="amount" type="number" step="0.01" min="0.01" required />

			<label for="category_id">Category</label>
			<select id="category_id" name="category_id">
				<option value="">No category</option>
				<optgroup label="Income">
					{incomeCategories.map((c) => <option value={c.id}>{c.name}</option>)}
				</optgroup>
				<optgroup label="Expense">
					{expenseCategories.map((c) => <option value={c.id}>{c.name}</option>)}
				</optgroup>
				<optgroup label="Saving">
					{savingCategories.map((c) => <option value={c.id}>{c.name}</option>)}
				</optgroup>
			</select>

			<label for="occurred_on">Date</label>
			<input id="occurred_on" name="occurred_on" type="date" />

			<label for="note">Note</label>
			<input id="note" name="note" type="text" maxlength="200" placeholder="Optional" />

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Add</button>
			</div>
		</form>
	</dialog>

</Layout>

<script>
	const quickAddForm = document.getElementById('quick-add-form') as HTMLFormElement | null;
	const quickAddCategory = document.getElementById('quick-add-category') as HTMLSelectElement | null;
	const quickAddType = document.getElementById('quick-add-type') as HTMLInputElement | null;

	quickAddForm?.addEventListener('submit', () => {
		if (!quickAddCategory || !quickAddType) return;
		const selected = quickAddCategory.selectedOptions[0];
		const type = selected?.getAttribute('data-type');
		if (type) quickAddType.value = type;
	});
</script>

<style>
	.finance {
		max-width: 1080px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.page-head-actions {
		display: flex;
		gap: 10px;
		flex-shrink: 0;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 54ch;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.summary-cards {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		margin-top: 32px;
	}

	.summary-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 20px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.summary-label {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.summary-value {
		font-family: var(--serif);
		font-size: 28px;
		font-weight: 600;
	}

	.summary-value.positive {
		color: #1f7a3d;
	}

	.summary-value.negative {
		color: #b4231f;
	}

	.summary-value.saving {
		color: #1d4ed8;
	}

	.limits-panel {
		margin-top: 24px;
		padding: 20px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.limits-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.limits-head h2 {
		margin: 0;
		font-family: var(--serif);
		font-size: 16px;
		font-weight: 600;
	}

	.link-btn {
		background: none;
		border: none;
		padding: 0;
		font-family: var(--sans);
		font-size: 13px;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		cursor: pointer;
	}

	.link-btn:hover {
		color: var(--ink);
		border-color: var(--ink);
	}

	.limits-cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
		margin-top: 16px;
	}

	.limit-card {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.limit-sub {
		font-size: 13px;
		color: var(--muted);
	}

	.limit-card .progress-bar {
		height: 5px;
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 999px;
		overflow: hidden;
		margin-top: 2px;
	}

	.limit-card .progress-bar-fill {
		height: 100%;
		background: var(--ink);
	}

	.limit-card .progress-bar-fill.over {
		background: #b4231f;
	}

	.table-wrap {
		margin-top: 32px;
		overflow-x: auto;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}

	.data-table th {
		text-align: left;
		padding: 12px 16px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		background: var(--canvas);
		white-space: nowrap;
	}

	.data-table td {
		padding: 12px 16px;
		border-bottom: 1px solid var(--line);
		vertical-align: middle;
		white-space: nowrap;
	}

	.data-table tr:last-child td {
		border-bottom: none;
	}

	.cell-muted {
		color: var(--muted);
	}

	.cell-date {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.cell-amount {
		font-variant-numeric: tabular-nums;
		font-weight: 500;
		text-align: right;
	}

	.cell-amount.positive {
		color: #1f7a3d;
	}

	.cell-amount.negative {
		color: #b4231f;
	}

	.cell-amount.saving {
		color: #1d4ed8;
	}

	.cell-actions {
		text-align: right;
	}

	.cell-actions form {
		margin: 0;
		display: inline-block;
	}

	.row-delete {
		width: 22px;
		height: 22px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		font-size: 15px;
		line-height: 1;
		cursor: pointer;
	}

	.row-delete:hover {
		border-color: var(--line);
		color: #b4231f;
	}

	.pill {
		padding: 3px 10px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 500;
		white-space: nowrap;
	}

	.pill-income {
		background: #eafaf0;
		color: #1f7a3d;
	}

	.pill-expense {
		background: #fbf0ef;
		color: #b4231f;
	}

	.pill-saving {
		background: #eef4ff;
		color: #1d4ed8;
	}

	.empty-cell {
		padding: 32px 16px;
		text-align: center;
		color: var(--muted);
		white-space: normal;
	}

	.btn.ghost.disabled,
	.btn.ghost:disabled {
		opacity: 0.45;
		cursor: not-allowed;
		pointer-events: none;
	}

	.soon-badge {
		margin-left: 6px;
		padding: 1px 7px;
		border-radius: 999px;
		background: var(--canvas);
		border: 1px solid var(--line);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.quick-add-bar {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 24px;
		padding: 12px 16px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--paper);
	}

	.quick-add-bar select,
	.quick-add-bar input[type='number'] {
		font-family: var(--sans);
		font-size: 14px;
		color: var(--ink);
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 8px;
		padding: 8px 10px;
		outline: none;
	}

	.quick-add-bar select {
		flex: 2;
		min-width: 0;
	}

	.quick-add-bar input[type='number'] {
		flex: 1;
		min-width: 0;
	}

	.quick-add-bar select:focus,
	.quick-add-bar input[type='number']:focus {
		border-color: var(--ink);
	}

	@media (max-width: 720px) {
		.page-head {
			flex-direction: column;
			align-items: stretch;
		}
		.page-head-actions {
			flex-wrap: wrap;
		}
		.summary-cards {
			grid-template-columns: 1fr;
		}
		.quick-add-bar {
			flex-wrap: wrap;
		}
	}
</style>
