---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/finance';
import { isMember } from '../../lib/auth';
import type { FinanceBudget, FinanceCategory, FinanceLimits, FinanceTransaction } from '../../lib/finance';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;
// Investments are the owner's alone; the shared member role never sees the link.
const isOwner = !isMember(auth.user);

const currentMonth = `${new Date().getFullYear()}-${String(new Date().getMonth() + 1).padStart(2, '0')}-01`;

const [{ data: transactions }, { data: categories }, { data: currentBudgets }, { data: limits }] = await Promise.all([
	supabase
		.from('finance_transactions')
		.select('*')
		.order('occurred_on', { ascending: false })
		.order('created_at', { ascending: false }),
	supabase.from('finance_categories').select('*').order('name', { ascending: true }),
	supabase.from('finance_budgets').select('*').eq('month', currentMonth),
	supabase.from('finance_limits').select('*').limit(1).maybeSingle(),
]);

const typedTransactions = (transactions ?? []) as FinanceTransaction[];
const typedCategories = (categories ?? []) as FinanceCategory[];
const typedBudgets = (currentBudgets ?? []) as FinanceBudget[];
const startingSavingsBalance = Number((limits as FinanceLimits | null)?.starting_savings_balance ?? 0);

const categoryById = new Map(typedCategories.map((c) => [c.id, c]));
const incomeCategories = typedCategories.filter((c) => c.type === 'income');
const expenseCategories = typedCategories.filter((c) => c.type === 'expense');
const savingCategories = typedCategories.filter((c) => c.type === 'saving');

// Daily/weekly limits come from budget planning's total planned expense for
// the current month, not a separately-entered number -- plan it once on
// /finance/budget and both views stay in sync.
const expenseCategoryIds = new Set(expenseCategories.map((c) => c.id));
const plannedExpenseThisMonth = typedBudgets
	.filter((b) => expenseCategoryIds.has(b.category_id))
	.reduce((sum, b) => sum + Number(b.amount), 0);

const now0 = new Date();
const daysInMonth = new Date(now0.getFullYear(), now0.getMonth() + 1, 0).getDate();
const weeksInMonth = daysInMonth / 7;
const dailyLimit = plannedExpenseThisMonth > 0 ? plannedExpenseThisMonth / daysInMonth : null;
const weeklyLimit = plannedExpenseThisMonth > 0 ? plannedExpenseThisMonth / weeksInMonth : null;

const totalIncome = typedTransactions
	.filter((t) => t.type === 'income')
	.reduce((sum, t) => sum + Number(t.amount), 0);
const totalExpense = typedTransactions
	.filter((t) => t.type === 'expense')
	.reduce((sum, t) => sum + Number(t.amount), 0);
const totalSaving =
	startingSavingsBalance +
	typedTransactions.filter((t) => t.type === 'saving').reduce((sum, t) => sum + Number(t.amount), 0);
const balance = totalIncome - totalExpense;

// Today (local date) and this ISO week (Monday..Sunday) spend, for the
// daily/weekly limit panel.
const todayStr = new Date().toISOString().slice(0, 10);
const now = new Date();
const dayOfWeek = (now.getDay() + 6) % 7; // 0 = Monday
const monday = new Date(now);
monday.setDate(now.getDate() - dayOfWeek);
const mondayStr = monday.toISOString().slice(0, 10);

const spentToday = typedTransactions
	.filter((t) => t.type === 'expense' && t.occurred_on === todayStr)
	.reduce((sum, t) => sum + Number(t.amount), 0);
const spentThisWeek = typedTransactions
	.filter((t) => t.type === 'expense' && t.occurred_on >= mondayStr && t.occurred_on <= todayStr)
	.reduce((sum, t) => sum + Number(t.amount), 0);
const spentThisMonth = typedTransactions
	.filter((t) => t.type === 'expense' && t.occurred_on >= currentMonth && t.occurred_on <= todayStr)
	.reduce((sum, t) => sum + Number(t.amount), 0);

const dailyRemaining = dailyLimit != null ? dailyLimit - spentToday : null;
const weeklyRemaining = weeklyLimit != null ? weeklyLimit - spentThisWeek : null;
const monthlyRemaining = plannedExpenseThisMonth > 0 ? plannedExpenseThisMonth - spentThisMonth : null;

function formatAmount(n: number) {
	return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="finance max-w-[1080px]">
		<div class="page-head flex-col items-stretch md:flex-row md:items-center">
			<div>
				<p class="eyebrow">Household</p>
				<h1>Finance.</h1>
				<p class="lede">Shared income and spending — every transaction visible to both of you.</p>
			</div>
			<div class="page-head-actions shrink-0">
				<a href="/finance/budget" class="btn ghost">Budget planning →</a>
				{isOwner && <a href="/finance/investments" class="btn ghost">Investments →</a>}
				<a href="/finance/settings" class="btn ghost">Settings</a>
				<button type="button" class="btn ghost disabled opacity-45 cursor-not-allowed pointer-events-none" disabled aria-disabled="true">
					Statistics <span class="soon-badge ml-1.5 px-[7px] py-px rounded-full bg-canvas border border-line text-[10px] font-semibold tracking-[0.04em] uppercase text-muted">Soon</span>
				</button>
				<button type="button" class="btn" data-open-popup="new-transaction">+ Add transaction</button>
			</div>
		</div>

		{error && <p class="form-error">{error}</p>}

		<form method="post" action="/api/finance/transactions/create" class="quick-add-bar flex flex-wrap md:flex-nowrap items-center gap-2.5 mt-6 px-4 py-3 border border-line rounded-xl bg-paper" id="quick-add-form">
			<input type="hidden" name="type" id="quick-add-type" value="expense" />
			<select id="quick-add-category" name="category_id" required class="flex-[2] min-w-0 font-sans text-base text-ink bg-canvas border border-line rounded-lg px-2.5 py-2 outline-none focus:border-ink">
				<optgroup label="Income">
					{incomeCategories.map((c) => <option value={c.id} data-type="income">{c.name}</option>)}
				</optgroup>
				<optgroup label="Expense">
					{expenseCategories.map((c) => <option value={c.id} data-type="expense">{c.name}</option>)}
				</optgroup>
				<optgroup label="Saving">
					{savingCategories.map((c) => <option value={c.id} data-type="saving">{c.name}</option>)}
				</optgroup>
			</select>
			<input type="number" name="amount" step="0.01" min="0.01" required placeholder="Amount" class="flex-1 min-w-0 font-sans text-base text-ink bg-canvas border border-line rounded-lg px-2.5 py-2 outline-none focus:border-ink" />
			<button type="submit" class="btn">Add</button>
		</form>

		<div class="summary-cards grid grid-cols-1 md:grid-cols-4 gap-4 mt-8">
			<div class="summary-card flex flex-col gap-2 p-5 border border-line rounded-[14px] bg-paper">
				<span class="summary-label text-xs font-semibold tracking-[0.06em] uppercase text-muted">Balance</span>
				<span class={`summary-value font-serif text-[28px] font-semibold ${balance >= 0 ? '' : 'text-negative'}`}>{formatAmount(balance)}</span>
			</div>
			<div class="summary-card flex flex-col gap-2 p-5 border border-line rounded-[14px] bg-paper">
				<span class="summary-label text-xs font-semibold tracking-[0.06em] uppercase text-muted">Total income</span>
				<span class="summary-value font-serif text-[28px] font-semibold text-positive">{formatAmount(totalIncome)}</span>
			</div>
			<div class="summary-card flex flex-col gap-2 p-5 border border-line rounded-[14px] bg-paper">
				<span class="summary-label text-xs font-semibold tracking-[0.06em] uppercase text-muted">Total spending</span>
				<span class="summary-value font-serif text-[28px] font-semibold text-negative">{formatAmount(totalExpense)}</span>
			</div>
			<div class="summary-card flex flex-col gap-2 p-5 border border-line rounded-[14px] bg-paper">
				<span class="summary-label text-xs font-semibold tracking-[0.06em] uppercase text-muted">Savings balance</span>
				<span class="summary-value font-serif text-[28px] font-semibold text-info">{formatAmount(totalSaving)}</span>
			</div>
			<div class="summary-card flex flex-col gap-2 p-5 border border-line rounded-[14px] bg-paper">
				<span class="summary-label text-xs font-semibold tracking-[0.06em] uppercase text-muted">Remaining this month</span>
				{monthlyRemaining != null ? (
					<span class={`summary-value font-serif text-[28px] font-semibold ${monthlyRemaining < 0 ? 'text-negative' : 'text-positive'}`}>
						{formatAmount(monthlyRemaining)}
					</span>
				) : (
					<span class="summary-value font-sans text-sm font-medium text-muted">No expense budget planned</span>
				)}
			</div>
		</div>

		<div class="limits-panel mt-6 p-5 border border-line rounded-[14px] bg-paper">
			<div class="limits-head flex items-center justify-between">
				<h2 class="m-0 font-serif text-base font-semibold">Spending limits</h2>
				<a href="/finance/budget" class="link-btn bg-transparent border-0 border-b border-line p-0 font-sans text-[13px] text-muted cursor-pointer hover:text-ink hover:border-ink">From budget plan →</a>
			</div>
			<div class="limits-cards grid grid-cols-1 md:grid-cols-2 gap-5 mt-4">
				<div class="limit-card flex flex-col gap-1.5">
					<span class="summary-label text-xs font-semibold tracking-[0.06em] uppercase text-muted">Today</span>
					{dailyLimit != null ? (
						<>
							<span class={`summary-value font-serif text-[28px] font-semibold ${dailyRemaining! < 0 ? 'text-negative' : 'text-positive'}`}>
								{formatAmount(dailyRemaining!)} left
							</span>
							<span class="limit-sub text-[13px] text-muted">{formatAmount(spentToday)} of {formatAmount(dailyLimit)}</span>
							<div class="progress-bar h-[5px] bg-canvas border border-line rounded-full overflow-hidden mt-0.5">
								<div
									class={`progress-bar-fill h-full ${spentToday > dailyLimit ? 'bg-negative' : 'bg-ink'}`}
									style={`width: ${Math.min(100, Math.round((spentToday / dailyLimit) * 100))}%`}
								/>
							</div>
						</>
					) : (
						<span class="limit-sub text-[13px] text-muted">No expense budget planned this month yet. {formatAmount(spentToday)} spent today.</span>
					)}
				</div>
				<div class="limit-card flex flex-col gap-1.5">
					<span class="summary-label text-xs font-semibold tracking-[0.06em] uppercase text-muted">This week</span>
					{weeklyLimit != null ? (
						<>
							<span class={`summary-value font-serif text-[28px] font-semibold ${weeklyRemaining! < 0 ? 'text-negative' : 'text-positive'}`}>
								{formatAmount(weeklyRemaining!)} left
							</span>
							<span class="limit-sub text-[13px] text-muted">{formatAmount(spentThisWeek)} of {formatAmount(weeklyLimit)}</span>
							<div class="progress-bar h-[5px] bg-canvas border border-line rounded-full overflow-hidden mt-0.5">
								<div
									class={`progress-bar-fill h-full ${spentThisWeek > weeklyLimit ? 'bg-negative' : 'bg-ink'}`}
									style={`width: ${Math.min(100, Math.round((spentThisWeek / weeklyLimit) * 100))}%`}
								/>
							</div>
						</>
					) : (
						<span class="limit-sub text-[13px] text-muted">No expense budget planned this month yet. {formatAmount(spentThisWeek)} spent this week.</span>
					)}
				</div>
			</div>
		</div>

		<div class="table-wrap mt-8">
			<table class="data-table">
				<thead>
					<tr>
						<th>Date</th>
						<th>Type</th>
						<th>Category</th>
						<th>Note</th>
						<th>Amount</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{typedTransactions.length ? (
						typedTransactions.map((t) => (
							<tr>
								<td class="cell-date whitespace-nowrap">{t.occurred_on}</td>
								<td class="whitespace-nowrap">
									<span class={`pill pill-${t.type}`}>
									{t.type === 'income' ? 'Income' : t.type === 'saving' ? 'Saving' : 'Expense'}
								</span>
								</td>
								<td class="cell-muted whitespace-nowrap">{t.category_id ? categoryById.get(t.category_id)?.name ?? '—' : '—'}</td>
								<td class="cell-muted whitespace-nowrap">{t.note ?? '—'}</td>
								<td class={`cell-amount whitespace-nowrap font-medium text-right ${t.type === 'income' ? 'text-positive' : t.type === 'saving' ? 'text-info' : 'text-negative'}`}>
									{t.type === 'expense' ? '−' : '+'}
									{formatAmount(Number(t.amount))}
								</td>
								<td class="cell-actions whitespace-nowrap text-right">
									<form method="post" action={`/api/finance/transactions/${t.id}/delete`} class="m-0 inline-block">
										<button type="submit" class="row-delete w-[22px] h-[22px] inline-flex items-center justify-center rounded-full border border-transparent bg-transparent text-muted text-[15px] leading-none cursor-pointer hover:border-line hover:text-negative" aria-label="Delete transaction">×</button>
									</form>
								</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="6" class="empty-cell whitespace-normal">No transactions yet. Add your first one.</td>
						</tr>
					)}
				</tbody>
			</table>
		</div>
	</section>

	<dialog id="new-transaction" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Add transaction</h2>
		<form method="post" action="/api/finance/transactions/create">
			<label for="type">Type</label>
			<select id="type" name="type" required>
				<option value="expense">Expense</option>
				<option value="income">Income</option>
				<option value="saving">Saving</option>
			</select>

			<label for="amount">Amount</label>
			<input id="amount" name="amount" type="number" step="0.01" min="0.01" required />

			<label for="category_id">Category</label>
			<select id="category_id" name="category_id">
				<option value="">No category</option>
				<optgroup label="Income">
					{incomeCategories.map((c) => <option value={c.id}>{c.name}</option>)}
				</optgroup>
				<optgroup label="Expense">
					{expenseCategories.map((c) => <option value={c.id}>{c.name}</option>)}
				</optgroup>
				<optgroup label="Saving">
					{savingCategories.map((c) => <option value={c.id}>{c.name}</option>)}
				</optgroup>
			</select>

			<label for="occurred_on">Date</label>
			<input id="occurred_on" name="occurred_on" type="date" />

			<label for="note">Note</label>
			<input id="note" name="note" type="text" maxlength="200" placeholder="Optional" />

			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn">Add</button>
			</div>
		</form>
	</dialog>

</Layout>

<script>
	// Delegated from `document` (which survives ClientRouter soft
	// navigations) rather than bound directly to the <select> -- a plain
	// script only runs once per module load, so a listener attached
	// directly to the element goes stale and silently stops firing after
	// the very first soft navigation swaps in a fresh DOM. Same pattern
	// Layout.astro's [data-editable] handling already uses for this reason.
	function syncQuickAddType(select: HTMLSelectElement) {
		const type = select.selectedOptions[0]?.getAttribute('data-type');
		const hidden = document.getElementById('quick-add-type') as HTMLInputElement | null;
		if (type && hidden) hidden.value = type;
	}

	document.addEventListener('change', (event) => {
		const target = event.target as HTMLElement;
		if (target instanceof HTMLSelectElement && target.id === 'quick-add-category') {
			syncQuickAddType(target);
		}
	});

	// Also sync on submit as a last-resort safety net (covers the case
	// where a category was already selected before any 'change' fired,
	// e.g. right after a fresh page load).
	document.addEventListener('submit', (event) => {
		const form = event.target as HTMLElement;
		if (form instanceof HTMLFormElement && form.id === 'quick-add-form') {
			const select = document.getElementById('quick-add-category');
			if (select instanceof HTMLSelectElement) syncQuickAddType(select);
		}
	});
</script>

