---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/finance';
import type { FinanceCategory, FinanceLimits } from '../../lib/finance';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const [{ data: categories }, { data: limits }] = await Promise.all([
	supabase.from('finance_categories').select('*').order('name', { ascending: true }),
	supabase.from('finance_limits').select('*').limit(1).maybeSingle(),
]);

const typedCategories = (categories ?? []) as FinanceCategory[];
const typedLimits = limits as FinanceLimits | null;

const incomeCategories = typedCategories.filter((c) => c.type === 'income');
const expenseCategories = typedCategories.filter((c) => c.type === 'expense');
const savingCategories = typedCategories.filter((c) => c.type === 'saving');

function formatAmount(n: number) {
	return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="settings">
		<a class="back" href="/finance">← Finance</a>

		<div class="page-head">
			<div>
				<p class="eyebrow">Household</p>
				<h1>Finance settings.</h1>
				<p class="lede">Starting balance, spending limits, and the categories used across income, expense, and saving.</p>
			</div>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="panel">
			<h2>Starting balance &amp; limits</h2>
			<p class="panel-sub">
				Starting balance is added on top of every saving transaction when computing your savings balance —
				set it once to whatever you already have saved.
			</p>
			<form method="post" action="/api/finance/settings/update" class="settings-form">
				<div class="settings-row">
					<div>
						<label for="starting-balance">Starting savings balance</label>
						<input
							id="starting-balance"
							name="starting_savings_balance"
							type="number"
							step="0.01"
							value={typedLimits?.starting_savings_balance ?? 0}
						/>
					</div>
					<div>
						<label for="daily-limit">Daily spending limit override</label>
						<input
							id="daily-limit"
							name="daily_limit"
							type="number"
							step="0.01"
							min="0"
							placeholder="From budget plan"
							value={typedLimits?.daily_limit ?? ''}
						/>
					</div>
					<div>
						<label for="weekly-limit">Weekly spending limit override</label>
						<input
							id="weekly-limit"
							name="weekly_limit"
							type="number"
							step="0.01"
							min="0"
							placeholder="From budget plan"
							value={typedLimits?.weekly_limit ?? ''}
						/>
					</div>
				</div>
				<div class="settings-actions">
					<button type="submit" class="btn">Save</button>
				</div>
			</form>
		</div>

		<div class="panel">
			<h2>Categories</h2>
			<p class="panel-sub">Used across transactions and budget planning.</p>

			<div class="category-groups">
				<div>
					<h3>Income</h3>
					<div class="table-wrap">
						<table class="data-table category-table">
							<thead>
								<tr>
									<th>Name</th>
									<th>Default / month</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								{incomeCategories.length ? (
									incomeCategories.map((c) => (
										<tr>
											<td
												data-editable="text"
												data-field="name"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.name}
											>
												{c.name}
											</td>
											<td
												class="cell-amount"
												data-editable="number"
												data-field="default_amount"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.default_amount}
											>
												{formatAmount(c.default_amount)}
											</td>
											<td class="cell-actions">
												<form method="post" action={`/api/finance/categories/${c.id}/delete`}>
													<button type="submit" class="row-delete" aria-label="Delete category">×</button>
												</form>
											</td>
										</tr>
									))
								) : (
									<tr>
										<td colspan="3" class="empty-cell">None yet.</td>
									</tr>
								)}
							</tbody>
						</table>
					</div>
				</div>
				<div>
					<h3>Expense</h3>
					<div class="table-wrap">
						<table class="data-table category-table">
							<thead>
								<tr>
									<th>Name</th>
									<th>Default / month</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								{expenseCategories.length ? (
									expenseCategories.map((c) => (
										<tr>
											<td
												data-editable="text"
												data-field="name"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.name}
											>
												{c.name}
											</td>
											<td
												class="cell-amount"
												data-editable="number"
												data-field="default_amount"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.default_amount}
											>
												{formatAmount(c.default_amount)}
											</td>
											<td class="cell-actions">
												<form method="post" action={`/api/finance/categories/${c.id}/delete`}>
													<button type="submit" class="row-delete" aria-label="Delete category">×</button>
												</form>
											</td>
										</tr>
									))
								) : (
									<tr>
										<td colspan="3" class="empty-cell">None yet.</td>
									</tr>
								)}
							</tbody>
						</table>
					</div>
				</div>
				<div>
					<h3>Saving</h3>
					<div class="table-wrap">
						<table class="data-table category-table">
							<thead>
								<tr>
									<th>Name</th>
									<th>Default / month</th>
									<th>Interest %/mo</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								{savingCategories.length ? (
									savingCategories.map((c) => (
										<tr>
											<td
												data-editable="text"
												data-field="name"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.name}
											>
												{c.name}
											</td>
											<td
												class="cell-amount"
												data-editable="number"
												data-field="default_amount"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.default_amount}
											>
												{formatAmount(c.default_amount)}
											</td>
											<td
												class="cell-amount"
												data-editable="number"
												data-field="interest_rate"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.interest_rate ?? ''}
											>
												{c.interest_rate != null ? c.interest_rate : '—'}
											</td>
											<td class="cell-actions">
												<form method="post" action={`/api/finance/categories/${c.id}/delete`}>
													<button type="submit" class="row-delete" aria-label="Delete category">×</button>
												</form>
											</td>
										</tr>
									))
								) : (
									<tr>
										<td colspan="4" class="empty-cell">None yet.</td>
									</tr>
								)}
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<form method="post" action="/api/finance/categories/create" class="new-category-form">
				<div class="settings-row">
					<div>
						<label for="cat-name">New category</label>
						<input id="cat-name" name="name" type="text" required maxlength="80" />
					</div>
					<div>
						<label for="cat-type">Type</label>
						<select id="cat-type" name="type">
							<option value="expense">Expense</option>
							<option value="income">Income</option>
							<option value="saving">Saving</option>
						</select>
					</div>
					<div>
						<label for="cat-default-amount">Default amount / month</label>
						<input id="cat-default-amount" name="default_amount" type="number" step="0.01" min="0" placeholder="0.00" />
					</div>
					<div>
						<label for="cat-interest-rate">Interest %/mo (saving only)</label>
						<input id="cat-interest-rate" name="interest_rate" type="number" step="0.001" placeholder="Optional" />
					</div>
				</div>
				<div class="settings-actions">
					<button type="submit" class="btn">Add category</button>
				</div>
			</form>
		</div>
	</section>
</Layout>

<style>
	.settings {
		max-width: 900px;
	}

	.back {
		display: inline-block;
		margin-bottom: 24px;
		color: var(--muted);
		text-decoration: none;
		font-size: 14px;
	}

	.back:hover {
		color: var(--ink);
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2rem, 5vw, 2.8rem);
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 60ch;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.panel {
		margin-top: 32px;
		padding: 28px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	.panel h2 {
		margin: 0;
		font-family: var(--serif);
		font-size: 20px;
		font-weight: 600;
	}

	.panel-sub {
		margin: 8px 0 0;
		font-size: 14px;
		color: var(--muted);
		max-width: 60ch;
	}

	.settings-form,
	.new-category-form {
		margin-top: 20px;
	}

	.settings-row {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}

	.settings-row > div {
		flex: 1 1 200px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.settings-row label {
		font-size: 13px;
		font-weight: 500;
		color: var(--muted);
	}

	.settings-row input,
	.settings-row select {
		font-family: var(--sans);
		font-size: 15px;
		color: var(--ink);
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 10px 14px;
		outline: none;
	}

	.settings-row input:focus,
	.settings-row select:focus {
		border-color: var(--ink);
	}

	.settings-actions {
		display: flex;
		justify-content: flex-end;
		margin-top: 18px;
	}

	.category-groups {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin-top: 20px;
	}

	.category-groups h3 {
		margin: 0 0 10px;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.table-wrap {
		overflow-x: auto;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--canvas);
	}

	.data-table.category-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13px;
	}

	.category-table th {
		text-align: left;
		padding: 8px 10px;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		white-space: nowrap;
	}

	.category-table td {
		padding: 8px 10px;
		border-bottom: 1px solid var(--line);
		vertical-align: middle;
	}

	.category-table tr:last-child td {
		border-bottom: none;
	}

	.cell-amount {
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.cell-actions {
		width: 1%;
		text-align: right;
	}

	.empty-cell {
		padding: 16px 10px;
		text-align: center;
		color: var(--muted);
		font-size: 13px;
	}

	.row-delete {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		font-size: 15px;
		line-height: 1;
		cursor: pointer;
	}

	.row-delete:hover {
		background: var(--paper);
		color: #b4231f;
	}

	@media (max-width: 720px) {
		.category-groups {
			grid-template-columns: 1fr;
		}
	}
</style>
