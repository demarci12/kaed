---
import Layout from '../../layouts/Layout.astro';
import { requireUser } from '../../lib/finance';
import type { FinanceCategory, FinanceLimits } from '../../lib/finance';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const [{ data: categories }, { data: limits }] = await Promise.all([
	supabase.from('finance_categories').select('*').order('name', { ascending: true }),
	supabase.from('finance_limits').select('*').limit(1).maybeSingle(),
]);

const typedCategories = (categories ?? []) as FinanceCategory[];
const typedLimits = limits as FinanceLimits | null;

const incomeCategories = typedCategories.filter((c) => c.type === 'income');
const expenseCategories = typedCategories.filter((c) => c.type === 'expense');
const savingCategories = typedCategories.filter((c) => c.type === 'saving');

function formatAmount(n: number) {
	return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="settings max-w-[900px]">
		<a class="back" href="/finance">← Finance</a>

		<div class="page-head">
			<div>
				<p class="eyebrow">Household</p>
				<h1>Finance settings.</h1>
				<p class="lede">Starting balance, spending limits, and the categories used across income, expense, and saving.</p>
			</div>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="panel mt-8 p-7 border border-line rounded-[14px] bg-paper">
			<h2 class="m-0 font-serif text-xl font-semibold">Starting balance &amp; limits</h2>
			<p class="panel-sub mt-2 mb-0 text-sm text-muted max-w-[60ch]">
				Starting balance is added on top of every saving transaction when computing your savings balance —
				set it once to whatever you already have saved.
			</p>
			<form method="post" action="/api/finance/settings/update" class="settings-form mt-5">
				<div class="settings-row flex gap-4 flex-wrap">
					<div class="flex-[1_1_200px] flex flex-col gap-1.5">
						<label for="starting-balance" class="text-[13px] font-medium text-muted">Starting savings balance</label>
						<input
							id="starting-balance"
							name="starting_savings_balance"
							type="number"
							step="0.01"
							value={typedLimits?.starting_savings_balance ?? 0}
							class="font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-3.5 py-2.5 outline-none focus:border-ink"
						/>
					</div>
					<div class="flex-[1_1_200px] flex flex-col gap-1.5">
						<label for="daily-limit" class="text-[13px] font-medium text-muted">Daily spending limit override</label>
						<input
							id="daily-limit"
							name="daily_limit"
							type="number"
							step="0.01"
							min="0"
							placeholder="From budget plan"
							value={typedLimits?.daily_limit ?? ''}
							class="font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-3.5 py-2.5 outline-none focus:border-ink"
						/>
					</div>
					<div class="flex-[1_1_200px] flex flex-col gap-1.5">
						<label for="weekly-limit" class="text-[13px] font-medium text-muted">Weekly spending limit override</label>
						<input
							id="weekly-limit"
							name="weekly_limit"
							type="number"
							step="0.01"
							min="0"
							placeholder="From budget plan"
							value={typedLimits?.weekly_limit ?? ''}
							class="font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-3.5 py-2.5 outline-none focus:border-ink"
						/>
					</div>
				</div>
				<div class="settings-actions flex justify-end mt-[18px]">
					<button type="submit" class="btn">Save</button>
				</div>
			</form>
		</div>

		<div class="panel mt-8 p-7 border border-line rounded-[14px] bg-paper">
			<h2 class="m-0 font-serif text-xl font-semibold">Categories</h2>
			<p class="panel-sub mt-2 mb-0 text-sm text-muted max-w-[60ch]">Used across transactions and budget planning.</p>

			<div class="category-groups grid grid-cols-1 md:grid-cols-3 gap-5 mt-5">
				<div>
					<h3 class="m-0 mb-2.5 text-[13px] font-semibold tracking-[0.04em] uppercase text-muted">Income</h3>
					<div class="table-wrap rounded-[10px] bg-canvas">
						<table class="data-table category-table text-[13px]">
							<thead>
								<tr>
									<th>Name</th>
									<th>Default / month</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								{incomeCategories.length ? (
									incomeCategories.map((c) => (
										<tr>
											<td
												data-editable="text"
												data-field="name"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.name}
											>
												{c.name}
											</td>
											<td
												class="cell-amount"
												data-editable="number"
												data-field="default_amount"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.default_amount}
											>
												{formatAmount(c.default_amount)}
											</td>
											<td class="cell-actions w-[1%] text-right">
												<form method="post" action={`/api/finance/categories/${c.id}/delete`}>
													<button type="submit" class="row-delete flex items-center justify-center w-[22px] h-[22px] border-0 rounded-full bg-transparent text-muted text-[15px] leading-none cursor-pointer hover:bg-paper hover:text-negative" aria-label="Delete category">×</button>
												</form>
											</td>
										</tr>
									))
								) : (
									<tr>
										<td colspan="3" class="empty-cell py-4 px-2.5 text-[13px]">None yet.</td>
									</tr>
								)}
							</tbody>
						</table>
					</div>
				</div>
				<div>
					<h3 class="m-0 mb-2.5 text-[13px] font-semibold tracking-[0.04em] uppercase text-muted">Expense</h3>
					<div class="table-wrap rounded-[10px] bg-canvas">
						<table class="data-table category-table text-[13px]">
							<thead>
								<tr>
									<th>Name</th>
									<th>Default / month</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								{expenseCategories.length ? (
									expenseCategories.map((c) => (
										<tr>
											<td
												data-editable="text"
												data-field="name"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.name}
											>
												{c.name}
											</td>
											<td
												class="cell-amount"
												data-editable="number"
												data-field="default_amount"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.default_amount}
											>
												{formatAmount(c.default_amount)}
											</td>
											<td class="cell-actions w-[1%] text-right">
												<form method="post" action={`/api/finance/categories/${c.id}/delete`}>
													<button type="submit" class="row-delete flex items-center justify-center w-[22px] h-[22px] border-0 rounded-full bg-transparent text-muted text-[15px] leading-none cursor-pointer hover:bg-paper hover:text-negative" aria-label="Delete category">×</button>
												</form>
											</td>
										</tr>
									))
								) : (
									<tr>
										<td colspan="3" class="empty-cell py-4 px-2.5 text-[13px]">None yet.</td>
									</tr>
								)}
							</tbody>
						</table>
					</div>
				</div>
				<div>
					<h3 class="m-0 mb-2.5 text-[13px] font-semibold tracking-[0.04em] uppercase text-muted">Saving</h3>
					<div class="table-wrap rounded-[10px] bg-canvas">
						<table class="data-table category-table text-[13px]">
							<thead>
								<tr>
									<th>Name</th>
									<th>Default / month</th>
									<th>Interest %/mo</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								{savingCategories.length ? (
									savingCategories.map((c) => (
										<tr>
											<td
												data-editable="text"
												data-field="name"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.name}
											>
												{c.name}
											</td>
											<td
												class="cell-amount"
												data-editable="number"
												data-field="default_amount"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.default_amount}
											>
												{formatAmount(c.default_amount)}
											</td>
											<td
												class="cell-amount"
												data-editable="number"
												data-field="interest_rate"
												data-id={c.id}
												data-endpoint="/api/finance/categories"
												data-value={c.interest_rate ?? ''}
											>
												{c.interest_rate != null ? c.interest_rate : '—'}
											</td>
											<td class="cell-actions w-[1%] text-right">
												<form method="post" action={`/api/finance/categories/${c.id}/delete`}>
													<button type="submit" class="row-delete flex items-center justify-center w-[22px] h-[22px] border-0 rounded-full bg-transparent text-muted text-[15px] leading-none cursor-pointer hover:bg-paper hover:text-negative" aria-label="Delete category">×</button>
												</form>
											</td>
										</tr>
									))
								) : (
									<tr>
										<td colspan="4" class="empty-cell py-4 px-2.5 text-[13px]">None yet.</td>
									</tr>
								)}
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<form method="post" action="/api/finance/categories/create" class="new-category-form mt-5">
				<div class="settings-row flex gap-4 flex-wrap">
					<div class="flex-[1_1_200px] flex flex-col gap-1.5">
						<label for="cat-name" class="text-[13px] font-medium text-muted">New category</label>
						<input id="cat-name" name="name" type="text" required maxlength="80" class="font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-3.5 py-2.5 outline-none focus:border-ink" />
					</div>
					<div class="flex-[1_1_200px] flex flex-col gap-1.5">
						<label for="cat-type" class="text-[13px] font-medium text-muted">Type</label>
						<select id="cat-type" name="type" class="font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-3.5 py-2.5 outline-none focus:border-ink">
							<option value="expense">Expense</option>
							<option value="income">Income</option>
							<option value="saving">Saving</option>
						</select>
					</div>
					<div class="flex-[1_1_200px] flex flex-col gap-1.5">
						<label for="cat-default-amount" class="text-[13px] font-medium text-muted">Default amount / month</label>
						<input id="cat-default-amount" name="default_amount" type="number" step="0.01" min="0" placeholder="0.00" class="font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-3.5 py-2.5 outline-none focus:border-ink" />
					</div>
					<div class="flex-[1_1_200px] flex flex-col gap-1.5">
						<label for="cat-interest-rate" class="text-[13px] font-medium text-muted">Interest %/mo (saving only)</label>
						<input id="cat-interest-rate" name="interest_rate" type="number" step="0.001" placeholder="Optional" class="font-sans text-base text-ink bg-canvas border border-line rounded-[10px] px-3.5 py-2.5 outline-none focus:border-ink" />
					</div>
				</div>
				<div class="settings-actions flex justify-end mt-[18px]">
					<button type="submit" class="btn">Add category</button>
				</div>
			</form>
		</div>
	</section>
</Layout>

<style>
	/* Descendant-selector rules for cells within the three side-by-side
	   category tables -- kept as scoped CSS rather than repeating utility
	   classes on every <th>/<td> across three tables. */
	.category-table th {
		text-align: left;
		padding: 8px 10px;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		white-space: nowrap;
	}

	.category-table td {
		padding: 8px 10px;
		border-bottom: 1px solid var(--line);
		vertical-align: middle;
	}
</style>
