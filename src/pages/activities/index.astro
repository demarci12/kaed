---
import Layout from '../../layouts/Layout.astro';
import { requireUser, type Challenge } from '../../lib/challenges';
import type { Project } from '../../lib/projects';

const auth = await requireUser(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const [{ data: challenges }, { data: projects }] = await Promise.all([
	supabase.from('challenges').select('*').order('is_done', { ascending: true }).order('created_at', { ascending: false }),
	supabase.from('projects').select('id, title').order('title', { ascending: true }),
]);

const typedChallenges = (challenges ?? []) as Challenge[];
const typedProjects = (projects ?? []) as Pick<Project, 'id' | 'title'>[];
const projectById = new Map(typedProjects.map((p) => [p.id, p]));

const doneCount = typedChallenges.filter((c) => c.is_done).length;

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="activities max-w-[900px]">
		<div class="page-head">
			<div>
				<p class="eyebrow">Delivery</p>
				<h1>Activities.</h1>
				<p class="lede">
					Every broken-down step across every project, in one place — the last stop in pain point →
					business idea → project → activity, so you can stop procrastinating and just do the next one.
				</p>
			</div>
			<button type="button" class="btn w-full md:w-auto" data-open-popup="new-activity">+ Add activity</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		{typedChallenges.length > 0 && (
			<div class="progress-row flex items-center gap-3.5 mt-8 flex-wrap md:flex-nowrap gap-2.5 md:gap-3.5">
				<span class="progress-count text-[13px] text-muted tabular-nums whitespace-nowrap">{doneCount}/{typedChallenges.length} done</span>
				<div class="progress-bar flex-1 basis-full md:basis-auto h-1.5 bg-canvas border border-line rounded-full overflow-hidden">
					<div class="progress-bar-fill" style={`width: ${(doneCount / typedChallenges.length) * 100}%`} />
				</div>
			</div>
		)}

		<div class="card-grid mt-5">
			{typedChallenges.length ? (
				typedChallenges.map((challenge) => {
					const project = projectById.get(challenge.project_id);
					return (
						<article class="card">
							<div class="card-head">
								<form
									method="post"
									action={`/api/projects/${challenge.project_id}/challenges/${challenge.id}/toggle`}
									class="activity-check-form m-0 shrink-0"
								>
									<input type="hidden" name="is_done" value={String(challenge.is_done)} />
									<input type="hidden" name="return_to" value="/activities" />
									<button
										type="submit"
										class={`activity-check w-6 h-6 shrink-0 flex items-center justify-center rounded-full border text-white text-[13px] cursor-pointer transition-colors duration-150 ${challenge.is_done ? 'bg-ink border-ink' : 'bg-paper border-line'}`}
										aria-label="Toggle done"
									>
										{challenge.is_done && '✓'}
									</button>
								</form>
								<span class={`card-title activity-title text-[17px] leading-[1.35] ${challenge.is_done ? 'text-muted line-through' : ''}`}>{challenge.title}</span>
							</div>

							<div class="card-foot">
								{project ? (
									<a class="chip" href={`/projects/${project.id}`}>{project.title}</a>
								) : (
									<span class="chip chip-muted">No project</span>
								)}
								<span class="card-date">{new Date(challenge.created_at).toLocaleDateString()}</span>
							</div>
						</article>
					);
				})
			) : (
				<p class="empty">
					No activities yet. Break a project down into steps from here or from the project page.
				</p>
			)}
		</div>
	</section>

	<dialog id="new-activity" class="popup">
		<button type="button" class="popup-close" data-close-popup aria-label="Close">&times;</button>
		<h2>Add activity</h2>
		<form method="post" action="/api/activities/create">
			<label for="activity-project">Project</label>
			<select id="activity-project" name="project_id" required disabled={typedProjects.length === 0}>
				{typedProjects.length ? (
					typedProjects.map((p) => <option value={p.id}>{p.title}</option>)
				) : (
					<option value="">No projects yet</option>
				)}
			</select>
			<label for="activity-title">Title</label>
			<input id="activity-title" name="title" type="text" placeholder="e.g. Ship the first draft" required maxlength="200" />
			<div class="popup-actions">
				<button type="button" class="btn ghost" data-close-popup>Cancel</button>
				<button type="submit" class="btn" disabled={typedProjects.length === 0}>Add</button>
			</div>
		</form>
	</dialog>
</Layout>

