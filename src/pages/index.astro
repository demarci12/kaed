---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
	data: { user },
} = await supabase.auth.getUser();
if (user) {
	return Astro.redirect('/challenges');
}

const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');
---

<Layout>
	<section class="auth">
		<p class="eyebrow">KAED</p>
		<h1>Log in.</h1>

		{error && <p class="auth-error">{error}</p>}
		{notice && <p class="auth-notice">{notice}</p>}

		<form method="post" action="/api/auth/signin" class="auth-form">
			<label for="email">Email</label>
			<input id="email" name="email" type="email" required autocomplete="email" />

			<label for="password">Password</label>
			<input id="password" name="password" type="password" required autocomplete="current-password" />

			<button type="submit" class="btn">Log in</button>
		</form>

		<form method="post" action="/api/auth/signup" class="auth-form auth-form-secondary">
			<label for="signup-email">Email</label>
			<input id="signup-email" name="email" type="email" required autocomplete="email" />

			<label for="signup-password">Password</label>
			<input
				id="signup-password"
				name="password"
				type="password"
				required
				minlength="6"
				autocomplete="new-password"
			/>

			<button type="submit" class="btn ghost">Create account</button>
		</form>
	</section>
</Layout>

<style>
	.auth {
		max-width: 420px;
		margin: 64px auto;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.auth-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.auth-notice {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid var(--line);
		background: var(--paper);
		border-radius: 10px;
		color: var(--ink);
		font-size: 14px;
	}

	.auth-form {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: 32px;
		padding: 28px;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 16px;
	}

	.auth-form-secondary {
		margin-top: 20px;
		background: transparent;
	}

	.auth-form label {
		margin-top: 14px;
		font-size: 13px;
		font-weight: 500;
		color: var(--muted);
	}

	.auth-form input {
		height: 48px;
		padding: 0 16px;
		font-family: var(--sans);
		font-size: 15px;
		color: var(--ink);
		background: var(--canvas);
		border: 1px solid var(--line);
		border-radius: 10px;
		outline: none;
		transition: border-color 0.15s ease;
	}

	.auth-form input:focus {
		border-color: var(--ink);
	}

	.btn {
		margin-top: 24px;
		height: 48px;
		padding: 0 24px;
		font-family: var(--sans);
		font-size: 15px;
		font-weight: 500;
		color: #fff;
		background: var(--ink);
		border: 1px solid var(--ink);
		border-radius: 999px;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.btn:hover {
		background: transparent;
		color: var(--ink);
	}

	.btn.ghost {
		color: var(--ink);
		background: transparent;
	}

	.btn.ghost:hover {
		background: var(--ink);
		color: #fff;
	}
</style>
