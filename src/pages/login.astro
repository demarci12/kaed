---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase';
import { isMember } from '../lib/auth';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
	data: { user },
} = await supabase.auth.getUser();
if (user) {
	return Astro.redirect(isMember(user) ? '/finance' : '/projects');
}

const error = Astro.url.searchParams.get('error');
---

<Layout>
	<section class="auth max-w-[420px] mx-auto my-16">
		<p class="eyebrow">KAED</p>
		<h1>Log in.</h1>

		{error && <p class="auth-error mt-5 py-3 px-4 border border-negative-line bg-negative-bg rounded-[10px] text-negative text-sm">{error}</p>}

		<form method="post" action="/api/auth/signin" class="auth-form flex flex-col gap-1.5 mt-8 p-7 bg-paper border border-line rounded-2xl">
			<label for="email" class="mt-3.5 text-[13px] font-medium text-muted">Email</label>
			<input id="email" name="email" type="email" required autocomplete="email" class="h-12 px-4 font-sans text-[15px] text-ink bg-canvas border border-line rounded-[10px] outline-none transition-colors duration-150 focus:border-ink" />

			<label for="password" class="mt-3.5 text-[13px] font-medium text-muted">Password</label>
			<input id="password" name="password" type="password" required autocomplete="current-password" class="h-12 px-4 font-sans text-[15px] text-ink bg-canvas border border-line rounded-[10px] outline-none transition-colors duration-150 focus:border-ink" />

			<button type="submit" class="btn">Log in</button>
		</form>
	</section>
</Layout>

<style>
	/* .eyebrow / h1: page-specific overrides of the shared classes from
	   Layout.astro, kept scoped -- this page deliberately doesn't inherit
	   the shared hero typography, and a utility class here would carry the
	   same specificity as the shared rule instead of cleanly overriding it. */
	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	/* Deltas only -- everything else comes from the global .btn. This is the
	   page's single primary CTA, so it's deliberately taller and full width.
	   Kept scoped for the same specificity-safety reason as above. */
	.btn {
		width: 100%;
		min-height: 48px;
		margin-top: 24px;
		font-size: 15px;
	}
</style>
