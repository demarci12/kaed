---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import type { Idea } from '../../lib/ideas';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as Idea[];

// Grouped labels ("Pain · Work · Mine") kept short for the pill itself so
// the row of pills reads at a glance; grouping still shows in the dropdown.
const categoryPillLabel: Record<string, string> = {
	'work-mine': 'Work · Mine',
	'work-others': "Work · Others'",
	'life-mine': 'Life · Mine',
	'life-known': 'Life · Known',
	'life-strangers': "Life · Strangers",
	'tech-app': 'Tech · App',
	'clone-niche': 'Clone · Niche',
	'clone-geo': 'Clone · Geo',
	'clone-pricing': 'Clone · Pricing',
	'clone-usecase': 'Clone · Use case',
	'clone-oss': 'Clone · OSS',
};

const categoryOptions = [
	':Pick category',
	...Object.entries(categoryPillLabel).map(([value, label]) => `${value}:${label}`),
].join(',');

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="pain-points">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Pain points.</h1>
				<p class="lede">
					Capture what's actually annoying or broken. Once one is worth solving, turn it into a business
					idea → then a project → then activities you actually work through. Click a title or note to write.
				</p>
			</div>
			<form method="post" action="/api/ideas/create-inline" class="new-idea-form">
				<button type="submit" class="btn">+ New pain point</button>
			</form>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="notes" id="notes">
			{typedIdeas.length ? (
				typedIdeas.map((idea) => (
					<article class="note" data-id={idea.id}>
						<div class="note-body">
							<div
								class="note-title"
								data-editable="text"
								data-field="title"
								data-id={idea.id}
								data-endpoint="/api/ideas"
								data-value={idea.title}
							>
								{idea.title || 'Untitled'}
							</div>
							<div
								class="note-category"
								data-editable="select"
								data-field="category"
								data-id={idea.id}
								data-endpoint="/api/ideas"
								data-value={idea.category ?? ''}
								data-options={categoryOptions}
							>
								{idea.category ? (
									<span class={`pill pill-${idea.category}`}>{categoryPillLabel[idea.category]}</span>
								) : (
									<span class="pill pill-empty">Pick category</span>
								)}
							</div>
							<div
								class="note-text"
								data-editable="textarea"
								data-field="body"
								data-id={idea.id}
								data-endpoint="/api/ideas"
								data-value={idea.body ?? ''}
							>
								{idea.body || 'Write something…'}
							</div>
						</div>
						<div class="note-actions">
							{idea.business_idea_id ? (
								<a class="note-link" href={`/business-ideas/${idea.business_idea_id}`}>→ View business idea</a>
							) : (
								<form method="post" action={`/api/ideas/${idea.id}/promote`}>
									<button type="submit" class="note-link note-link-btn">Generate business idea →</button>
								</form>
							)}
							<form method="post" action={`/api/ideas/${idea.id}/delete`}>
								<button type="submit" class="note-delete" aria-label="Delete note">×</button>
							</form>
						</div>
					</article>
				))
			) : (
				<p class="empty">Nothing here yet. Click "+ New pain point" to start writing.</p>
			)}
		</div>
	</section>
</Layout>

<style>
	.pain-points {
		max-width: 760px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 54ch;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.new-idea-form {
		margin: 0;
		flex-shrink: 0;
	}

	.notes {
		margin-top: 40px;
		display: flex;
		flex-direction: column;
	}

	.note {
		padding: 20px 0;
		border-bottom: 1px solid var(--line);
	}

	.note:first-child {
		padding-top: 0;
	}

	.note-body {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	/* Both fields share the same box treatment (padding, border, radius,
	   background) so they read as a matching pair of input fields -- only
	   typography (serif/bold title vs sans/regular body) tells them apart,
	   not wildly different sizing or one having chrome and the other not. */
	.note-title,
	.note-text {
		padding: 12px 14px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--paper);
		cursor: text;
		transition: border-color 0.15s ease;
	}

	.note-title:hover,
	.note-text:hover {
		border-color: var(--muted);
	}

	.note-title {
		font-family: var(--serif);
		font-size: 19px;
		font-weight: 600;
		line-height: 1.4;
	}

	.note-text {
		font-size: 16px;
		line-height: 1.6;
		color: var(--ink);
		white-space: pre-wrap;
	}

	.note-text:not(.editing) {
		color: var(--muted);
	}

	.note-title[data-value]:not([data-value=""]),
	.note-text[data-value]:not([data-value=""]) {
		color: var(--ink);
	}

	.note-category {
		display: inline-block;
		cursor: pointer;
	}

	.note-category select.cell-input {
		font-size: 14px;
		padding: 4px 6px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--paper);
	}

	.note-title.editing,
	.note-text.editing {
		border-color: var(--ink);
		background: var(--canvas);
	}

	.note-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 16px;
	}

	.note-actions form {
		margin: 0;
	}

	.note-link {
		font-size: 13px;
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px solid var(--line);
	}

	.note-link:hover {
		color: var(--ink);
		border-color: var(--ink);
	}

	.note-link-btn {
		background: none;
		border: none;
		border-bottom: 1px solid var(--line);
		padding: 0;
		font-family: var(--sans);
		cursor: pointer;
	}

	.note-delete {
		width: 22px;
		height: 22px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		font-size: 15px;
		line-height: 1;
		cursor: pointer;
	}

	.note-delete:hover {
		border-color: var(--line);
		color: #b4231f;
	}

	.empty {
		margin-top: 40px;
		color: var(--muted);
		font-size: 15px;
	}

	.cell-input {
		font-family: inherit;
		font-size: inherit;
		line-height: inherit;
		color: inherit;
		font-weight: inherit;
	}

	.note-text .cell-input {
		min-height: 120px;
		resize: vertical;
	}

	@media (max-width: 720px) {
		.page-head {
			align-items: flex-start;
			gap: 16px;
		}

		.new-idea-form,
		.page-head .btn {
			width: 100%;
			justify-content: center;
		}

		.notes {
			margin-top: 28px;
		}

		.note {
			padding: 22px 0;
		}

		.note-actions {
			flex-wrap: wrap;
			gap: 14px 12px;
		}

		/* Bigger tap target on touch without changing the visual size. */
		.note-delete {
			position: relative;
		}

		.note-delete::after {
			content: '';
			position: absolute;
			inset: -11px;
		}
	}
</style>
