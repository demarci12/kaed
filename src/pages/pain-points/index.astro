---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import type { Idea } from '../../lib/ideas';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as Idea[];

// Grouped labels ("Pain · Work · Mine") kept short for the pill itself so
// the row of pills reads at a glance; grouping still shows in the dropdown.
const categoryPillLabel: Record<string, string> = {
	'work-mine': 'Work · Mine',
	'work-others': "Work · Others'",
	'life-mine': 'Life · Mine',
	'life-known': 'Life · Known',
	'life-strangers': "Life · Strangers",
	'tech-app': 'Tech · App',
	'clone-niche': 'Clone · Niche',
	'clone-geo': 'Clone · Geo',
	'clone-pricing': 'Clone · Pricing',
	'clone-usecase': 'Clone · Use case',
	'clone-oss': 'Clone · OSS',
};

const categoryOptions = [
	':Pick category',
	...Object.entries(categoryPillLabel).map(([value, label]) => `${value}:${label}`),
].join(',');

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="pain-points">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Pain points.</h1>
				<p class="lede">
					Capture what's actually annoying or broken. Once one is worth solving, turn it into a business
					idea → then a project → then activities you actually work through. Click a field to write.
				</p>
			</div>
			<form method="post" action="/api/ideas/create-inline" class="new-idea-form">
				<button type="submit" class="btn">+ New pain point</button>
			</form>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="pain-grid" id="notes">
			{typedIdeas.length ? (
				typedIdeas.map((idea) => (
					<article class="pain-card" data-id={idea.id}>
						<div
							class="pain-title"
							data-editable="text"
							data-field="title"
							data-id={idea.id}
							data-endpoint="/api/ideas"
							data-value={idea.title}
						>
							{idea.title || 'Untitled'}
						</div>

						<div
							class="pain-category"
							data-editable="select"
							data-field="category"
							data-id={idea.id}
							data-endpoint="/api/ideas"
							data-value={idea.category ?? ''}
							data-options={categoryOptions}
						>
							{idea.category ? (
								<span class={`pill pill-${idea.category}`}>{categoryPillLabel[idea.category]}</span>
							) : (
								<span class="pill pill-empty">Pick category</span>
							)}
						</div>

						<p
							class="pain-text"
							data-editable="textarea"
							data-field="body"
							data-id={idea.id}
							data-endpoint="/api/ideas"
							data-value={idea.body ?? ''}
						>
							{idea.body || 'Write something…'}
						</p>

						<div class="pain-card-foot">
							{idea.business_idea_id ? (
								<a class="pain-chip" href={`/business-ideas/${idea.business_idea_id}`}>→ View business idea</a>
							) : (
								<form method="post" action={`/api/ideas/${idea.id}/promote`} class="pain-promote-form">
									<button type="submit" class="pain-chip pain-chip-btn">Generate business idea →</button>
								</form>
							)}
							<form method="post" action={`/api/ideas/${idea.id}/delete`} class="pain-delete-form">
								<button type="submit" class="pain-delete" aria-label="Delete pain point">×</button>
							</form>
						</div>
					</article>
				))
			) : (
				<p class="empty">Nothing here yet. Click "+ New pain point" to start writing.</p>
			)}
		</div>
	</section>
</Layout>

<style>
	.pain-points {
		max-width: 1080px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 60ch;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.new-idea-form {
		margin: 0;
		flex-shrink: 0;
	}

	.pain-grid {
		margin-top: 40px;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 18px;
	}

	.pain-card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 22px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--paper);
	}

	/* Title and body share the same box treatment (padding, border, radius,
	   background) so they read as a matching pair of input fields -- only
	   typography (serif/bold title vs sans/regular body) tells them apart. */
	.pain-title,
	.pain-text {
		margin: 0;
		padding: 10px 12px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--canvas);
		cursor: text;
		transition: border-color 0.15s ease;
	}

	.pain-title:hover,
	.pain-text:hover {
		border-color: var(--muted);
	}

	.pain-title {
		font-family: var(--serif);
		font-size: 18px;
		font-weight: 600;
		line-height: 1.35;
	}

	.pain-text {
		flex: 1;
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink);
		white-space: pre-wrap;
	}

	.pain-text:not(.editing) {
		color: var(--muted);
	}

	.pain-title[data-value]:not([data-value=""]),
	.pain-text[data-value]:not([data-value=""]) {
		color: var(--ink);
	}

	.pain-title.editing,
	.pain-text.editing {
		border-color: var(--ink);
		background: var(--paper);
	}

	.pain-category {
		display: inline-block;
		align-self: flex-start;
		cursor: pointer;
	}

	.pain-category select.cell-input {
		font-size: 14px;
		padding: 4px 6px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--paper);
	}

	.pain-card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px solid var(--line);
	}

	.pain-promote-form,
	.pain-delete-form {
		margin: 0;
	}

	.pain-chip {
		font-size: 12px;
		padding: 4px 10px;
		border-radius: 999px;
		background: var(--canvas);
		border: 1px solid var(--line);
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
	}

	.pain-chip:hover {
		border-color: var(--ink);
	}

	.pain-chip-btn {
		font-family: var(--sans);
		cursor: pointer;
	}

	.pain-delete {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		font-size: 15px;
		line-height: 1;
		cursor: pointer;
	}

	.pain-delete:hover {
		border-color: var(--line);
		color: #b4231f;
	}

	.empty {
		grid-column: 1 / -1;
		margin: 0;
		padding: 32px 16px;
		text-align: center;
		color: var(--muted);
		border: 1px dashed var(--line);
		border-radius: 14px;
	}

	.cell-input {
		font-family: inherit;
		font-size: inherit;
		line-height: inherit;
		color: inherit;
		font-weight: inherit;
	}

	.pain-text .cell-input {
		min-height: 100px;
		resize: vertical;
	}

	@media (max-width: 720px) {
		.page-head {
			align-items: flex-start;
			gap: 16px;
		}

		.new-idea-form,
		.page-head .btn {
			width: 100%;
			justify-content: center;
		}

		.pain-grid {
			grid-template-columns: 1fr;
			margin-top: 28px;
		}

		.pain-card {
			padding: 18px;
		}

		/* Bigger tap target on touch without changing the visual size. */
		.pain-delete {
			position: relative;
		}

		.pain-delete::after {
			content: '';
			position: absolute;
			inset: -11px;
		}
	}
</style>
