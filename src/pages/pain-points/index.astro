---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import type { Idea } from '../../lib/ideas';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as Idea[];

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="pain-points">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Pain points.</h1>
				<p class="lede">
					Capture what's actually annoying or broken. Once one is worth solving, turn it into a business
					idea → then a project → then activities you actually work through. Click a title or note to write.
				</p>
			</div>
			<button type="button" class="btn" id="new-idea-btn">+ New pain point</button>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="notes" id="notes">
			{typedIdeas.length ? (
				typedIdeas.map((idea) => (
					<article class="note" data-id={idea.id}>
						<div class="note-body">
							<div
								class="note-title"
								data-editable="text"
								data-field="title"
								data-id={idea.id}
								data-endpoint="/api/ideas"
								data-value={idea.title}
							>
								{idea.title || 'Untitled'}
							</div>
							<div
								class="note-text"
								data-editable="textarea"
								data-field="body"
								data-id={idea.id}
								data-endpoint="/api/ideas"
								data-value={idea.body ?? ''}
							>
								{idea.body || 'Write something…'}
							</div>
						</div>
						<div class="note-actions">
							{idea.business_idea_id ? (
								<a class="note-link" href={`/business-ideas/${idea.business_idea_id}`}>→ View business idea</a>
							) : (
								<form method="post" action={`/api/ideas/${idea.id}/promote`}>
									<button type="submit" class="note-link note-link-btn">Generate business idea →</button>
								</form>
							)}
							<form method="post" action={`/api/ideas/${idea.id}/delete`}>
								<button type="submit" class="note-delete" aria-label="Delete note">×</button>
							</form>
						</div>
					</article>
				))
			) : (
				<p class="empty">Nothing here yet. Click "+ New pain point" to start writing.</p>
			)}
		</div>
	</section>
</Layout>

<script>
	const notes = document.getElementById('notes');
	const newIdeaBtn = document.getElementById('new-idea-btn');

	function buildNote(idea: { id: string; title: string; body: string | null }) {
		const article = document.createElement('article');
		article.className = 'note';
		article.dataset.id = idea.id;
		article.innerHTML = `
			<div class="note-body">
				<div class="note-title" data-editable="text" data-field="title" data-id="${idea.id}" data-endpoint="/api/ideas" data-value="">Untitled</div>
				<div class="note-text" data-editable="textarea" data-field="body" data-id="${idea.id}" data-endpoint="/api/ideas" data-value="">Write something…</div>
			</div>
			<div class="note-actions">
				<form method="post" action="/api/ideas/${idea.id}/promote"><button type="submit" class="note-link note-link-btn">Generate business idea →</button></form>
				<form method="post" action="/api/ideas/${idea.id}/delete"><button type="submit" class="note-delete" aria-label="Delete note">×</button></form>
			</div>
		`;
		return article;
	}

	newIdeaBtn?.addEventListener('click', async () => {
		const empty = notes?.querySelector('.empty');
		empty?.remove();

		const res = await fetch('/api/ideas/create-inline', { method: 'POST' });
		const idea = await res.json().catch(() => null);
		if (!idea?.id || !notes) return;

		const note = buildNote(idea);
		notes.prepend(note);
		note.querySelector<HTMLElement>('.note-title')?.click();
	});
</script>

<style>
	.pain-points {
		max-width: 760px;
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		letter-spacing: -0.02em;
	}

	.lede {
		max-width: 54ch;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 16px;
	}

	.page-head .btn {
		flex-shrink: 0;
	}

	.form-error {
		margin: 20px 0 0;
		padding: 12px 16px;
		border: 1px solid #e7c3c1;
		background: #fbf0ef;
		border-radius: 10px;
		color: #b4231f;
		font-size: 14px;
	}

	.notes {
		margin-top: 40px;
		display: flex;
		flex-direction: column;
	}

	.note {
		padding: 28px 0;
		border-bottom: 1px solid var(--line);
	}

	.note:first-child {
		padding-top: 0;
	}

	.note-title {
		font-family: var(--serif);
		font-size: 22px;
		font-weight: 600;
		cursor: text;
	}

	.note-text {
		margin-top: 10px;
		font-size: 16px;
		line-height: 1.7;
		color: var(--ink);
		white-space: pre-wrap;
		cursor: text;
	}

	.note-text:not(.editing) {
		color: var(--muted);
	}

	.note-title[data-value]:not([data-value=""]),
	.note-text[data-value]:not([data-value=""]) {
		color: var(--ink);
	}

	.note-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 16px;
	}

	.note-actions form {
		margin: 0;
	}

	.note-link {
		font-size: 13px;
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px solid var(--line);
	}

	.note-link:hover {
		color: var(--ink);
		border-color: var(--ink);
	}

	.note-link-btn {
		background: none;
		border: none;
		border-bottom: 1px solid var(--line);
		padding: 0;
		font-family: var(--sans);
		cursor: pointer;
	}

	.note-delete {
		width: 22px;
		height: 22px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		font-size: 15px;
		line-height: 1;
		cursor: pointer;
	}

	.note-delete:hover {
		border-color: var(--line);
		color: #b4231f;
	}

	.empty {
		margin-top: 40px;
		color: var(--muted);
		font-size: 15px;
	}

	.cell-input {
		font-family: inherit;
		font-size: inherit;
		line-height: inherit;
		color: inherit;
		font-weight: inherit;
	}

	.note-text .cell-input {
		min-height: 120px;
		resize: vertical;
	}

	@media (max-width: 720px) {
		.page-head {
			align-items: flex-start;
			gap: 16px;
		}

		.page-head .btn {
			width: 100%;
			justify-content: center;
		}

		.notes {
			margin-top: 28px;
		}

		.note {
			padding: 22px 0;
		}

		.note-actions {
			flex-wrap: wrap;
			gap: 14px 12px;
		}

		/* Bigger tap target on touch without changing the visual size. */
		.note-delete {
			position: relative;
		}

		.note-delete::after {
			content: '';
			position: absolute;
			inset: -11px;
		}
	}
</style>
