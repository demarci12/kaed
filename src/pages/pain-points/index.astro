---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import { OPL_STATUS_LABELS, type Idea } from '../../lib/ideas';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as Idea[];

const statusOptions = Object.entries(OPL_STATUS_LABELS)
	.map(([value, label]) => `${value}:${label}`)
	.join(',');

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="pain-points max-w-[1080px]">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>OPL: Open Point List.</h1>
				<p class="lede">
					Every open item, PMP-style: what needs doing, who's on it, and where it stands. Click any
					field to edit it.
				</p>
			</div>
			<form method="post" action="/api/ideas/create-inline" class="new-idea-form m-0 shrink-0 w-full md:w-auto">
				<button type="submit" class="btn w-full md:w-auto justify-center">+ New item</button>
			</form>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="card-grid" id="notes">
			{typedIdeas.length ? (
				typedIdeas.map((idea) => (
					<article class="card" data-id={idea.id}>
						<div class="card-head">
							<div
								class="card-title pain-title cursor-text"
								data-editable="text"
								data-field="title"
								data-id={idea.id}
								data-endpoint="/api/ideas"
								data-value={idea.title}
							>
								{idea.title || 'Untitled'}
							</div>
							<form class="shrink-0" method="post" action={`/api/ideas/${idea.id}/delete`}>
								<button type="submit" class="card-delete" aria-label="Delete item">×</button>
							</form>
						</div>

						<div
							class="inline-block self-start cursor-pointer"
							data-editable="select"
							data-field="status"
							data-id={idea.id}
							data-endpoint="/api/ideas"
							data-value={idea.status}
							data-options={statusOptions}
						>
							<span class={`pill pill-${idea.status}`}>{OPL_STATUS_LABELS[idea.status]}</span>
						</div>

						<div class="card-field">
							<span class="card-field-label">Description</span>
							<p
								class="card-field-value pain-text"
								data-editable="textarea"
								data-field="body"
								data-id={idea.id}
								data-endpoint="/api/ideas"
								data-value={idea.body ?? ''}
							>
								{idea.body || 'Write something…'}
							</p>
						</div>

						<div class="card-field">
							<span class="card-field-label">Contributors</span>
							<p
								class="card-field-value"
								data-editable="text"
								data-field="contributors"
								data-id={idea.id}
								data-endpoint="/api/ideas"
								data-value={idea.contributors ?? ''}
							>
								{idea.contributors || 'Unassigned.'}
							</p>
						</div>

						<div class="card-foot justify-end">
							<span class="card-date">{new Date(idea.created_at).toLocaleDateString()}</span>
						</div>
					</article>
				))
			) : (
				<p class="empty">Nothing here yet. Click "+ New item" to log your first open point.</p>
			)}
		</div>
	</section>
</Layout>

<style>
	/* Title and body share the same box treatment (padding, border, radius,
	   background) so they read as a matching pair of input fields -- only
	   typography (serif/bold title vs sans/regular body) tells them apart.
	   This is specific to this page, so the title deliberately does NOT use
	   the shared .card-title primitive. Base box styling (padding/border/
	   radius/background/cursor) lives as Tailwind utilities in markup;
	   these rules stay scoped because they interact with the .editing class
	   and [data-value] attribute state driven by Layout's inline-edit JS. */
	.pain-title {
		line-height: 1.35;
	}

	.pain-text {
		line-height: 1.6;
		white-space: pre-wrap;
	}

	.cell-input {
		font-family: inherit;
		font-size: inherit;
		line-height: inherit;
		color: inherit;
		font-weight: inherit;
	}

	.pain-text .cell-input {
		min-height: 100px;
		resize: vertical;
	}
</style>
