---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import type { Idea } from '../../lib/ideas';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as Idea[];

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="pain-points max-w-[1080px]">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Pain points.</h1>
				<p class="lede">
					Capture what's actually annoying or broken. Once one is worth solving, turn it into a business
					idea → then a project → then activities you actually work through. Click a field to write.
				</p>
			</div>
			<form method="post" action="/api/ideas/create-inline" class="new-idea-form m-0 shrink-0 w-full md:w-auto">
				<button type="submit" class="btn w-full md:w-auto justify-center">+ New pain point</button>
			</form>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="card-grid" id="notes">
			{typedIdeas.length ? (
				typedIdeas.map((idea) => (
					<article class="card" data-id={idea.id}>
						<span class="card-field-label">Idea</span>
						<div
							class="pain-title font-serif text-lg font-semibold m-0 py-[10px] px-3 border border-line rounded-[10px] bg-canvas cursor-text transition-colors duration-150"
							data-editable="text"
							data-field="title"
							data-id={idea.id}
							data-endpoint="/api/ideas"
							data-value={idea.title}
						>
							{idea.title || 'Untitled'}
						</div>

						<span class="card-field-label">Description</span>
						<p
							class="pain-text flex-1 text-[15px] m-0 py-[10px] px-3 border border-line rounded-[10px] bg-canvas cursor-text transition-colors duration-150"
							data-editable="textarea"
							data-field="body"
							data-id={idea.id}
							data-endpoint="/api/ideas"
							data-value={idea.body ?? ''}
						>
							{idea.body || 'Write something…'}
						</p>

						<div class="card-foot">
							{idea.business_idea_id ? (
								<a class="chip" href={`/business-ideas/${idea.business_idea_id}`}>→ View business idea</a>
							) : (
								<form method="post" action={`/api/ideas/${idea.id}/promote`}>
									<button type="submit" class="chip">Generate business idea →</button>
								</form>
							)}
							<form method="post" action={`/api/ideas/${idea.id}/delete`}>
								<button type="submit" class="card-delete" aria-label="Delete pain point">×</button>
							</form>
						</div>
					</article>
				))
			) : (
				<p class="empty">Nothing here yet. Click "+ New pain point" to start writing.</p>
			)}
		</div>
	</section>
</Layout>

<style>
	/* Title and body share the same box treatment (padding, border, radius,
	   background) so they read as a matching pair of input fields -- only
	   typography (serif/bold title vs sans/regular body) tells them apart.
	   This is specific to this page, so the title deliberately does NOT use
	   the shared .card-title primitive. Base box styling (padding/border/
	   radius/background/cursor) lives as Tailwind utilities in markup;
	   these rules stay scoped because they interact with the .editing class
	   and [data-value] attribute state driven by Layout's inline-edit JS. */
	.pain-title {
		line-height: 1.35;
	}

	.pain-title:hover,
	.pain-text:hover {
		border-color: var(--muted);
	}

	.pain-text {
		line-height: 1.6;
		color: var(--ink);
		white-space: pre-wrap;
	}

	.pain-text:not(.editing) {
		color: var(--muted);
	}

	.pain-title[data-value]:not([data-value=""]),
	.pain-text[data-value]:not([data-value=""]) {
		color: var(--ink);
	}

	.pain-title.editing,
	.pain-text.editing {
		border-color: var(--ink);
		background: var(--paper);
	}

	.cell-input {
		font-family: inherit;
		font-size: inherit;
		line-height: inherit;
		color: inherit;
		font-weight: inherit;
	}

	.pain-text .cell-input {
		min-height: 100px;
		resize: vertical;
	}
</style>
