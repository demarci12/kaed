---
import Layout from '../../layouts/Layout.astro';
import { requireOwner } from '../../lib/auth';
import type { Idea } from '../../lib/ideas';

const auth = await requireOwner(Astro.request, Astro.cookies);
if ('redirect' in auth) {
	return Astro.redirect(auth.redirect);
}
const { supabase } = auth;

const { data: ideas } = await supabase
	.from('ideas')
	.select('*')
	.order('created_at', { ascending: false });

const typedIdeas = (ideas ?? []) as Idea[];

// Grouped labels ("Pain · Work · Mine") kept short for the pill itself so
// the row of pills reads at a glance; grouping still shows in the dropdown.
const categoryPillLabel: Record<string, string> = {
	'work-mine': 'Work · Mine',
	'work-others': "Work · Others'",
	'life-mine': 'Life · Mine',
	'life-known': 'Life · Known',
	'life-strangers': "Life · Strangers",
	'tech-app': 'Tech · App',
	'clone-niche': 'Clone · Niche',
	'clone-geo': 'Clone · Geo',
	'clone-pricing': 'Clone · Pricing',
	'clone-usecase': 'Clone · Use case',
	'clone-oss': 'Clone · OSS',
};

const categoryOptions = [
	':Pick category',
	...Object.entries(categoryPillLabel).map(([value, label]) => `${value}:${label}`),
].join(',');

const error = Astro.url.searchParams.get('error');
---

<Layout user={auth.user}>
	<section class="pain-points">
		<div class="page-head">
			<div>
				<p class="eyebrow">Personal</p>
				<h1>Pain points.</h1>
				<p class="lede">
					Capture what's actually annoying or broken. Once one is worth solving, turn it into a business
					idea → then a project → then activities you actually work through. Click a field to write.
				</p>
			</div>
			<form method="post" action="/api/ideas/create-inline" class="new-idea-form">
				<button type="submit" class="btn">+ New pain point</button>
			</form>
		</div>

		{error && <p class="form-error">{error}</p>}

		<div class="card-grid" id="notes">
			{typedIdeas.length ? (
				typedIdeas.map((idea) => (
					<article class="card" data-id={idea.id}>
						<div
							class="pain-title"
							data-editable="text"
							data-field="title"
							data-id={idea.id}
							data-endpoint="/api/ideas"
							data-value={idea.title}
						>
							{idea.title || 'Untitled'}
						</div>

						<div
							class="pain-category"
							data-editable="select"
							data-field="category"
							data-id={idea.id}
							data-endpoint="/api/ideas"
							data-value={idea.category ?? ''}
							data-options={categoryOptions}
						>
							{idea.category ? (
								<span class={`pill pill-${idea.category}`}>{categoryPillLabel[idea.category]}</span>
							) : (
								<span class="pill pill-empty">Pick category</span>
							)}
						</div>

						<p
							class="pain-text"
							data-editable="textarea"
							data-field="body"
							data-id={idea.id}
							data-endpoint="/api/ideas"
							data-value={idea.body ?? ''}
						>
							{idea.body || 'Write something…'}
						</p>

						<div class="card-foot">
							{idea.business_idea_id ? (
								<a class="chip" href={`/business-ideas/${idea.business_idea_id}`}>→ View business idea</a>
							) : (
								<form method="post" action={`/api/ideas/${idea.id}/promote`}>
									<button type="submit" class="chip">Generate business idea →</button>
								</form>
							)}
							<form method="post" action={`/api/ideas/${idea.id}/delete`}>
								<button type="submit" class="card-delete" aria-label="Delete pain point">×</button>
							</form>
						</div>
					</article>
				))
			) : (
				<p class="empty">Nothing here yet. Click "+ New pain point" to start writing.</p>
			)}
		</div>
	</section>
</Layout>

<style>
	.pain-points {
		max-width: 1080px;
	}

	.new-idea-form {
		margin: 0;
		flex-shrink: 0;
	}

	/* Title and body share the same box treatment (padding, border, radius,
	   background) so they read as a matching pair of input fields -- only
	   typography (serif/bold title vs sans/regular body) tells them apart.
	   This is specific to this page, so the title deliberately does NOT use
	   the shared .card-title primitive. */
	.pain-title,
	.pain-text {
		margin: 0;
		padding: 10px 12px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--canvas);
		cursor: text;
		transition: border-color 0.15s ease;
	}

	.pain-title:hover,
	.pain-text:hover {
		border-color: var(--muted);
	}

	.pain-title {
		font-family: var(--serif);
		font-size: 18px;
		font-weight: 600;
		line-height: 1.35;
	}

	.pain-text {
		flex: 1;
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink);
		white-space: pre-wrap;
	}

	.pain-text:not(.editing) {
		color: var(--muted);
	}

	.pain-title[data-value]:not([data-value=""]),
	.pain-text[data-value]:not([data-value=""]) {
		color: var(--ink);
	}

	.pain-title.editing,
	.pain-text.editing {
		border-color: var(--ink);
		background: var(--paper);
	}

	.pain-category {
		display: inline-block;
		align-self: flex-start;
		cursor: pointer;
	}

	.pain-category select.cell-input {
		font-size: 14px;
		padding: 4px 6px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--paper);
	}

	.cell-input {
		font-family: inherit;
		font-size: inherit;
		line-height: inherit;
		color: inherit;
		font-weight: inherit;
	}

	.pain-text .cell-input {
		min-height: 100px;
		resize: vertical;
	}

	@media (max-width: 720px) {
		.new-idea-form,
		.page-head .btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>
