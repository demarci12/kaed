# Client-exposed (must carry the NEXT_PUBLIC_ prefix -- Next only ships vars
# with that exact prefix to the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
MCP_AUTH_TOKEN=
CMC_API_KEY=
ANTHROPIC_API_KEY=

# Enable Banking (server-only). Private key = PEM, base64-encoded on one line.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=

# Jira (server-only), for the Work page: read a ticket's title and description,
# write worklogs, comments and status changes. Cloud: email + API token.
# Company-hosted (Data Center): a personal access token instead. Vercel must be
# able to reach the URL, so a Jira that only opens on the company network won't work.
JIRA_BASE_URL=…
JIRA_EMAIL=…
JIRA_API_TOKEN=…
JIRA_PAT=…
